[binaries]
c = 'x86_64-w64-mingw32-gcc'
cpp = 'x86_64-w64-mingw32-g++'
ar = 'x86_64-w64-mingw32-gcc-ar'
ranlib = 'x86_64-w64-mingw32-gcc-ranlib'
nm = 'x86_64-w64-mingw32-gcc-nm'
strip = 'x86_64-w64-mingw32-strip'
windres = 'x86_64-w64-mingw32-windres'
dlltool = 'x86_64-w64-mingw32-dlltool'
nasm = 'nasm'
# disable wine
exe_wrapper = ['wine']

[properties]
pkg_config_static = false
needs_exe_wrapper = true
sys_root = '/'
pkg_config_libdir = '/opt/ffbuild/lib/pkgconfig:/opt/ffbuild/share/pkgconfig:/opt/ffbuild/lib64/pkgconfig'

[built-in options]
c_args = ['-I/opt/ffbuild/include']
cpp_args = ['-I/opt/ffbuild/include']
c_link_args = ['-L/opt/ffbuild/lib']
cpp_link_args = ['-L/opt/ffbuild/lib']

default_library = 'shared'

[host_machine]
system = 'windows'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
