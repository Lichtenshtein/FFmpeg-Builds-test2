+           ctx->phase_end < mb_h) {
+      WebPMonitorWait(ctx->monitor);  // wait for the next phase
+    }
+    if (!ctx->abort && ctx->next_row < ctx->phase_end) {
+      y = ctx->next_row++;
+    }
+    WebPMonitorUnlock(ctx->monitor);
+    if (y < 0) break;  // aborted or no more rows
+    if (!WavefrontProcessRow(w, it, y)) break;
+  }
