       const int r = best_uv[i + 0 * uv_w];
@@ -281,28 +355,62 @@ static int ConvertWRGBToYUV(const fixed_y_t* best_y, const fixed_t* best_uv,
       const int b = best_uv[i + 2 * uv_w];
