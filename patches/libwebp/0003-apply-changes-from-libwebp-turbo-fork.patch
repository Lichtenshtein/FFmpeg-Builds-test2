+static int RGBToGray_C(int64_t r, int64_t g, int64_t b) {
+  const int64_t luma = 13933 * r + 46871 * g + 4732 * b + kSharpYuvYuvHalf;
+  return (int)(luma >> SHARPYUV_YUV_FIX);
