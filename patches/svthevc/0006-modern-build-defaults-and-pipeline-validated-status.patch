diff --git a/CMakeLists.txt b/CMakeLists.txt
index 36ccb2247..9bd3d148a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -29,11 +29,33 @@ endif()
 include(GNUInstallDirs)
 include(CheckCCompilerFlag)
 
-# Refactor scaffold options (default OFF to preserve existing behavior)
-option(SVT_ENABLE_LTO "Enable interprocedural optimization (LTO/IPO) when supported." OFF)
+# Performance-oriented defaults for modern local builds.
+set(_svt_lto_default ON)
+if(MSVC)
+    set(_svt_lto_default OFF)
+endif()
+
+set(_svt_native_default ON)
+if(MSVC)
+    set(_svt_native_default OFF)
+endif()
+
+if(DEFINED NATIVE)
+    message(WARNING "NATIVE is deprecated. Use SVT_ENABLE_NATIVE instead.")
+    set(_svt_native_default ${NATIVE})
+    unset(NATIVE CACHE)
+endif()
+
+set(_svt_rpath_default OFF)
+if(UNIX)
+    set(_svt_rpath_default ON)
+endif()
+
+option(SVT_ENABLE_LTO "Enable interprocedural optimization (LTO/IPO) when supported." ${_svt_lto_default})
 option(SVT_ENABLE_FULL_STATIC "Build fully static executables where supported." OFF)
-option(SVT_ENABLE_PORTABLE_RPATH "Use portable build RPATH suitable for side-by-side binaries." OFF)
-option(SVT_ENABLE_INSTALL_RPATH "Set install RPATH to locate libraries under the install prefix." OFF)
+option(SVT_ENABLE_PORTABLE_RPATH "Use portable build RPATH suitable for side-by-side binaries." ${_svt_rpath_default})
+option(SVT_ENABLE_INSTALL_RPATH "Set install RPATH to locate libraries under the install prefix." ${_svt_rpath_default})
+option(SVT_ENABLE_NATIVE "Build for native performance (march=native)." ${_svt_native_default})
 
 message(STATUS "CMAKE_BUILD_TYPE = ${CMAKE_BUILD_TYPE}")
 message(STATUS "CMAKE_C_COMPILER = ${CMAKE_C_COMPILER}")
@@ -56,6 +78,7 @@ message(STATUS "SVT_ENABLE_LTO = ${SVT_ENABLE_LTO}")
 message(STATUS "SVT_ENABLE_FULL_STATIC = ${SVT_ENABLE_FULL_STATIC}")
 message(STATUS "SVT_ENABLE_PORTABLE_RPATH = ${SVT_ENABLE_PORTABLE_RPATH}")
 message(STATUS "SVT_ENABLE_INSTALL_RPATH = ${SVT_ENABLE_INSTALL_RPATH}")
+message(STATUS "SVT_ENABLE_NATIVE = ${SVT_ENABLE_NATIVE}")
 
 set(SVT_HEVC_VERSION_MAJOR           "1")
 set(SVT_HEVC_VERSION_MINOR           "5")
@@ -126,13 +149,21 @@ if(SVT_ENABLE_FULL_STATIC)
     endif()
 endif()
 
-if(UNIX AND NOT APPLE)
+if(UNIX)
     if(SVT_ENABLE_PORTABLE_RPATH)
         set(CMAKE_BUILD_RPATH_USE_ORIGIN ON)
-        set(CMAKE_BUILD_RPATH "\$ORIGIN")
+        if(APPLE)
+            set(CMAKE_BUILD_RPATH "@loader_path")
+        else()
+            set(CMAKE_BUILD_RPATH "\$ORIGIN")
+        endif()
     endif()
     if(SVT_ENABLE_INSTALL_RPATH)
-        set(CMAKE_INSTALL_RPATH "\$ORIGIN/../${CMAKE_INSTALL_LIBDIR}")
+        if(APPLE)
+            set(CMAKE_INSTALL_RPATH "@loader_path/../${CMAKE_INSTALL_LIBDIR}")
+        else()
+            set(CMAKE_INSTALL_RPATH "\$ORIGIN/../${CMAKE_INSTALL_LIBDIR}")
+        endif()
         set(CMAKE_INSTALL_RPATH_USE_LINK_PATH TRUE)
     endif()
 endif()
@@ -149,7 +180,6 @@ set(flags_to_test
 if(MSVC)
     list(APPEND flags_to_test /MP)
 else()
-    option(NATIVE "Build for native performance (march=native)")
     list(INSERT flags_to_test 0 -Wall)
     #for Mingw64 support, see https://gcc.gnu.org/bugzilla/show_bug.cgi?id=65782
     if(MINGW)
@@ -157,12 +187,11 @@ else()
     else()
         list(APPEND flags_to_test -fstack-protector-strong)
     endif()
-    if(NATIVE)
+    if(SVT_ENABLE_NATIVE)
         list(APPEND flags_to_test -march=native)
     endif()
 endif()
 set(release_flags_to_test
-    -O2
     -O3)
 set(debug_flags_to_test
     -O0)
diff --git a/README.md b/README.md
index 926af0332..c2d98e837 100644
--- a/README.md
+++ b/README.md
@@ -29,6 +29,18 @@ More details about the encoder usage can be found under:
 - [refactor-status-tracker](Docs/refactor/status.md)
 - [platform-sync-runbook](Docs/refactor/platform_sync_runbook.md)
 
+## Fork Release Status (March 2026)
+
+This fork includes practical build and runtime updates for integration into custom pipelines:
+
+- Modernized CMake configuration defaults for local performance-focused builds.
+- Native CPU optimization path enabled via `-march=native` (non-MSVC) with explicit toggle support.
+- LTO/IPO support enabled by default when the toolchain supports it.
+- Portable runtime library search paths enabled for UNIX platforms (`$ORIGIN` on Linux, `@loader_path` on macOS).
+- CMake cleanup in codec-related directories by replacing global directory directives with target-scoped includes.
+
+Practical smoke validation was completed using real video input through `ffmpeg | SvtHevcEncApp` pipelines (FHD and 4K), with successful encoder completion.
+
 ## System Requirements
 
 ### Operating System
