From cfa196df72626dd02055fce83c6e8064f43f6abc Mon Sep 17 00:00:00 2001
From: wang-bin <wbsecg1@gmail.com>
Date: Fri, 5 Jun 2020 14:05:42 +0800
Subject: [PATCH 16/35] nvenc: check runtime 9.1 function ptrs before use

---
 libavcodec/nvenc.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/libavcodec/nvenc.c b/libavcodec/nvenc.c
index 858c79250a..f1645ba83e 100644
--- a/libavcodec/nvenc.c
+++ b/libavcodec/nvenc.c
@@ -188,7 +188,7 @@ static int nvenc_print_error(AVCodecContext *avctx, NVENCSTATUS err,
     const char *details = "(no details)";
     int ret = nvenc_map_error(err, &desc);
 
-    if (p_nvenc && ctx->nvencoder)
+    if (p_nvenc && ctx->nvencoder && p_nvenc->nvEncGetLastErrorString)
         details = p_nvenc->nvEncGetLastErrorString(ctx->nvencoder);
 
     av_log(avctx, AV_LOG_ERROR, "%s: %s (%d): %s\n", error_string, desc, err, details);
@@ -1985,7 +1985,7 @@ static av_cold int nvenc_setup_encoder(AVCodecContext *avctx)
         return nvenc_print_error(avctx, nv_status, "InitializeEncoder failed");
     }
 
-    if (ctx->cu_context) {
+    if (ctx->cu_context && p_nvenc->nvEncSetIOCudaStreams) {
         nv_status = p_nvenc->nvEncSetIOCudaStreams(ctx->nvencoder, &ctx->cu_stream, &ctx->cu_stream);
         if (nv_status != NV_ENC_SUCCESS) {
             nvenc_pop_context(avctx);
--
