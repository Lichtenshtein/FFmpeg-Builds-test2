-        constraints->valid_sw_formats[i] = supported_formats[i];
-    constraints->valid_sw_formats[FF_ARRAY_ELEMS(supported_formats)] = AV_PIX_FMT_NONE;
+    for (i = 0; i < FF_ARRAY_ELEMS(supported_formats); i++) {
