+    if (ctx->format == AV_PIX_FMT_CUARRAY) {
+        AVCUDAArrayFrameDescriptor *desc = (AVCUDAArrayFrameDescriptor*)data;
+        CHECK_CU(cu->cuArrayDestroy(desc->array));
