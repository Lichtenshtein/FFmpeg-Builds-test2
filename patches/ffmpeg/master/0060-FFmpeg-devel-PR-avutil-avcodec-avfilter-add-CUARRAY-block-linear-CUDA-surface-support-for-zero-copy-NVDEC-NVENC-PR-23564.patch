-        return res;
+    if (ctx->format == AV_PIX_FMT_CUARRAY) {
+        AVCUDAArrayFrameDescriptor *desc = (AVCUDAArrayFrameDescriptor*)frame->buf[0]->data;
+        if (!desc) {
+            frame->format = ctx->format;
+            frame->width  = ctx->width;
+            frame->height = ctx->height;
