+            desc->index = priv->cuarray_num_surfaces_used++;
+            desc->array = priv->p.cuarray_surfaces[desc->index];
+        } else {
+            err = CHECK_CU(cu->cuArray3DCreate(&desc->array, &priv->p.cuarray_desc));
+            if (err < 0) {
+                av_free(desc);
