diff --git a/doc/decoders.texi b/doc/decoders.texi
index c8177c1..93d2dbb 100644
--- a/doc/decoders.texi
+++ b/doc/decoders.texi
@@ -83,6 +83,17 @@ this option.
 
 @end table
 
+@section hvqm2
+
+Hudson HVQM2 (Hybrid Vector Quantization) video decoder, for the @code{.hvqm}
+container used on the Nintendo 64. It decodes the codec's key, predict and hold
+frames.
+
+The decoder outputs @code{rgba}: the codec's final stage is a YUV-to-RGBA
+conversion, so RGBA is its native output (this is why @command{ffprobe} reports
+@code{pix_fmt=rgba}). Insert a format/scale filter to obtain any other pixel
+format.
+
 @section rawvideo
 
 Raw video decoder.
