+ */
+
+/**
+ * @file
+ * Hudson HVQM2 (N64-era "Hybrid Vector Quantization") video encoder.
+ *
+ * Every frame is an intra keyframe. Each 4x4 block is coded as one of:
+ *   - basis number 0  -> DC only; the decoder bilinearly interpolates the block
+ *                        from its DC mean and its neighbours' (WeightImBlock).
+ *   - basis number N   -> flat DC plus N "AOT" (Adaptive Orthogonal Transform)
+ *                        basis vectors selected by greedy matching pursuit from a
+ *                        self-derived nest (a window of this frame's luma DC image).
+ *
+ * The bitstream mirrors the reference decoder (src/reference/hvqm2/hvqm2.c) exactly:
+ * decBlockCPU's AOT reconstruction is inverted bit-for-bit so the chosen basis
+ * vectors decode to the intended pixels. See docs/research/hvqm2-encoder-spec.md
+ * and the Phase-A handoff for the derivation.
+ *
+ * Fixed profile (must match libavformat/hvqmenc.c):
+ *   y_shiftnum = 8 (landscape nest 70x38), video_quantize_shift = 0,
+ *   pix_fmt yuv420p (4:1:1) / yuv422p (4:2:2).
+ *
+ * Inter (P/H) frames and motion are a later stage; here every frame is a keyframe.
+ */
+
+#include <limits.h>
+#include <string.h>
+#ifdef HVQM2_DUMP_RECON
+#include <stdio.h>
+#include <stdlib.h>
+#endif
+
+#include "libavutil/avassert.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "avcodec.h"
+#include "codec_internal.h"
+#include "encode.h"
+#include "internal.h"
+#include "put_bits.h"
+
+/* video_quantize_shift == 0: DC symbol i maps to value (int8_t)i; bounds -128/+127. */
+#define HVQM2_DC_MIN (-128)
+#define HVQM2_DC_MAX ( 127)
+
+/* Landscape nest (y_shiftnum == 8): width 70, height 38 (HVQM2_NESTSIZE_L/S). */
+#define HVQM2_NEST_W 70
+#define HVQM2_NEST_H 38
+
+/* Per-block AOT basis cap. Basis 8 means "raw block" in the format; we stay <= 6 so
+ * luma byte and chroma nibble both fit and we never emit a raw block. */
+#define HVQM2_MAXB 6
+
+/* The reference decoder reads each record into a fixed buffer and rejects any record
+ * body larger than this (HVQM_DATASIZE_MAX). Every record we emit must fit. */
+#define HVQM2_DATASIZE_MAX 30000
+
+/* Nest sampling grid: nest_pos_x in 0..63 (6 bits), nest_pos_y in 0..31 (5 bits),
+ * x_stride/y_stride in {1,2}. A 4x4 patch at stride 2 reads pos+6, within 70x38. */
+#define HVQM2_ATOM_PX 64
+#define HVQM2_ATOM_PY 32
+#define HVQM2_NATOMS  (HVQM2_ATOM_PX * HVQM2_ATOM_PY * 4)
+
+/* A macroblock whose best motion-compensated luma SAD (over 64 px) still exceeds this is
+ * "poorly predicted" -- ~4/px residual. Fixed (not tied to sad_thresh/-quality) so the
+ * scene cut point doesn't move with quality. Calibrated so that at the default scene=80
+ * (key when >80% of MBs are bad) the cut placement matches Hudson's hvqm2enc -a 80 on
+ * corona to ~0.83 recall / 0.97 precision against its 41 scene-cut frames. */
+#define HVQM2_SCENE_MB_SAD 256
+
+/* HOLD threshold: a non-key frame whose whole-frame zero-motion luma mean-abs-diff from the
+ * previous reconstructed frame is <= this (per pixel, x256 fixed-point) is emitted as a HOLD
+ * record (empty body -> decoder repeats the previous frame). Strict, since HOLD cannot do
+ * motion; calibrated to Hudson's 26 H frames on corona. */
+#define HVQM2_HOLD_MAD_Q8 384      /* 384/256 = 1.5 mean abs diff per luma pixel */
+
+typedef struct HVQM2EncContext {
+    const AVClass *class;
+    int quality;                /* matching-pursuit threshold Z (higher -> fewer bases) */
+
+    int lum_hblocks, lum_vblocks, lum_total;
+    int col_hblocks, col_vblocks, col_total;
+    int mcu411;                 /* 1 = 4:1:1 (yuv420p), 0 = 4:2:2 (yuv422p) */
+    int aot;                    /* 1 if the frame is large enough for a valid nest */
+
+    uint8_t *dc[3];             /* per-block DC means (row-major per plane) */
+
+    /* nest + precomputed AOT atoms (rebuilt per frame) */
+    uint8_t  *nest;             /* HVQM2_NEST_W * HVQM2_NEST_H */
+    int16_t  *atom_tmp;         /* [HVQM2_NATOMS][16] de-meaned 4x4 nest patch */
+    int      *atom_norm2;       /* [HVQM2_NATOMS] sum of squares of atom_tmp */
+    float    *atom_inv;         /* [HVQM2_NATOMS] 1/norm2 (selection metric; 0 if flat) */
+    int      *atom_div;         /* [HVQM2_NATOMS] divT[max] = 4096/max, 0 if flat */
+    uint8_t  *atom_px, *atom_py, *atom_xs, *atom_ys;
+
+    /* per-block AOT results (raster order per plane) */
+    uint8_t  *bn[3];            /* basis number per block */
+    uint16_t *fixw[3];          /* [block*MAXB + k] packed fixvl word */
+    uint8_t  *scl[3];           /* [block*MAXB + k] scale symbol index */
+
+    /* symbol scratch for stream assembly */
+    int      *dcd[3];           /* DC deltas in IpicDcvDec traversal order */
+    uint8_t  *dcsym[3], *dcrun[3];
+    uint8_t  *bnval[2], *bnrun[2];
+    uint8_t  *oscl[3];          /* scale symbols in decode (consumption) order */
+    uint16_t *ofix[3];          /* fixvl words in consumption order */
+
+    uint8_t *pktbuf;            /* assembled record body */
+    int pktbuf_size;
+
+    /* ---- inter (P) frame state (Phase B) ---- */
+    int width, height;
+    int gop_size;              /* keyframe interval (Hudson -k, via avctx->gop_size/-g) */
+    int me_range;              /* motion search range in px (Hudson -r) */
+    int scene;                 /* scene-change key sensitivity, Hudson -a (0..100) */
+    int sad_thresh;            /* 8x8 SAD at/below which a MB is coded INTER */
+    int frame_index;           /* frames seen so far */
+    int have_prev;             /* a reconstructed reference frame is available */
+    int mb_w, mb_h, nmb;       /* 8x8 macroblock grid */
+    int pf_nbad;               /* P-frame ME result: #MBs poorly motion-compensated */
+    uint8_t  *mvsym;           /* movevector DPCM delta symbols (decode order) */
+    uint8_t  *mbbits;          /* scratch for the raw macroblock type-bit stream */
+
+    /* ---- closed-loop reconstruction (Phase B2b) ----
+     * The encoder reconstructs every frame bit-identically to the oracle decoder so
+     * motion estimation references exactly what the decoder will hold (kills drift).
+     * Reference is RGBA (the decoder copies RGBA on INTER); a parallel luma plane is
+     * captured for the luma-SAD motion search. Both are double-buffered. */
+    int       buf_cur;         /* index of the frame being reconstructed; prev = ^1 */
+    uint32_t *ref_rgba[2];     /* reconstructed RGBA framebuffers (== decoder output) */
+    uint8_t  *ref_y[2];        /* reconstructed luma planes (== decoder displayed luma) */
+    const uint8_t *me_ref;     /* luma ref the current ME reads (ref_y of prev frame) */
+    uint8_t  *rbn[3];          /* reconstruction basis per block (0x80 inter, capped) */
+    uint8_t  *rdc[3];          /* reconstruction DC image per block (P-frames) */
+    int       divT[0x200];     /* 4096/i table for AOT scale (matches decoder divT) */
+
+    /* ---- AOT in P-frames (Phase B3) ---- */
+    uint8_t  *mb_mode;         /* per-MB coding mode: PF_INTER / PF_INTRA_DC / PF_INTRA_FULL */
+    uint8_t  *pf_bnl;          /* scratch: MB-interleaved luma basisnum sequence */
+    uint8_t  *pf_bnc;          /* scratch: MB-interleaved packed-chroma basisnum sequence */
+} HVQM2EncContext;
+
+/* ============================ Huffman ================================= */
+
+typedef struct HuffNode {
+    uint64_t freq;
+    int sym;                    /* >=0 for a leaf, -1 for an internal node */
+    int left, right;
+} HuffNode;
+
+/* Build a Huffman tree from freq[256]; fill code/len and the node pool.
+ * Returns the root node index (-1 if no symbols are used). */
+static int hvqm2_build_huff(const uint64_t freq[256], HuffNode nodes[512],
+                            uint32_t code[256], uint8_t len[256])
+{
+    int heap[256], hn = 0, nn = 0;
+
+    memset(code, 0, 256 * sizeof(*code));
+    memset(len,  0, 256 * sizeof(*len));
+
+    for (int i = 0; i < 256; i++) {
+        if (freq[i]) {
+            nodes[nn].freq = freq[i];
+            nodes[nn].sym  = i;
+            nodes[nn].left = nodes[nn].right = -1;
+            heap[hn++] = nn++;
+        }
+    }
+    if (hn == 0)
+        return -1;
+
+    while (hn > 1) {
+        int a = 0, b, ia, ib;
+        for (int i = 1; i < hn; i++)
+            if (nodes[heap[i]].freq < nodes[heap[a]].freq)
+                a = i;
+        ia = heap[a]; heap[a] = heap[--hn];
+        b = 0;
+        for (int i = 1; i < hn; i++)
+            if (nodes[heap[i]].freq < nodes[heap[b]].freq)
+                b = i;
+        ib = heap[b]; heap[b] = heap[--hn];
+
+        nodes[nn].freq  = nodes[ia].freq + nodes[ib].freq;
+        nodes[nn].sym   = -1;
+        nodes[nn].left  = ia;
+        nodes[nn].right = ib;
+        heap[hn++] = nn++;
+    }
+    return heap[0];
+}
+
+static void hvqm2_assign_codes(const HuffNode *nodes, int idx, uint64_t cur,
+                               int depth, uint32_t code[256], uint8_t len[256])
+{
+    if (nodes[idx].sym >= 0) {
+        /* Dimensions are capped at 640x480, so symbol counts are bounded and the
+         * optimal Huffman depth stays well under put_bits()'s 31-bit limit. */
+        av_assert0(depth <= 31);
+        code[nodes[idx].sym] = cur;
+        len [nodes[idx].sym] = depth;     /* single-symbol tree -> depth 0, no bits */
+        return;
+    }
+    hvqm2_assign_codes(nodes, nodes[idx].left,  cur << 1,       depth + 1, code, len);
+    hvqm2_assign_codes(nodes, nodes[idx].right, (cur << 1) | 1, depth + 1, code, len);
+}
+
+static void hvqm2_serialize_tree(PutBitContext *pb, const HuffNode *nodes, int idx)
+{
+    if (nodes[idx].sym >= 0) {            /* leaf: 0 then 8-bit symbol */
+        put_bits(pb, 1, 0);
+        put_bits(pb, 8, nodes[idx].sym);
+        return;
+    }
+    put_bits(pb, 1, 1);                   /* internal: 1 then 0-side, then 1-side */
+    hvqm2_serialize_tree(pb, nodes, nodes[idx].left);
+    hvqm2_serialize_tree(pb, nodes, nodes[idx].right);
+}
+
+/* A built Huffman codebook plus its node pool, so streams can share one tree. */
+typedef struct HVQM2Huff {
+    HuffNode nodes[512];
+    uint32_t code[256];
+    uint8_t  len[256];
+    int      root;              /* <0 -> no symbols */
+} HVQM2Huff;
+
+static void hvqm2_huff_init(HVQM2Huff *h, const uint64_t freq[256])
+{
+    h->root = hvqm2_build_huff(freq, h->nodes, h->code, h->len);
+    if (h->root >= 0)
+        hvqm2_assign_codes(h->nodes, h->root, 0, 0, h->code, h->len);
+}
+
+/* ===================== stream framing =====================
+ * Each stream is [u32 BE size][payload padded to a multiple of 4]. size == 0 is a
+ * NULL/empty stream the decoder never reads from. */
+
+/* Entropy stream: optional serialized tree (when with_tree), then code bits. */
+static int hvqm2_put_estream(uint8_t *buf, int pos, int cap, const HVQM2Huff *h,
+                             int with_tree, const uint8_t *sym, int nsym)
+{
+    PutBitContext pb;
+    int nbytes;
+
+    init_put_bits(&pb, buf + pos + 4, cap - pos - 4);
+    if (with_tree && h->root >= 0)
+        hvqm2_serialize_tree(&pb, h->nodes, h->root);
+    for (int i = 0; i < nsym; i++)
+        if (h->len[sym[i]])
+            put_bits(&pb, h->len[sym[i]], h->code[sym[i]]);
+    flush_put_bits(&pb);
+
+    nbytes = put_bytes_output(&pb);
+    while (nbytes & 3)
+        buf[pos + 4 + nbytes++] = 0;
+    av_assert0(pos + 4 + nbytes <= cap);
+    AV_WB32(buf + pos, nbytes);
+    return pos + 4 + nbytes;
+}
+
+/* Raw stream of big-endian 16-bit words (fixvl). */
+static int hvqm2_put_words(uint8_t *buf, int pos, int cap,
+                           const uint16_t *words, int n)
+{
+    int nbytes = 2 * n;
+    av_assert0(pos + 4 + ((nbytes + 3) & ~3) <= cap);
+    for (int i = 0; i < n; i++)
+        AV_WB16(buf + pos + 4 + 2 * i, words[i]);
+    while (nbytes & 3)
+        buf[pos + 4 + nbytes++] = 0;
+    AV_WB32(buf + pos, nbytes);
+    return pos + 4 + nbytes;
+}
+
+/* =========================== DC ============================ */
+
+static void hvqm2_compute_dc(HVQM2EncContext *s, const AVFrame *f)
+{
+    for (int by = 0; by < s->lum_vblocks; by++)
+        for (int bx = 0; bx < s->lum_hblocks; bx++) {
+            const uint8_t *p = f->data[0] + (by * 4) * f->linesize[0] + bx * 4;
+            int sum = 0;
+            for (int dy = 0; dy < 4; dy++, p += f->linesize[0])
+                for (int dx = 0; dx < 4; dx++)
+                    sum += p[dx];
+            s->dc[0][by * s->lum_hblocks + bx] = (sum + 8) >> 4;
+        }
+
+    for (int pl = 1; pl <= 2; pl++)
+        for (int by = 0; by < s->col_vblocks; by++)
+            for (int bx = 0; bx < s->col_hblocks; bx++) {
+                const uint8_t *p = f->data[pl] + (by * 4) * f->linesize[pl] + bx * 4;
+                int sum = 0;
+                for (int dy = 0; dy < 4; dy++, p += f->linesize[pl])
+                    for (int dx = 0; dx < 4; dx++)
+                        sum += p[dx];
+                s->dc[pl][by * s->col_hblocks + bx] = (sum + 8) >> 4;
+            }
+}
+
+static inline int hvqm2_mean(int a, int b) { return (a + b) / 2; }   /* truncate, matches decoder */
+
+/* Fill per-plane DC delta arrays in IpicDcvDec traversal order. Deltas are taken
+ * mod 256 into [-128,127]; the decoder accumulates u8 so the reconstruction wraps
+ * identically. dcd[0] has lum_total entries, dcd[1]/dcd[2] col_total each. */
+static void hvqm2_dc_deltas(HVQM2EncContext *s)
+{
+    const uint8_t *dcY = s->dc[0], *dcU = s->dc[1], *dcV = s->dc[2];
+    int *oY = s->dcd[0], *oU = s->dcd[1], *oV = s->dcd[2];
+    int Yw = 0, yp = 0, Uw = 0, up = 0, Vw = 0, vp = 0;
+    int kY = 0, kU = 0, kV = 0;
+    int dY = 0, dU = 0, dV = 0;
+    const int ch = s->col_hblocks, cv = s->col_vblocks;
+
+#define DELTA(P) do { int t = dc##P[P##w]; int b = (t - d##P) & 0xff; \
+                      o##P[k##P++] = (b >= 128 ? b - 256 : b); \
+                      d##P = t; P##w++; } while (0)
+
+    for (int h = 0; h < ch; h++) {            /* row 0: pure left prediction */
+        DELTA(Y); DELTA(Y); DELTA(U); DELTA(V);
+    }
+    dY = dcY[yp++]; dU = dcU[up++]; dV = dcV[vp++];
+    if (s->mcu411) {                          /* 4:1:1 second luma sub-row */
+        for (int h = 0; h < ch; h++) {
+            DELTA(Y); dY = hvqm2_mean(dY, dcY[yp++]);
+            DELTA(Y); dY = hvqm2_mean(dY, dcY[yp++]);
+        }
+    }
+    for (int v = 0; v < cv - 1; v++) {
+        dY = dcY[yp - 1]; dU = dcU[up - 1]; dV = dcV[vp - 1];
+        for (int h = 0; h < ch; h++) {
+            DELTA(Y); dY = hvqm2_mean(dY, dcY[yp++]);
+            DELTA(Y); dY = hvqm2_mean(dY, dcY[yp++]);
+            DELTA(U); dU = hvqm2_mean(dU, dcU[up++]);
+            DELTA(V); dV = hvqm2_mean(dV, dcV[vp++]);
+        }
+        dY = dcY[yp - 1];
+        if (s->mcu411) {
+            for (int h = 0; h < ch; h++) {
+                DELTA(Y); dY = hvqm2_mean(dY, dcY[yp++]);
+                DELTA(Y); dY = hvqm2_mean(dY, dcY[yp++]);
+            }
+        }
+    }
+#undef DELTA
+}
+
+/* Append the dcval symbol(s) for a non-zero delta D (in [-128,127]). freq may be NULL
+ * when the caller recomputes frequencies later (the P-frame cap loop). */
+static inline void hvqm2_emit_dc_value(uint8_t *sym, int *n, uint64_t freq[256], int D)
+{
+    int i = D & 0xFF;
+    sym[(*n)++] = i;
+    if (freq) freq[i]++;
+    if (D == HVQM2_DC_MIN || D == HVQM2_DC_MAX) {  /* boundary -> escape, add interior 0 */
+        sym[(*n)++] = 0;
+        if (freq) freq[0]++;
+    }
+}
+
+/* Run-length encode one plane's DC delta sequence (decodeDC + dcrun semantics):
+ * a zero delta emits dcval symbol 0 then a dcrun run R (the next R deltas are 0). */
+static void hvqm2_rle_dc(const int *d, int n, uint8_t *dcsym, int *ndc,
+                         uint8_t *run, int *nrun, uint64_t dcfreq[256],
+                         uint64_t runfreq[256])
+{
+    int i = 0;
+    while (i < n) {
+        if (d[i] == 0) {
+            int R = 0;
+            dcsym[(*ndc)++] = 0; dcfreq[0]++;
+            while (R < 255 && i + 1 + R < n && d[i + 1 + R] == 0)
+                R++;
+            run[(*nrun)++] = R; runfreq[R]++;
+            i += 1 + R;
+        } else {
+            hvqm2_emit_dc_value(dcsym, ndc, dcfreq, d[i]);
+            i++;
+        }
+    }
+}
+
+/* Run-length encode a basis-number value sequence (Ipic_BasisNumDec semantics):
+ * a zero value emits value symbol 0 then a run R (the next R values are 0). */
+static void hvqm2_rle_bn(const uint8_t *v, int n, uint8_t *val, int *nv,
+                         uint8_t *run, int *nrun, uint64_t valfreq[256],
+                         uint64_t runfreq[256])
+{
+    int i = 0;
+    while (i < n) {
+        val[(*nv)++] = v[i]; valfreq[v[i]]++;
+        if (v[i] == 0) {
+            int R = 0;
+            while (R < 255 && i + 1 + R < n && v[i + 1 + R] == 0)
+                R++;
+            run[(*nrun)++] = R; runfreq[R]++;
+            i += 1 + R;
+        } else {
+            i++;
+        }
+    }
+}
+
+/* =========================== nest + AOT atoms ============================ */
+
+/* Build the nest as a direct 70x38 window of the luma DC image at (0,0).
+ * Only called when lum_hblocks >= 70 && lum_vblocks >= 38, where MakeNest reduces
+ * to this copy (no mirror/empty padding, so the decoder's small-frame bug can't
+ * trigger). nest_start is therefore fixed at (0,0). */
+static void hvqm2_build_nest(HVQM2EncContext *s)
+{
+    for (int y = 0; y < HVQM2_NEST_H; y++)
+        memcpy(s->nest + y * HVQM2_NEST_W,
+               s->dc[0] + y * s->lum_hblocks, HVQM2_NEST_W);
+}
+
+/* Precompute every candidate AOT atom: de-mean a strided 4x4 nest patch exactly as
+ * decBlockCPU does, and cache its de-meaned values, sum-of-squares and divT[max]. */
+static void hvqm2_build_atoms(HVQM2EncContext *s)
+{
+    int a = 0;
+    for (int py = 0; py < HVQM2_ATOM_PY; py++)
+        for (int px = 0; px < HVQM2_ATOM_PX; px++)
+            for (int ys = 1; ys <= 2; ys++)
+                for (int xs = 1; xs <= 2; xs++, a++) {
+                    const uint8_t *nest = s->nest + py * HVQM2_NEST_W + px;
+                    int16_t *tmp = s->atom_tmp + a * 16;
+                    int sum = 0, mean, max = 0, norm2 = 0;
+                    for (int y = 0; y < 4; y++)
+                        for (int x = 0; x < 4; x++) {
+                            int nv = nest[y * ys * HVQM2_NEST_W + x * xs];
+                            tmp[y * 4 + x] = nv;
+                            sum += nv;
+                        }
+                    mean = (sum + 8) >> 4;
+                    for (int i = 0; i < 16; i++) {
+                        int t = tmp[i] - mean, av = t < 0 ? -t : t;
+                        tmp[i] = t;
+                        if (av > max) max = av;
+                        norm2 += t * t;
+                    }
+                    s->atom_norm2[a] = norm2;
+                    s->atom_inv[a]   = norm2 ? 1.0f / norm2 : 0.0f;
+                    s->atom_div[a]   = max ? 4096 / max : 0;
+                    s->atom_px[a] = px; s->atom_py[a] = py;
+                    s->atom_xs[a] = xs; s->atom_ys[a] = ys;
+                }
+}
+
+/* Score the 4 stride combos at one nest position (px,py) against the residual,
+ * keeping the best atom seen so far. inv == 0 (flat atom) yields metric 0, so flat
+ * atoms are never selected. */
+static inline void hvqm2_scan_cell(const HVQM2EncContext *s, const int16_t *res16,
+                                   int px, int py, float *best, int *best_a, int *best_dot)
+{
+    int base = (py * HVQM2_ATOM_PX + px) * 4;   /* 4 consecutive atoms: 2 strides x 2 */
+    for (int s4 = 0; s4 < 4; s4++) {
+        int a = base + s4;
+        const int16_t *tmp = s->atom_tmp + a * 16;
+        int dot = 0;
+        float m;
+        for (int i = 0; i < 16; i++)
+            dot += res16[i] * tmp[i];
+        m = (float)dot * dot * s->atom_inv[a];
+        if (m > *best) { *best = m; *best_a = a; *best_dot = dot; }
+    }
+}
+
+/* Greedy matching pursuit for one 4x4 block. src[16] are the source pixels, dc the
+ * transmitted block DC. Fills fixw[]/scl[] (up to MAXB) and returns the basis count.
+ *
+ * Selection metric dot^2/norm2 is the energy a basis captures; by Cauchy-Schwarz it
+ * is <= the residual energy, so a block whose residual energy is <= Z can be skipped
+ * entirely (it stays basis 0 / DC). For each chosen atom the optimal integer
+ * coefficient is round(1024*dot/(div*norm2)) clamped to [-1024,1023]; the exact
+ * integer reconstruction is then subtracted so later bases see the true residual. */
+static int hvqm2_search_block(HVQM2EncContext *s, const uint8_t *src, int dc,
+                              uint16_t *fixw, uint8_t *scl)
+{
+    const float Z = (float)s->quality;
+    int res[16], energy = 0, nb = 0;
+    int16_t res16[16];
+
+    for (int i = 0; i < 16; i++) {
+        res[i] = (int)src[i] - dc;
+        energy += res[i] * res[i];
+    }
+    if ((float)energy <= Z)
+        return 0;
+
+    while (nb < HVQM2_MAXB) {
+        float best = Z;
+        int best_a = -1, best_dot = 0, bpx, bpy;
+
+        for (int i = 0; i < 16; i++)
+            res16[i] = res[i];
+
+        /* Coarse-to-fine selection: the metric dot^2/norm2 varies smoothly with nest
+         * position (neighbouring positions share 3 of every 4 samples), so scan a
+         * stride-2 grid then refine the 3x3 neighbourhood of the winner. ~4x fewer
+         * atoms than exhaustive, with negligible quality loss. */
+        for (int py = 0; py < HVQM2_ATOM_PY; py += 2)
+            for (int px = 0; px < HVQM2_ATOM_PX; px += 2)
+                hvqm2_scan_cell(s, res16, px, py, &best, &best_a, &best_dot);
+        if (best_a < 0)
+            break;
+        bpx = s->atom_px[best_a]; bpy = s->atom_py[best_a];
+        for (int dy = -1; dy <= 1; dy++)
+            for (int dx = -1; dx <= 1; dx++) {
+                int px = bpx + dx, py = bpy + dy;
+                if (px >= 0 && px < HVQM2_ATOM_PX && py >= 0 && py < HVQM2_ATOM_PY)
+                    hvqm2_scan_cell(s, res16, px, py, &best, &best_a, &best_dot);
+            }
+
+        {
+            const int16_t *tmp = s->atom_tmp + best_a * 16;
+            int div = s->atom_div[best_a], n2 = s->atom_norm2[best_a];
+            double c = 1024.0 * best_dot / ((double)div * n2);
+            int coef = (int)(c < 0 ? c - 0.5 : c + 0.5);
+            int beta_q, scale_idx, bar;
+
+            if (coef >  1023) coef =  1023;
+            if (coef < -1024) coef = -1024;
+            if (coef == 0)
+                break;
+
+            bar = coef * div;
+            for (int i = 0; i < 16; i++)
+                res[i] -= (tmp[i] * bar + 512) >> 10;
+
+            beta_q    = coef & 7;
+            scale_idx = (coef >> 3) & 0xFF;
+            fixw[nb]  = (s->atom_xs[best_a] - 1)
+                      | ((s->atom_ys[best_a] - 1) << 1)
+                      | (s->atom_px[best_a] << 2)
+                      | (s->atom_py[best_a] << 8)
+                      | (beta_q << 13);
+            scl[nb]   = scale_idx;
+            nb++;
+        }
+    }
+    return nb;
+}
+
+/* Run AOT analysis over every block of every plane (raster order). */
+static void hvqm2_aot_analyze(HVQM2EncContext *s, const AVFrame *f)
+{
+    uint8_t src[16];
+
+    for (int by = 0; by < s->lum_vblocks; by++)
+        for (int bx = 0; bx < s->lum_hblocks; bx++) {
+            int idx = by * s->lum_hblocks + bx;
+            const uint8_t *p = f->data[0] + (by * 4) * f->linesize[0] + bx * 4;
+            for (int dy = 0; dy < 4; dy++)
+                for (int dx = 0; dx < 4; dx++)
+                    src[dy * 4 + dx] = p[dy * f->linesize[0] + dx];
+            s->bn[0][idx] = hvqm2_search_block(s, src, s->dc[0][idx],
+                                               s->fixw[0] + idx * HVQM2_MAXB,
+                                               s->scl[0]  + idx * HVQM2_MAXB);
+        }
+
+    for (int pl = 1; pl <= 2; pl++)
+        for (int by = 0; by < s->col_vblocks; by++)
+            for (int bx = 0; bx < s->col_hblocks; bx++) {
+                int idx = by * s->col_hblocks + bx;
+                const uint8_t *p = f->data[pl] + (by * 4) * f->linesize[pl] + bx * 4;
+                for (int dy = 0; dy < 4; dy++)
+                    for (int dx = 0; dx < 4; dx++)
+                        src[dy * 4 + dx] = p[dy * f->linesize[pl] + dx];
+                s->bn[pl][idx] = hvqm2_search_block(s, src, s->dc[pl][idx],
+                                                    s->fixw[pl] + idx * HVQM2_MAXB,
+                                                    s->scl[pl]  + idx * HVQM2_MAXB);
+            }
+}
+
+/* Append one block's bases (at most `cap`) to a plane's consumption-order lists. */
+static inline void hvqm2_append_block(HVQM2EncContext *s, int pl, int idx, int cap,
+                                      int *nscl, int *nfix)
+{
+    int nb = s->bn[pl][idx];
+    if (nb > cap)
+        nb = cap;
+    for (int k = 0; k < nb; k++) {
+        s->oscl[pl][(*nscl)++] = s->scl[pl][idx * HVQM2_MAXB + k];
+        s->ofix[pl][(*nfix)++] = s->fixw[pl][idx * HVQM2_MAXB + k];
+    }
+}
+
+/* Order luma scale/fixvl in decBlockCPU consumption order. In 4:1:1 each MCU emits
+ * the two y0 blocks of one row then the two y1 blocks of the row below; in 4:2:2 it
+ * is plain raster. Chroma is one block per MCU = raster, handled by the caller. */
+static void hvqm2_order_luma(HVQM2EncContext *s, int cap, int *nscl, int *nfix)
+{
+    const int lh = s->lum_hblocks, ch = s->col_hblocks, cv = s->col_vblocks;
+    *nscl = *nfix = 0;
+    if (s->mcu411) {
+        for (int r = 0; r < cv; r++)
+            for (int c = 0; c < ch; c++) {
+                hvqm2_append_block(s, 0, (2 * r)     * lh + 2 * c,     cap, nscl, nfix);
+                hvqm2_append_block(s, 0, (2 * r)     * lh + 2 * c + 1, cap, nscl, nfix);
+                hvqm2_append_block(s, 0, (2 * r + 1) * lh + 2 * c,     cap, nscl, nfix);
+                hvqm2_append_block(s, 0, (2 * r + 1) * lh + 2 * c + 1, cap, nscl, nfix);
+            }
+    } else {
+        for (int r = 0; r < cv; r++)            /* cv == lum_vblocks for 4:2:2 */
+            for (int c = 0; c < ch; c++) {
+                hvqm2_append_block(s, 0, r * lh + 2 * c,     cap, nscl, nfix);
+                hvqm2_append_block(s, 0, r * lh + 2 * c + 1, cap, nscl, nfix);
+            }
+    }
+}
+
+/* =========================== frame ============================ */
+
+/* Assemble the keyframe body into s->pktbuf using at most `cap` bases per block, and
+ * return the body size. Cheap (no AOT re-search): it re-runs only RLE/ordering/Huffman
+ * off the already-computed per-block results, so it can be retried with a smaller cap
+ * to satisfy the per-record size limit. Depends on hvqm2_dc_deltas() having been run. */
+static int hvqm2_assemble_body(HVQM2EncContext *s, int cap)
+{
+    uint8_t *buf = s->pktbuf;
+    HVQM2Huff dc_h, bn_h, run_h, scale_h;
+    uint64_t dcfreq[256] = { 0 }, bnfreq[256] = { 0 }, runfreq[256] = { 0 },
+             scfreq[256] = { 0 };
+    int ndc[3] = { 0 }, ndcrun[3] = { 0 };
+    int nbnval[2] = { 0 }, nbnrun[2] = { 0 };
+    int nscl[3] = { 0 }, nfix[3] = { 0 };
+    int pos;
+    uint32_t off_bn[2], off_bnr[2], off_sc[3], off_fx[3], off_dc[3], off_dcr[3];
+
+    /* ---- DC streams (RLE; independent of cap) ---- */
+    hvqm2_rle_dc(s->dcd[0], s->lum_total, s->dcsym[0], &ndc[0], s->dcrun[0], &ndcrun[0], dcfreq, runfreq);
+    hvqm2_rle_dc(s->dcd[1], s->col_total, s->dcsym[1], &ndc[1], s->dcrun[1], &ndcrun[1], dcfreq, runfreq);
+    hvqm2_rle_dc(s->dcd[2], s->col_total, s->dcsym[2], &ndc[2], s->dcrun[2], &ndcrun[2], dcfreq, runfreq);
+
+    /* ---- basis-number streams (RLE; chroma packs U|V<<4), capped at `cap` ---- */
+    {
+        uint8_t *lcap = s->oscl[0];              /* scratch: luma scale order built later */
+        for (int i = 0; i < s->lum_total; i++) {
+            int v = s->bn[0][i];
+            lcap[i] = v < cap ? v : cap;
+        }
+        hvqm2_rle_bn(lcap, s->lum_total, s->bnval[0], &nbnval[0], s->bnrun[0], &nbnrun[0], bnfreq, runfreq);
+    }
+    {
+        uint8_t *packed = s->oscl[1];            /* scratch: chroma scale order built later */
+        for (int i = 0; i < s->col_total; i++) {
+            int u = s->bn[1][i], v = s->bn[2][i];
+            packed[i] = (u < cap ? u : cap) | ((v < cap ? v : cap) << 4);
+        }
+        hvqm2_rle_bn(packed, s->col_total, s->bnval[1], &nbnval[1], s->bnrun[1], &nbnrun[1], bnfreq, runfreq);
+    }
+
+    /* ---- scale + fixvl in consumption order, capped ---- */
+    hvqm2_order_luma(s, cap, &nscl[0], &nfix[0]);
+    for (int by = 0; by < s->col_vblocks; by++)
+        for (int bx = 0; bx < s->col_hblocks; bx++)
+            hvqm2_append_block(s, 1, by * s->col_hblocks + bx, cap, &nscl[1], &nfix[1]);
+    for (int by = 0; by < s->col_vblocks; by++)
+        for (int bx = 0; bx < s->col_hblocks; bx++)
+            hvqm2_append_block(s, 2, by * s->col_hblocks + bx, cap, &nscl[2], &nfix[2]);
+    for (int pl = 0; pl < 3; pl++)
+        for (int i = 0; i < nscl[pl]; i++)
+            scfreq[s->oscl[pl][i]]++;
+
+    /* ---- build the four shared trees ---- */
+    hvqm2_huff_init(&dc_h,    dcfreq);
+    hvqm2_huff_init(&bn_h,    bnfreq);
+    hvqm2_huff_init(&run_h,   runfreq);
+    hvqm2_huff_init(&scale_h, scfreq);
+
+    /* ---- write the streams ---- */
+    memset(buf, 0, 68);                          /* HVQM2Frame(52) + HVQM2KeyFrame(16) */
+    pos = 68;
+
+    off_bn[0]  = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &bn_h,    1, s->bnval[0], nbnval[0]);
+    off_bn[1]  = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &bn_h,    0, s->bnval[1], nbnval[1]);
+    off_bnr[0] = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &run_h,   1, s->bnrun[0], nbnrun[0]);
+    off_bnr[1] = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &run_h,   0, s->bnrun[1], nbnrun[1]);
+
+    off_sc[0]  = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &scale_h, 1, s->oscl[0], nscl[0]);
+    off_sc[1]  = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &scale_h, 0, s->oscl[1], nscl[1]);
+    off_sc[2]  = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &scale_h, 0, s->oscl[2], nscl[2]);
+
+    off_fx[0]  = pos; pos = hvqm2_put_words(buf, pos, s->pktbuf_size, s->ofix[0], nfix[0]);
+    off_fx[1]  = pos; pos = hvqm2_put_words(buf, pos, s->pktbuf_size, s->ofix[1], nfix[1]);
+    off_fx[2]  = pos; pos = hvqm2_put_words(buf, pos, s->pktbuf_size, s->ofix[2], nfix[2]);
+
+    off_dc[0]  = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &dc_h,    1, s->dcsym[0], ndc[0]);
+    off_dc[1]  = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &dc_h,    0, s->dcsym[1], ndc[1]);
+    off_dc[2]  = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &dc_h,    0, s->dcsym[2], ndc[2]);
+
+    /* dcrun shares the basisnumrun tree (no tree of its own). */
+    off_dcr[0] = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &run_h,   0, s->dcrun[0], ndcrun[0]);
+    off_dcr[1] = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &run_h,   0, s->dcrun[1], ndcrun[1]);
+    off_dcr[2] = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &run_h,   0, s->dcrun[2], ndcrun[2]);
+
+    /* HVQM2Frame offset table (big-endian, relative to body start). */
+    AV_WB32(buf +  0, off_bn[0]);  AV_WB32(buf +  4, off_bn[1]);    /* basisnum[0],[1]  */
+    AV_WB32(buf +  8, off_bnr[0]); AV_WB32(buf + 12, off_bnr[1]);   /* basnumrn[0],[1]  */
+    AV_WB32(buf + 16, off_sc[0]);  AV_WB32(buf + 20, off_sc[1]);  AV_WB32(buf + 24, off_sc[2]);
+    AV_WB32(buf + 28, off_fx[0]);  AV_WB32(buf + 32, off_fx[1]);  AV_WB32(buf + 36, off_fx[2]);
+    AV_WB32(buf + 40, off_dc[0]);  AV_WB32(buf + 44, off_dc[1]);  AV_WB32(buf + 48, off_dc[2]);
+    /* HVQM2KeyFrame: dcrun[0..2], nest at (0,0). */
+    AV_WB32(buf + 52, off_dcr[0]); AV_WB32(buf + 56, off_dcr[1]); AV_WB32(buf + 60, off_dcr[2]);
+    AV_WB16(buf + 64, 0);  AV_WB16(buf + 66, 0);
+
+    return pos;                                  /* body_size */
+}
+
+/* ===================== closed-loop reconstruction (Phase B2b) =====================
+ *
+ * A faithful port of the oracle decoder's reconstruction path
+ * (src/reference/hvqm2/hvqm2.c: decFrame / decLine / decBlockCPU / WeightImBlock /
+ * ColorConv411|422 / yuv2rgba), driven by the encoder's own quantized per-block arrays
+ * instead of a re-parsed bitstream. Because it is the decoder's own math fed the same
+ * values the encoder serialized, the result is bit-identical to what the decoder
+ * produces (verified by diffing against output/video_*.ppm). It writes a reconstructed
+ * RGBA framebuffer (the decoder's reference for INTER copies) and captures the
+ * reconstructed luma plane (the decoder's displayed luma) for the luma-SAD motion search.
+ *
+ * Profile assumptions baked in (match libavformat/hvqmenc.c): y_shiftnum == 8 (landscape
+ * nest, nest_pos_x 6 bits / nest_pos_y 5 bits), video_quantize_shift == 0, basis <= 6
+ * (never the format's "raw block" code 8). */
+
+typedef struct RWcode {
+    uint8_t *basis_prev_line, *dcbuf_prev_line;
+    uint8_t *basis_curr_line, *dcbuf_curr_line;
+    uint8_t *basis_next_line, *dcbuf_next_line;
+    uint8_t  basis_next, dcbuf_next, basis_curr, dcbuf_curr, dcbuf_prev;
+} RWcode;
+
+typedef struct HVQM2Recon {
+    int fbw;                      /* framebuffer width (== image width; no padding) */
+    int im_width, im_height;
+    int lum_hblocks, col_hblocks, col_vblocks;
+    int mcu411;
+    int mcu_h_pix, mcu_v_pix;     /* pixel advance per MCU column / row (in fbw units) */
+    uint8_t *basis[3];            /* capped basis / 0x80, raster per plane */
+    uint8_t *dcbuf[3];            /* DC image, raster per plane */
+    const uint16_t *fixp[3];      /* advancing fixvl word stream (consumption order) */
+    const uint8_t  *sclp[3];      /* advancing scale-index stream (consumption order) */
+    const uint8_t  *nest;
+    int nest_w;
+    const int *divT;
+    uint32_t *out;                /* RGBA destination (the only reconstruction state) */
+    RWcode u_wcode, v_wcode, y0wcode, y1wcode;
+    uint16_t pix_y[4][16], pix_u[16], pix_v[16];
+} HVQM2Recon;
+
+/* y/u/v are int16_t (not int) on purpose: WeightImBlock writes u16 pixels that wrap to
+ * ~65535 on a strongly-negative gradient, and the decoder's yuv2rgba takes s16 -- so it
+ * reinterprets such a pixel as a small negative value. Matching the type here reproduces
+ * that exactly; a plain int would zero-extend to ~65535 and diverge (white vs near-black). */
+static uint32_t hvqm2_yuv2rgba(int16_t y, int16_t u, int16_t v)
+{
+    int y6, r16, g16, b16, rr, gg, bb, r, g, b;
+    u -= 128;
+    v -= 128;
+    y6  = y << 6;
+    r16 = (int16_t)(0x4020 + v * 90);
+    g16 = (int16_t)(0x4020 - v * 46 - u * 22);
+    b16 = (int16_t)(0x4020 + u * 113);
+    rr = ((y6 + r16) >> 6) - 0x100;
+    gg = ((y6 + g16) >> 6) - 0x100;
+    bb = ((y6 + b16) >> 6) - 0x100;
+    r = rr < 0 ? 0 : rr > 0xff ? 0xff : rr;
+    g = gg < 0 ? 0 : gg > 0xff ? 0xff : gg;
+    b = bb < 0 ? 0 : bb > 0xff ? 0xff : bb;
+    return 0xffu << 24 | (unsigned)b << 16 | (unsigned)g << 8 | (unsigned)r;
+}
+
+static void hvqm2_colorconv422(HVQM2Recon *r, uint32_t *out)
+{
+    const uint16_t *y0 = r->pix_y[0], *y1 = r->pix_y[0] + 16;
+    const uint16_t *pu = r->pix_u, *pv = r->pix_v;
+    for (int i = 0; i < 4; i++) {
+        uint32_t *o = out;
+        for (int j = 0; j < 2; j++) {
+            *o++ = hvqm2_yuv2rgba(*y0++, pu[0], pv[0]);
+            *o++ = hvqm2_yuv2rgba(*y0++, pu[0], pv[0]); pu++; pv++;
+        }
+        for (int j = 0; j < 2; j++) {
+            *o++ = hvqm2_yuv2rgba(*y1++, pu[0], pv[0]);
+            *o++ = hvqm2_yuv2rgba(*y1++, pu[0], pv[0]); pu++; pv++;
+        }
+        out += r->fbw;
+    }
+}
+
+static void hvqm2_colorconv411(HVQM2Recon *r, uint32_t *out)
+{
+    const uint16_t *y0 = r->pix_y[0], *y1 = r->pix_y[0] + 16;
+    const uint16_t *pu = r->pix_u, *pv = r->pix_v;
+    for (int k = 0; k < 2; k++) {
+        for (int i = 0; i < 2; i++) {
+            for (int n = 0; n < 2; n++) {
+                uint32_t *o = out;
+                const uint16_t *u = pu, *v = pv;
+                for (int j = 0; j < 2; j++) {
+                    *o++ = hvqm2_yuv2rgba(*y0++, u[0], v[0]);
+                    *o++ = hvqm2_yuv2rgba(*y0++, u[0], v[0]); u++; v++;
+                }
+                for (int j = 0; j < 2; j++) {
+                    *o++ = hvqm2_yuv2rgba(*y1++, u[0], v[0]);
+                    *o++ = hvqm2_yuv2rgba(*y1++, u[0], v[0]); u++; v++;
+                }
+                out += r->fbw;
+            }
+            pu += 4; pv += 4;
+        }
+        y0 += 16; y1 += 16;
+    }
+}
+
+static void hvqm2_weight_imblock(uint16_t *pix, int curr, int top, int bottom,
+                                 int left, int right)
+{
+    int tmb = top - bottom, lmr = left - right;
+    int vph = tmb + lmr, vmh = tmb - lmr;
+    int c2 = curr * 2, c8 = curr * 8 + 4;
+    int tpl = top + left - c2,  tpr = top + right - c2;
+    int bpr = bottom + right - c2, bpl = bottom + left - c2;
+    int tml = top - left,  tmr = top - right;
+    int bmr = bottom - right, bml = bottom - left;
+    pix[0]  = (unsigned)(c8 + vph + tpl) / 8;
+    pix[1]  = (unsigned)(c8 + vph + tml) / 8;
+    pix[2]  = (unsigned)(c8 + vmh + tmr) / 8;
+    pix[3]  = (unsigned)(c8 + vmh + tpr) / 8;
+    pix[4]  = (unsigned)(c8 + vph - tml) / 8;
+    pix[5]  = (unsigned)(c8 - bpr) / 8;
+    pix[6]  = (unsigned)(c8 - bpl) / 8;
+    pix[7]  = (unsigned)(c8 + vmh - tmr) / 8;
+    pix[8]  = (unsigned)(c8 - vmh - bml) / 8;
+    pix[9]  = (unsigned)(c8 - tpr) / 8;
+    pix[10] = (unsigned)(c8 - tpl) / 8;
+    pix[11] = (unsigned)(c8 - vph - bmr) / 8;
+    pix[12] = (unsigned)(c8 - vmh + bpl) / 8;
+    pix[13] = (unsigned)(c8 - vmh + bml) / 8;
+    pix[14] = (unsigned)(c8 - vph + bmr) / 8;
+    pix[15] = (unsigned)(c8 - vph + bpr) / 8;
+}
+
+static void hvqm2_dec_block(HVQM2Recon *r, uint16_t *pix, RWcode *w, int plane)
+{
+    if (w->basis_curr == 0) {
+        int curr   = w->dcbuf_curr;
+        int right  =  w->basis_next      == 0 ?  w->dcbuf_next      : curr;
+        int top    = *w->basis_prev_line == 0 ? *w->dcbuf_prev_line : curr;
+        int bottom = *w->basis_next_line == 0 ? *w->dcbuf_next_line : curr;
+        int left   =  w->dcbuf_prev;
+        hvqm2_weight_imblock(pix, curr, top, bottom, left, right);
+        w->dcbuf_prev = w->dcbuf_curr;
+    } else {
+        for (int i = 0; i < 16; i++)
+            pix[i] = w->dcbuf_curr;
+        for (int b = 0; b < w->basis_curr; b++) {
+            unsigned bits = *r->fixp[plane]++;
+            int x_stride = (bits & 1) + 1, y_stride = ((bits >> 1) & 1) + 1;
+            int nest_pos_y = (bits >> 8) & 0x1F, nest_pos_x = (bits >> 2) & 0x3F;
+            const uint8_t *nest = r->nest + nest_pos_y * r->nest_w + nest_pos_x;
+            int16_t tmp[16];
+            int sum = 0, mean, max = -1, beta_q, scale, div, bar;
+            for (int y = 0; y < 4; y++)
+                for (int x = 0; x < 4; x++) {
+                    int nv = nest[y * y_stride * r->nest_w + x * x_stride];
+                    tmp[y * 4 + x] = nv;
+                    sum += nv;
+                }
+            mean = (sum + 8) >> 4;
+            for (int i = 0; i < 16; i++) {
+                int t = tmp[i] - mean, av = t < 0 ? -t : t;
+                tmp[i] = t;
+                if (av > max) max = av;
+            }
+            beta_q = (bits >> 13) & 7;
+            scale  = (int8_t)(*r->sclp[plane]++) << 3;
+            div    = r->divT[max];
+            bar    = (beta_q + scale) * div;
+            for (int i = 0; i < 16; i++)
+                pix[i] += (tmp[i] * bar + 512) >> 10;
+        }
+        w->dcbuf_prev = w->dcbuf_next;
+    }
+    w->basis_prev_line++; w->dcbuf_prev_line++;
+    w->basis_next_line++; w->dcbuf_next_line++;
+}
+
+static void hvqm2_advance_wcode(RWcode *w, int amount)
+{
+    w->basis_prev_line += amount; w->dcbuf_prev_line += amount;
+    w->basis_curr_line += amount; w->dcbuf_curr_line += amount;
+    w->basis_next_line += amount; w->dcbuf_next_line += amount;
+}
+
+static void hvqm2_update_wcode(RWcode *w)
+{
+    w->basis_curr = w->basis_next;
+    w->dcbuf_curr = w->dcbuf_next;
+    w->basis_curr_line++; w->dcbuf_curr_line++;
+    w->basis_next = *w->basis_curr_line;
+    w->dcbuf_next = *w->dcbuf_curr_line;
+}
+
+static void hvqm2_dec_line(HVQM2Recon *r, uint32_t *out)
+{
+    RWcode *y0 = &r->y0wcode, *y1 = &r->y1wcode, *u = &r->u_wcode, *v = &r->v_wcode;
+    u->basis_next = *u->basis_curr_line; u->dcbuf_prev = *u->dcbuf_curr_line; u->dcbuf_next = *u->dcbuf_curr_line;
+    v->basis_next = *v->basis_curr_line; v->dcbuf_prev = *v->dcbuf_curr_line; v->dcbuf_next = *v->dcbuf_curr_line;
+    y0->basis_next = *y0->basis_curr_line; y0->dcbuf_prev = *y0->dcbuf_curr_line; y0->dcbuf_next = *y0->dcbuf_curr_line;
+    if (r->mcu411) {
+        y1->basis_next = *y1->basis_curr_line; y1->dcbuf_prev = *y1->dcbuf_curr_line; y1->dcbuf_next = *y1->dcbuf_curr_line;
+    }
+    for (int i = 0; i < r->col_hblocks - 1; i++) {
+        if (y0->basis_next == 0x80) {                       /* INTER MCU: leave the copy */
+            hvqm2_advance_wcode(y0, 2);
+            y0->basis_next = *y0->basis_curr_line; y0->dcbuf_prev = *y0->dcbuf_curr_line; y0->dcbuf_next = *y0->dcbuf_curr_line;
+            if (r->mcu411) {
+                hvqm2_advance_wcode(y1, 2);
+                y1->basis_next = *y1->basis_curr_line; y1->dcbuf_prev = *y1->dcbuf_curr_line; y1->dcbuf_next = *y1->dcbuf_curr_line;
+            }
+            hvqm2_advance_wcode(u, 1);
+            u->basis_next = *u->basis_curr_line; u->dcbuf_prev = *u->dcbuf_curr_line; u->dcbuf_next = *u->dcbuf_curr_line;
+            hvqm2_advance_wcode(v, 1);
+            v->basis_next = *v->basis_curr_line; v->dcbuf_prev = *v->dcbuf_curr_line; v->dcbuf_next = *v->dcbuf_curr_line;
+        } else {
+            hvqm2_update_wcode(y0); hvqm2_dec_block(r, r->pix_y[0], y0, 0);
+            hvqm2_update_wcode(y0); hvqm2_dec_block(r, r->pix_y[1], y0, 0);
+            if (r->mcu411) {
+                hvqm2_update_wcode(y1); hvqm2_dec_block(r, r->pix_y[2], y1, 0);
+                hvqm2_update_wcode(y1); hvqm2_dec_block(r, r->pix_y[3], y1, 0);
+            }
+            hvqm2_update_wcode(u); hvqm2_dec_block(r, r->pix_u, u, 1);
+            hvqm2_update_wcode(v); hvqm2_dec_block(r, r->pix_v, v, 2);
+            if (r->mcu411) hvqm2_colorconv411(r, out); else hvqm2_colorconv422(r, out);
+        }
+        out += r->mcu_h_pix;
+    }
+    if (y0->basis_next == 0x80) {                           /* last MCU in the row */
+        hvqm2_advance_wcode(y0, 2);
+        if (r->mcu411) hvqm2_advance_wcode(y1, 2);
+        hvqm2_advance_wcode(u, 1);
+        hvqm2_advance_wcode(v, 1);
+    } else {
+        hvqm2_update_wcode(y0); hvqm2_dec_block(r, r->pix_y[0], y0, 0);
+        y0->basis_curr = y0->basis_next; y0->dcbuf_curr = y0->dcbuf_next;
+        y0->basis_curr_line++; y0->dcbuf_curr_line++;
+        hvqm2_dec_block(r, r->pix_y[1], y0, 0);
+        if (r->mcu411) {
+            hvqm2_update_wcode(y1); hvqm2_dec_block(r, r->pix_y[2], y1, 0);
+            y1->basis_curr = y1->basis_next; y1->dcbuf_curr = y1->dcbuf_next;
+            y1->basis_curr_line++; y1->dcbuf_curr_line++;
+            hvqm2_dec_block(r, r->pix_y[3], y1, 0);
+        }
+        u->basis_curr = u->basis_next; u->dcbuf_curr = u->dcbuf_next;
+        u->basis_curr_line++; u->dcbuf_curr_line++;
+        hvqm2_dec_block(r, r->pix_u, u, 1);
+        v->basis_curr = v->basis_next; v->dcbuf_curr = v->dcbuf_next;
+        v->basis_curr_line++; v->dcbuf_curr_line++;
+        hvqm2_dec_block(r, r->pix_v, v, 2);
+        if (r->mcu411) hvqm2_colorconv411(r, out); else hvqm2_colorconv422(r, out);
+    }
+}
+
+/* Reconstruct the whole frame into r->out (RGBA). INTER MCUs (basis 0x80) must already be
+ * copied into r->out; this fills every intra MCU. Mirrors the oracle's decFrame wcode
+ * line-pointer setup exactly. */
+static void hvqm2_dec_frame(HVQM2Recon *r)
+{
+    const int lh = r->lum_hblocks, ch = r->col_hblocks;
+    uint32_t *out = r->out;
+    RWcode *y0 = &r->y0wcode, *y1 = &r->y1wcode, *u = &r->u_wcode, *v = &r->v_wcode;
+
+    u->basis_prev_line = u->basis_curr_line = r->basis[1]; u->basis_next_line = r->basis[1] + ch;
+    u->dcbuf_prev_line = u->dcbuf_curr_line = r->dcbuf[1]; u->dcbuf_next_line = r->dcbuf[1] + ch;
+    v->basis_prev_line = v->basis_curr_line = r->basis[2]; v->basis_next_line = r->basis[2] + ch;
+    v->dcbuf_prev_line = v->dcbuf_curr_line = r->dcbuf[2]; v->dcbuf_next_line = r->dcbuf[2] + ch;
+    y0->basis_prev_line = y0->basis_curr_line = r->basis[0]; y0->basis_next_line = r->basis[0] + lh;
+    y0->dcbuf_prev_line = y0->dcbuf_curr_line = r->dcbuf[0]; y0->dcbuf_next_line = r->dcbuf[0] + lh;
+    if (r->mcu411) {
+        y1->basis_prev_line = r->basis[0]; y1->basis_curr_line = r->basis[0] + lh; y1->basis_next_line = r->basis[0] + 2 * lh;
+        y1->dcbuf_prev_line = r->dcbuf[0]; y1->dcbuf_curr_line = r->dcbuf[0] + lh; y1->dcbuf_next_line = r->dcbuf[0] + 2 * lh;
+    }
+    hvqm2_dec_line(r, out);
+    out += r->mcu_v_pix;
+
+    u->basis_prev_line = r->basis[1]; u->dcbuf_prev_line = r->dcbuf[1];
+    v->basis_prev_line = r->basis[2]; v->dcbuf_prev_line = r->dcbuf[2];
+    if (r->mcu411) {
+        y0->basis_curr_line += lh; y0->dcbuf_curr_line += lh;
+        y0->basis_next_line += lh; y0->dcbuf_next_line += lh;
+        hvqm2_advance_wcode(y1, lh);
+    } else {
+        y0->basis_prev_line = r->basis[0]; y0->dcbuf_prev_line = r->dcbuf[0];
+    }
+
+    for (int line = 1; line < r->col_vblocks - 1; line++) {
+        hvqm2_dec_line(r, out);
+        out += r->mcu_v_pix;
+        if (r->mcu411) {
+            hvqm2_advance_wcode(y0, lh);
+            hvqm2_advance_wcode(y1, lh);
+        }
+    }
+
+    u->basis_next_line = u->basis_curr_line; u->dcbuf_next_line = u->dcbuf_curr_line;
+    v->basis_next_line = v->basis_curr_line; v->dcbuf_next_line = v->dcbuf_curr_line;
+    if (r->mcu411) {
+        y1->basis_next_line = y1->basis_curr_line; y1->dcbuf_next_line = y1->dcbuf_curr_line;
+    } else {
+        y0->basis_next_line = y0->basis_curr_line; y0->dcbuf_next_line = y0->dcbuf_curr_line;
+    }
+    hvqm2_dec_line(r, out);
+}
+
+/* Fill the per-frame geometry of a reconstruction context. basis/dcbuf and the AOT
+ * streams are set by the caller (key vs P differ). */
+static void hvqm2_recon_init(HVQM2EncContext *s, HVQM2Recon *r, uint32_t *out)
+{
+    memset(r, 0, sizeof(*r));
+    r->fbw = s->width;
+    r->im_width = s->width; r->im_height = s->height;
+    r->lum_hblocks = s->lum_hblocks;
+    r->col_hblocks = s->col_hblocks; r->col_vblocks = s->col_vblocks;
+    r->mcu411 = s->mcu411;
+    r->mcu_h_pix = 8;
+    r->mcu_v_pix = (s->mcu411 ? 8 : 4) * s->width;
+    r->nest = s->nest; r->nest_w = HVQM2_NEST_W;
+    r->divT = s->divT;
+    r->out = out;
+}
+
+/* Derive the ME luma plane from the reconstructed RGBA reference, so motion estimation
+ * scores against exactly the frame the decoder holds (the decoder keeps RGBA only; there
+ * is no separate luma state to drift from it). BT.601 luma weights invert the decoder's
+ * (near-BT.601) yuv2rgba well enough to recover ~Y for the source-vs-reference SAD. */
+static void hvqm2_extract_luma(HVQM2EncContext *s)
+{
+    const uint32_t *fb = s->ref_rgba[s->buf_cur];
+    uint8_t *y = s->ref_y[s->buf_cur];
+    int n = s->width * s->height;
+    for (int i = 0; i < n; i++) {
+        uint32_t px = fb[i];                                  /* packed a<<24|b<<16|g<<8|r */
+        int r = px & 0xff, g = (px >> 8) & 0xff, b = (px >> 16) & 0xff;   /* endian-safe */
+        y[i] = (77 * r + 150 * g + 29 * b) >> 8;
+    }
+}
+
+/* Reconstruct a keyframe (all intra) from the encoder's quantized arrays, using at most
+ * `cap` bases per block (the same cap the body was assembled with). After this the body's
+ * scale/fixvl consumption order (s->oscl / s->ofix) is the reconstruction stream order. */
+static void hvqm2_recon_keyframe(HVQM2EncContext *s, int cap)
+{
+    HVQM2Recon r;
+    int nblk[3] = { s->lum_total, s->col_total, s->col_total };
+
+    for (int pl = 0; pl < 3; pl++)
+        for (int i = 0; i < nblk[pl]; i++) {
+            int b = s->bn[pl][i];
+            s->rbn[pl][i] = b < cap ? b : cap;
+        }
+
+    hvqm2_recon_init(s, &r, s->ref_rgba[s->buf_cur]);
+    for (int pl = 0; pl < 3; pl++) {
+        r.basis[pl] = s->rbn[pl];
+        r.dcbuf[pl] = s->dc[pl];
+        r.fixp[pl]  = s->ofix[pl];
+        r.sclp[pl]  = s->oscl[pl];
+    }
+    hvqm2_dec_frame(&r);
+}
+
+/* =========================== inter (P) frames — Phase B (B2a) ============================ */
+
+/* Raw byte payload stream: [u32 size][bytes padded to 4]. Used for the macroblock
+ * type-bit stream (no Huffman tree). */
+static int hvqm2_put_raw(uint8_t *buf, int pos, int cap, const uint8_t *src, int n)
+{
+    int nbytes = n;
+    av_assert0(pos + 4 + ((nbytes + 3) & ~3) <= cap);
+    memcpy(buf + pos + 4, src, n);
+    while (nbytes & 3)
+        buf[pos + 4 + nbytes++] = 0;
+    AV_WB32(buf + pos, nbytes);
+    return pos + 4 + nbytes;
+}
+
+/* SAD of the current 8x8 luma block at (cx,cy) against prev_y shifted by (mvx,mvy). */
+static int hvqm2_sad8(const uint8_t *cur, int cls, const uint8_t *prev, int pw,
+                      int cx, int cy, int mvx, int mvy)
+{
+    const uint8_t *c = cur  + cy * cls + cx;
+    const uint8_t *p = prev + (cy + mvy) * pw + (cx + mvx);
+    int sad = 0;
+    for (int i = 0; i < 8; i++, c += cls, p += pw)
+        for (int j = 0; j < 8; j++)
+            sad += FFABS((int)c[j] - (int)p[j]);
+    return sad;
+}
+
+/* Integer-pel motion search for one 8x8 MB. Predictor-seeded (running MV, zero), then a
+ * small-diamond refine. Candidates are clamped so the 8x8 source stays fully in bounds
+ * (the decoder does no bounds check) and within +/- me_range. Returns best SAD. */
+static int hvqm2_me(HVQM2EncContext *s, const uint8_t *cur, int cls, int cx, int cy,
+                    int run_mvx, int run_mvy, int *bmvx, int *bmvy)
+{
+    const uint8_t *prev = s->me_ref;     /* previous *reconstructed* luma (closed loop) */
+    const int W = s->width, H = s->height, R = s->me_range;
+    const int lox = FFMAX(-cx, -R), hix = FFMIN(W - 8 - cx, R);
+    const int loy = FFMAX(-cy, -R), hiy = FFMIN(H - 8 - cy, R);
+    int best = INT_MAX, bx = 0, by = 0;
+    int cand[2][2] = { { 0, 0 }, { run_mvx, run_mvy } };
+
+    for (int k = 0; k < 2; k++) {
+        int mx = av_clip(cand[k][0], lox, hix), my = av_clip(cand[k][1], loy, hiy);
+        int sad = hvqm2_sad8(cur, cls, prev, W, cx, cy, mx, my);
+        if (sad < best) { best = sad; bx = mx; by = my; }
+    }
+    for (int iter = 0; iter < 16; iter++) {           /* small-diamond descent */
+        static const int dxy[4][2] = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } };
+        int moved = 0;
+        for (int d = 0; d < 4; d++) {
+            int mx = bx + dxy[d][0], my = by + dxy[d][1];
+            if (mx < lox || mx > hix || my < loy || my > hiy)
+                continue;
+            int sad = hvqm2_sad8(cur, cls, prev, W, cx, cy, mx, my);
+            if (sad < best) { best = sad; bx = mx; by = my; moved = 1; }
+        }
+        if (!moved)
+            break;
+    }
+    *bmvx = bx; *bmvy = by;
+    return best;
+}
+
+/* Mean of a w x h region of a plane. */
+static int hvqm2_region_mean(const uint8_t *p, int ls, int x0, int y0, int w, int h)
+{
+    int sum = 0;
+    for (int i = 0; i < h; i++)
+        for (int j = 0; j < w; j++)
+            sum += p[(y0 + i) * ls + x0 + j];
+    return (sum + (w * h) / 2) / (w * h);
+}
+
+enum { PF_INTER, PF_INTRA_DC, PF_INTRA_FULL };
+
+/* AOT matching-pursuit for one 4x4 block of a plane (luma or chroma), addressed by raster
+ * index within that plane's `hb`-wide block grid. Fills s->bn/scl/fixw at `idx` and returns
+ * the basis count. Mirrors hvqm2_aot_analyze's per-block call, reused for P INTRA-FULL. */
+static int hvqm2_search_plane_block(HVQM2EncContext *s, const AVFrame *f, int pl, int idx, int hb)
+{
+    uint8_t src[16];
+    const int ls = f->linesize[pl];
+    const uint8_t *p = f->data[pl] + (idx / hb) * 4 * ls + (idx % hb) * 4;
+    for (int dy = 0; dy < 4; dy++)
+        for (int dx = 0; dx < 4; dx++)
+            src[dy * 4 + dx] = p[dy * ls + dx];
+    return hvqm2_search_block(s, src, s->dc[pl][idx],
+                              s->fixw[pl] + idx * HVQM2_MAXB, s->scl[pl] + idx * HVQM2_MAXB);
+}
+
+/* Emit the cap-dependent P-frame streams: basisnum[0,1] + basnumrn[0,1] (MB-interleaved,
+ * capped at `cap` bases/block) and scale[0..2] + fixvl[0..2] (decLine consumption order,
+ * capped), alongside the cap-independent dcval[0..2], movevector and macroblock streams,
+ * then fill the HVQM2Frame + HVQM2PredictFrame offset table. Also sets the reconstruction
+ * basis s->rbn for INTRA-FULL blocks at this cap (INTER=0x80 / INTRA-DC=0 were set during
+ * analysis). Returns the body size. Trees are built one-per-category (embedded in stream
+ * [0]); empty categories degrade to zero-size streams the decoder never reads from. */
+static int hvqm2_pframe_emit(HVQM2EncContext *s, int cap, int nmv, const int ndc[3], int mbbytes)
+{
+    uint8_t *buf = s->pktbuf;
+    const int lh = s->lum_hblocks, ch = s->col_hblocks;
+    HVQM2Huff bn_h, run_h, scale_h, dc_h, mv_h;
+    uint64_t bnfreq[256] = { 0 }, runfreq[256] = { 0 }, scfreq[256] = { 0 },
+             dcfreq[256] = { 0 }, mvfreq[256] = { 0 };
+    int nbnval[2] = { 0 }, nbnrun[2] = { 0 }, nscl[3] = { 0 }, nfix[3] = { 0 };
+    int nbl = 0, nbc = 0, pos;
+    uint32_t off_bn[2], off_bnr[2], off_sc[3], off_fx[3], off_dc[3], off_mv, off_mb;
+
+    /* ---- MB-interleaved basisnum (luma b0,b1,b2,b3 then packed chroma U|V<<4), capped,
+     *      then RLE. Only INTRA-FULL MBs contribute; INTER/INTRA-DC read no basisnum. Set
+     *      the capped reconstruction basis for those blocks here (cap-dependent). ---- */
+    for (int mby = 0; mby < s->mb_h; mby++)
+        for (int mbx = 0; mbx < s->mb_w; mbx++) {
+            int l0, l1, c0, c1, bl[4], u, v;
+            if (s->mb_mode[mby * s->mb_w + mbx] != PF_INTRA_FULL)
+                continue;
+            l0 = (2 * mby) * lh + 2 * mbx; l1 = (2 * mby + 1) * lh + 2 * mbx;
+            c0 = s->mcu411 ? mby * ch + mbx : (2 * mby) * ch + mbx;
+            c1 = (2 * mby + 1) * ch + mbx;
+            bl[0] = FFMIN(s->bn[0][l0], cap);     bl[1] = FFMIN(s->bn[0][l0 + 1], cap);
+            bl[2] = FFMIN(s->bn[0][l1], cap);     bl[3] = FFMIN(s->bn[0][l1 + 1], cap);
+            for (int k = 0; k < 4; k++)
+                s->pf_bnl[nbl++] = bl[k];
+            s->rbn[0][l0] = bl[0]; s->rbn[0][l0 + 1] = bl[1];
+            s->rbn[0][l1] = bl[2]; s->rbn[0][l1 + 1] = bl[3];
+            u = FFMIN(s->bn[1][c0], cap); v = FFMIN(s->bn[2][c0], cap);
+            s->pf_bnc[nbc++] = u | (v << 4);
+            s->rbn[1][c0] = u; s->rbn[2][c0] = v;
+            if (!s->mcu411) {
+                u = FFMIN(s->bn[1][c1], cap); v = FFMIN(s->bn[2][c1], cap);
+                s->pf_bnc[nbc++] = u | (v << 4);
+                s->rbn[1][c1] = u; s->rbn[2][c1] = v;
+            }
+        }
+    hvqm2_rle_bn(s->pf_bnl, nbl, s->bnval[0], &nbnval[0], s->bnrun[0], &nbnrun[0], bnfreq, runfreq);
+    hvqm2_rle_bn(s->pf_bnc, nbc, s->bnval[1], &nbnval[1], s->bnrun[1], &nbnrun[1], bnfreq, runfreq);
+
+    /* ---- scale + fixvl in decLine consumption order, capped. s->bn is 0 for INTER and
+     *      INTRA-DC blocks (cleared in analysis), so only INTRA-FULL blocks contribute and
+     *      the ordering matches what decFrame consumes (INTER MCUs are skipped). ---- */
+    hvqm2_order_luma(s, cap, &nscl[0], &nfix[0]);
+    for (int by = 0; by < s->col_vblocks; by++)
+        for (int bx = 0; bx < s->col_hblocks; bx++)
+            hvqm2_append_block(s, 1, by * s->col_hblocks + bx, cap, &nscl[1], &nfix[1]);
+    for (int by = 0; by < s->col_vblocks; by++)
+        for (int bx = 0; bx < s->col_hblocks; bx++)
+            hvqm2_append_block(s, 2, by * s->col_hblocks + bx, cap, &nscl[2], &nfix[2]);
+    for (int pl = 0; pl < 3; pl++)
+        for (int i = 0; i < nscl[pl]; i++)
+            scfreq[s->oscl[pl][i]]++;
+
+    /* ---- cap-independent symbol frequencies (DC, MV), recomputed from the stored syms ---- */
+    for (int pl = 0; pl < 3; pl++)
+        for (int i = 0; i < ndc[pl]; i++)
+            dcfreq[s->dcsym[pl][i]]++;
+    for (int i = 0; i < nmv; i++)
+        mvfreq[s->mvsym[i]]++;
+
+    hvqm2_huff_init(&bn_h,    bnfreq);
+    hvqm2_huff_init(&run_h,   runfreq);
+    hvqm2_huff_init(&scale_h, scfreq);
+    hvqm2_huff_init(&dc_h,    dcfreq);
+    hvqm2_huff_init(&mv_h,    mvfreq);
+
+    memset(buf, 0, 60);                               /* HVQM2Frame(52) + HVQM2PredictFrame(8) */
+    pos = 60;
+
+    off_bn[0]  = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &bn_h,    1, s->bnval[0], nbnval[0]);
+    off_bn[1]  = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &bn_h,    0, s->bnval[1], nbnval[1]);
+    off_bnr[0] = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &run_h,   1, s->bnrun[0], nbnrun[0]);
+    off_bnr[1] = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &run_h,   0, s->bnrun[1], nbnrun[1]);
+
+    off_sc[0]  = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &scale_h, 1, s->oscl[0], nscl[0]);
+    off_sc[1]  = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &scale_h, 0, s->oscl[1], nscl[1]);
+    off_sc[2]  = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &scale_h, 0, s->oscl[2], nscl[2]);
+
+    off_fx[0]  = pos; pos = hvqm2_put_words(buf, pos, s->pktbuf_size, s->ofix[0], nfix[0]);
+    off_fx[1]  = pos; pos = hvqm2_put_words(buf, pos, s->pktbuf_size, s->ofix[1], nfix[1]);
+    off_fx[2]  = pos; pos = hvqm2_put_words(buf, pos, s->pktbuf_size, s->ofix[2], nfix[2]);
+
+    off_dc[0]  = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &dc_h,    1, s->dcsym[0], ndc[0]);
+    off_dc[1]  = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &dc_h,    0, s->dcsym[1], ndc[1]);
+    off_dc[2]  = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &dc_h,    0, s->dcsym[2], ndc[2]);
+
+    off_mv     = pos; pos = hvqm2_put_estream(buf, pos, s->pktbuf_size, &mv_h,    1, s->mvsym, nmv);
+    off_mb     = pos; pos = hvqm2_put_raw(buf, pos, s->pktbuf_size, s->mbbits, mbbytes);
+
+    /* HVQM2Frame offset table (big-endian, relative to body start). */
+    AV_WB32(buf +  0, off_bn[0]);  AV_WB32(buf +  4, off_bn[1]);
+    AV_WB32(buf +  8, off_bnr[0]); AV_WB32(buf + 12, off_bnr[1]);
+    AV_WB32(buf + 16, off_sc[0]);  AV_WB32(buf + 20, off_sc[1]);  AV_WB32(buf + 24, off_sc[2]);
+    AV_WB32(buf + 28, off_fx[0]);  AV_WB32(buf + 32, off_fx[1]);  AV_WB32(buf + 36, off_fx[2]);
+    AV_WB32(buf + 40, off_dc[0]);  AV_WB32(buf + 44, off_dc[1]);  AV_WB32(buf + 48, off_dc[2]);
+    /* HVQM2PredictFrame at +52: movevector_offset, macroblock_offset. */
+    AV_WB32(buf + 52, off_mv);  AV_WB32(buf + 56, off_mb);
+
+    return pos;
+}
+
+/* Assemble a P-frame body (INTER + INTRA-DC + INTRA-FULL). First a cap-independent analysis
+ * pass decides each MB's mode, runs AOT for INTRA-FULL blocks, builds the running-predictor
+ * DC/MV/macroblock streams and the INTER 8x8 RGBA copies (+ rbn/rdc for reconstruction).
+ * Then a cap loop emits the basisnum/scale/fixvl streams, dropping the least-important AOT
+ * bases until the record fits HVQM2_DATASIZE_MAX. Returns body size, or -1 if even cap 0
+ * overflows (caller then falls back to a keyframe).
+ *
+ * Mode pick: INTER if SAD <= threshold; else AOT-search the 4 luma blocks against the kept
+ * keyframe nest -- any basis found -> INTRA-FULL, else INTRA-DC. // deliberate: greedy,
+ * -quality-driven DC/FULL split (no RD compare of DC vs full); revisit for rate control. */
+static int hvqm2_assemble_pframe(HVQM2EncContext *s, const AVFrame *f)
+{
+    const uint8_t *cy = f->data[0];
+    const int cls = f->linesize[0];
+    const int cuw = 4, cuh = s->mcu411 ? 4 : 8;       /* chroma rect per MB (INTRA-DC) */
+    const int lh = s->lum_hblocks, ch = s->col_hblocks, fbw = s->width;
+    uint32_t *ref_cur = s->ref_rgba[s->buf_cur], *ref_prev = s->ref_rgba[s->buf_cur ^ 1];
+    int nmv = 0, ndc[3] = { 0, 0, 0 }, n_bad = 0;
+    int run_mvx = 0, run_mvy = 0, run_dc[3] = { 0, 0, 0 };
+    PutBitContext mbpb;
+    int mbbytes, cap, body_size;
+
+    /* Per-block source DC (per-4x4 luma + chroma) for INTRA-FULL; overwrites s->dc but not
+     * s->nest/atoms (kept from the last keyframe -- the reference the decoder still holds). */
+    hvqm2_compute_dc(s, f);
+    /* s->bn drives the scale/fixvl ordering and basisnum; default 0 so INTER + INTRA-DC
+     * blocks contribute nothing and stale keyframe basis counts can't leak in. */
+    memset(s->bn[0], 0, s->lum_total);
+    memset(s->bn[1], 0, s->col_total);
+    memset(s->bn[2], 0, s->col_total);
+
+    init_put_bits(&mbpb, s->mbbits, s->nmb);          /* <= 2 bits/MB <= nmb bytes */
+
+    for (int mby = 0; mby < s->mb_h; mby++)
+        for (int mbx = 0; mbx < s->mb_w; mbx++) {
+            int cx = mbx * 8, cyy = mby * 8, mvx, mvy, nb_lum = 0, mb = mby * s->mb_w + mbx;
+            int sad = hvqm2_me(s, cy, cls, cx, cyy, run_mvx, run_mvy, &mvx, &mvy);
+            if (sad > HVQM2_SCENE_MB_SAD)         /* scene metric: poorly-predicted MB */
+                n_bad++;
+            int l0 = (2 * mby) * lh + 2 * mbx, l1 = (2 * mby + 1) * lh + 2 * mbx;
+            int li[4] = { l0, l0 + 1, l1, l1 + 1 };
+            int c0 = s->mcu411 ? mby * ch + mbx : (2 * mby) * ch + mbx;
+            int c1 = (2 * mby + 1) * ch + mbx;        /* 4:2:2 only (second chroma row) */
+
+            if (sad <= s->sad_thresh) {               /* INTER: type bit 0 */
+                int dx = (mvx - run_mvx) & 0xFF, dy = (mvy - run_mvy) & 0xFF;
+                const uint32_t *sp = ref_prev + (cyy + mvy) * fbw + (cx + mvx);
+                uint32_t *dp = ref_cur + cyy * fbw + cx;
+                put_bits(&mbpb, 1, 0);
+                s->mvsym[nmv++] = dx; s->mvsym[nmv++] = dy;
+                run_mvx = mvx; run_mvy = mvy;
+                s->mb_mode[mb] = PF_INTER;
+                s->rbn[0][l0] = s->rbn[0][l0 + 1] = s->rbn[0][l1] = s->rbn[0][l1 + 1] = 0x80;
+                s->rbn[1][c0] = s->rbn[2][c0] = 0x80;
+                if (!s->mcu411) s->rbn[1][c1] = s->rbn[2][c1] = 0x80;
+                for (int i = 0; i < 8; i++, sp += fbw, dp += fbw)   /* exact RGBA copy */
+                    memcpy(dp, sp, 8 * sizeof(*dp));
+                continue;
+            }
+
+            /* Not INTER -> intra. AOT-search the 4 luma blocks against the kept nest; any
+             * basis found means codeable detail -> INTRA-FULL, else cheap INTRA-DC. */
+            if (s->aot)
+                for (int k = 0; k < 4; k++)
+                    nb_lum += (s->bn[0][li[k]] = hvqm2_search_plane_block(s, f, 0, li[k], lh));
+
+            if (nb_lum > 0) {                         /* INTRA-FULL: type bits 1,0 */
+                put_bits(&mbpb, 1, 1);
+                put_bits(&mbpb, 1, 0);
+                s->mb_mode[mb] = PF_INTRA_FULL;
+                for (int k = 0; k < 4; k++) {         /* 4 luma DC deltas, b0..b3 order */
+                    int vY = s->dc[0][li[k]], bY = (vY - run_dc[0]) & 0xFF;
+                    hvqm2_emit_dc_value(s->dcsym[0], &ndc[0], NULL, bY >= 128 ? bY - 256 : bY);
+                    run_dc[0] = vY;
+                    s->rdc[0][li[k]] = vY;
+                }
+                s->bn[1][c0] = hvqm2_search_plane_block(s, f, 1, c0, ch);
+                s->bn[2][c0] = hvqm2_search_plane_block(s, f, 2, c0, ch);
+                {                                     /* chroma c0 DC (U then V) */
+                    int vU = s->dc[1][c0], bU = (vU - run_dc[1]) & 0xFF;
+                    int vV = s->dc[2][c0], bV = (vV - run_dc[2]) & 0xFF;
+                    hvqm2_emit_dc_value(s->dcsym[1], &ndc[1], NULL, bU >= 128 ? bU - 256 : bU);
+                    hvqm2_emit_dc_value(s->dcsym[2], &ndc[2], NULL, bV >= 128 ? bV - 256 : bV);
+                    run_dc[1] = vU; run_dc[2] = vV;
+                    s->rdc[1][c0] = vU; s->rdc[2][c0] = vV;
+                }
+                if (!s->mcu411) {                     /* 4:2:2 second chroma row */
+                    int vU, bU, vV, bV;
+                    s->bn[1][c1] = hvqm2_search_plane_block(s, f, 1, c1, ch);
+                    s->bn[2][c1] = hvqm2_search_plane_block(s, f, 2, c1, ch);
+                    vU = s->dc[1][c1]; bU = (vU - run_dc[1]) & 0xFF;
+                    vV = s->dc[2][c1]; bV = (vV - run_dc[2]) & 0xFF;
+                    hvqm2_emit_dc_value(s->dcsym[1], &ndc[1], NULL, bU >= 128 ? bU - 256 : bU);
+                    hvqm2_emit_dc_value(s->dcsym[2], &ndc[2], NULL, bV >= 128 ? bV - 256 : bV);
+                    run_dc[1] = vU; run_dc[2] = vV;
+                    s->rdc[1][c1] = vU; s->rdc[2][c1] = vV;
+                }
+                /* rbn for these blocks is set per-cap in hvqm2_pframe_emit. */
+            } else {                                  /* INTRA-DC: type bits 1,1 */
+                int dcy = hvqm2_region_mean(cy, cls, cx, cyy, 8, 8);
+                int dcu = hvqm2_region_mean(f->data[1], f->linesize[1], mbx * 4, mby * cuh, cuw, cuh);
+                int dcv = hvqm2_region_mean(f->data[2], f->linesize[2], mbx * 4, mby * cuh, cuw, cuh);
+                int dc3[3] = { dcy, dcu, dcv };
+                put_bits(&mbpb, 1, 1);
+                put_bits(&mbpb, 1, 1);
+                s->mb_mode[mb] = PF_INTRA_DC;
+                for (int pl = 0; pl < 3; pl++) {
+                    int b = (dc3[pl] - run_dc[pl]) & 0xFF;
+                    hvqm2_emit_dc_value(s->dcsym[pl], &ndc[pl], NULL, b >= 128 ? b - 256 : b);
+                    run_dc[pl] = dc3[pl];
+                }
+                s->bn[0][l0] = s->bn[0][l0 + 1] = s->bn[0][l1] = s->bn[0][l1 + 1] = 0;
+                s->rbn[0][l0] = s->rbn[0][l0 + 1] = s->rbn[0][l1] = s->rbn[0][l1 + 1] = 0;
+                s->rdc[0][l0] = s->rdc[0][l0 + 1] = s->rdc[0][l1] = s->rdc[0][l1 + 1] = dcy;
+                s->rbn[1][c0] = 0; s->rdc[1][c0] = dcu;
+                s->rbn[2][c0] = 0; s->rdc[2][c0] = dcv;
+                if (!s->mcu411) {
+                    s->rbn[1][c1] = 0; s->rdc[1][c1] = dcu;
+                    s->rbn[2][c1] = 0; s->rdc[2][c1] = dcv;
+                }
+            }
+        }
+
+    flush_put_bits(&mbpb);
+    mbbytes = put_bytes_output(&mbpb);
+    s->pf_nbad = n_bad;                            /* hand the scene metric to the controller */
+
+    /* Cap loop: drop the least-important AOT bases until the record fits (cheap -- no AOT
+     * re-search; DC/MV/macroblock streams are cap-independent). */
+    for (cap = HVQM2_MAXB; ; cap--) {
+        body_size = hvqm2_pframe_emit(s, cap, nmv, ndc, mbbytes);
+        if (body_size <= HVQM2_DATASIZE_MAX || cap == 0)
+            break;
+    }
+    return body_size > HVQM2_DATASIZE_MAX ? -1 : body_size;
+}
+
+/* Reconstruct a P-frame's intra MCUs into the current reference. The INTER 8x8 copies and
+ * the rbn/rdc arrays were already produced by hvqm2_assemble_pframe; decFrame skips the
+ * INTER (0x80) MCUs (leaving the copies), fills INTRA-DC MCUs via WeightImBlock, and runs
+ * the AOT path for INTRA-FULL blocks (B3) -- consuming s->ofix/s->oscl in decLine order
+ * against the kept keyframe nest, exactly as the decoder does. */
+static void hvqm2_recon_pframe(HVQM2EncContext *s)
+{
+    HVQM2Recon r;
+    hvqm2_recon_init(s, &r, s->ref_rgba[s->buf_cur]);
+    for (int pl = 0; pl < 3; pl++) {
+        r.basis[pl] = s->rbn[pl];
+        r.dcbuf[pl] = s->rdc[pl];
+        r.fixp[pl]  = s->ofix[pl];        /* unused (no basis > 0), kept valid */
+        r.sclp[pl]  = s->oscl[pl];
+    }
+    hvqm2_dec_frame(&r);
+}
+
+#ifdef HVQM2_DUMP_RECON
+/* Debug: dump the reconstructed reference as a P6 RGB PPM, byte-identical in format to the
+ * oracle's output/video_*.ppm, so a round-trip diff proves bit-exact reconstruction. */
+static void hvqm2_dump_recon(HVQM2EncContext *s, char type)
+{
+    const char *dir = getenv("HVQM2_DUMP_RECON");
+    char path[512];
+    FILE *fp;
+    const uint32_t *fb = s->ref_rgba[s->buf_cur];
+    int n = s->width * s->height;
+    if (!dir) return;
+    snprintf(path, sizeof(path), "%s/recon_%d_%c.ppm", dir, s->frame_index, type);
+    fp = fopen(path, "wb");
+    if (!fp) return;
+    fprintf(fp, "P6\n%d %d\n255\n", s->width, s->height);
+    for (int i = 0; i < n; i++) {
+        const uint8_t *p = (const uint8_t *)&fb[i];
+        fwrite(p, 3, 1, fp);          /* r,g,b (drop alpha), matching the oracle dump */
+    }
+    fclose(fp);
+}
+#endif
+
+/* =========================== rate control ============================ */
+
+/* Scene-change keyframe decision (Hudson -a), run after a P-frame's motion estimation.
+ * s->scene in [0,100]: 0 => every frame is a key, 100 => never insert a scene key; in
+ * between, key when more than 'scene' percent of macroblocks are poorly predicted (the
+ * frame changed too much to inter-code well). The two extremes match the manual exactly;
+ * the in-between curve is a documented monotonic approximation (Hudson's is internal). */
+static int hvqm2_scene_cut(const HVQM2EncContext *s)
+{
+    if (s->scene <= 0)   return 1;
+    if (s->scene >= 100) return 0;
+    return 100 * s->pf_nbad > s->scene * s->nmb;   // deliberate: > so scene=100 path is unreachable here
+}
+
+/* HOLD test: is the current source luma close enough to the previous reconstructed luma
+ * (at zero motion) to just repeat that frame? Whole-frame mean-abs-diff vs HVQM2_HOLD_MAD_Q8,
+ * with early-out once the budget is blown. Only valid when no MB needs motion -- a HOLD is a
+ * pure copy of the previous displayed frame. */
+static int hvqm2_is_hold(const HVQM2EncContext *s, const AVFrame *f)
+{
+    const uint8_t *cur = f->data[0], *prev = s->me_ref;
+    const int W = s->width, H = s->height, cls = f->linesize[0];
+    const int64_t budget = (int64_t)HVQM2_HOLD_MAD_Q8 * W * H / 256;
+    int64_t sad = 0;
+    for (int y = 0; y < H; y++) {
+        const uint8_t *c = cur + (size_t)y * cls, *p = prev + (size_t)y * W;
+        for (int x = 0; x < W; x++)
+            sad += FFABS((int)c[x] - (int)p[x]);
+        if (sad > budget)
+            return 0;
+    }
+    return 1;
+}
+
+/* =========================== frame ============================ */
+
+static int hvqm2_encode_frame(AVCodecContext *avctx, AVPacket *pkt,
+                              const AVFrame *frame, int *got_packet)
+{
+    HVQM2EncContext *s = avctx->priv_data;
+    int body_size = -1, cap, ret, is_key, is_hold = 0;
+
+    if (!frame) {
+        *got_packet = 0;
+        return 0;
+    }
+
+    /* First frame and every gop_size-th frame are keyframes; the rest are P-frames. */
+    is_key = !s->have_prev ||
+             (s->gop_size > 0 && s->frame_index % s->gop_size == 0);
+
+    /* Closed loop: motion estimation references the previous *reconstructed* frame. */
+    s->me_ref = s->ref_y[s->buf_cur ^ 1];
+
+    if (!is_key && hvqm2_is_hold(s, frame)) {
+        is_hold = 1;                        /* static frame -> empty HOLD record */
+    } else if (!is_key) {
+        body_size = hvqm2_assemble_pframe(s, frame);
+        if (body_size < 0)                  /* P record over the cap -> force a keyframe */
+            is_key = 1;
+        else if (hvqm2_scene_cut(s))        /* -scene: too much changed -> keyframe */
+            is_key = 1;                      /* recon_keyframe fully overwrites the discarded P */
+    }
+
+    if (is_hold) {
+        /* HOLD: the decoder repeats the previous displayed frame. Copy its RGBA so
+         * extract_luma rederives the held luma and the next frame's ME references exactly
+         * what the decoder will show. body stays empty (0 bytes). */
+        memcpy(s->ref_rgba[s->buf_cur], s->ref_rgba[s->buf_cur ^ 1],
+               (size_t)s->width * s->height * sizeof(*s->ref_rgba[0]));
+        body_size = 0;
+    } else if (is_key) {
+        hvqm2_compute_dc(s, frame);
+        if (s->aot) {                       /* AOT analysis (only when the nest is valid) */
+            hvqm2_build_nest(s);
+            hvqm2_build_atoms(s);
+            hvqm2_aot_analyze(s, frame);
+        } else {
+            memset(s->bn[0], 0, s->lum_total);
+            memset(s->bn[1], 0, s->col_total);
+            memset(s->bn[2], 0, s->col_total);
+        }
+        hvqm2_dc_deltas(s);
+
+        /* Every record must fit HVQM2_DATASIZE_MAX. If a high-detail keyframe overflows,
+         * drop the least-important bases (uniform cap; matching pursuit stores bases in
+         * importance order) and re-assemble -- cheap, no AOT re-search. Fail loudly only
+         * if even DC-only (cap 0) won't fit. */
+        for (cap = HVQM2_MAXB; ; cap--) {
+            body_size = hvqm2_assemble_body(s, cap);
+            if (body_size <= HVQM2_DATASIZE_MAX || cap == 0)
+                break;
+        }
+        if (body_size > HVQM2_DATASIZE_MAX) {
+            av_log(avctx, AV_LOG_ERROR,
+                   "HVQM2 keyframe body is %d bytes (DC-only), over the %d-byte per-record "
+                   "limit. Reduce resolution.\n", body_size, HVQM2_DATASIZE_MAX);
+            return AVERROR(EINVAL);
+        }
+        hvqm2_recon_keyframe(s, cap);       /* reconstruct into ref_rgba[buf_cur] */
+    } else {
+        hvqm2_recon_pframe(s);              /* fill INTRA-DC MCUs (INTER already copied) */
+    }
+    hvqm2_extract_luma(s);                  /* ME luma plane for the next frame's search */
+
+    if ((ret = ff_get_encode_buffer(avctx, pkt, body_size, 0)) < 0)
+        return ret;
+    if (body_size)                          /* HOLD has an empty body */
+        memcpy(pkt->data, s->pktbuf, body_size);
+    if (is_key)
+        pkt->flags |= AV_PKT_FLAG_KEY;
+
+#ifdef HVQM2_DUMP_RECON
+    hvqm2_dump_recon(s, is_hold ? 'h' : is_key ? 'i' : 'p');
+#endif
+    /* The frame just reconstructed becomes the reference for the next frame. */
+    s->buf_cur  ^= 1;
+    s->have_prev = 1;
+    s->frame_index++;
+
+    *got_packet = 1;
+    return 0;
+}
+
+/* =========================== lifecycle ============================ */
+
+/* Fixed encoding profile, surfaced to the muxer (and any stream-copy remux) via 2-byte
+ * extradata so the container header stays in sync with the encoder. Must match the
+ * fallback in libavformat/hvqmenc.c. */
+#define HVQM2_Y_SHIFTNUM            8
+#define HVQM2_VIDEO_QUANTIZE_SHIFT  0
+
+static av_cold int hvqm2_encode_init(AVCodecContext *avctx)
+{
+    HVQM2EncContext *s = avctx->priv_data;
+    int lt, ct, maxb;
+
+    if ((avctx->width & 7) || (avctx->height & 7)) {
+        av_log(avctx, AV_LOG_ERROR,
+               "HVQM2 requires width and height to be multiples of 8 (got %dx%d).\n",
+               avctx->width, avctx->height);
+        return AVERROR(EINVAL);
+    }
+    if (avctx->width < 144 || avctx->height < 80) {
+        av_log(avctx, AV_LOG_ERROR,
+               "HVQM2 requires at least 144x80 (got %dx%d).\n",
+               avctx->width, avctx->height);
+        return AVERROR(EINVAL);
+    }
+    if (avctx->width > 640 || avctx->height > 480) {
+        av_log(avctx, AV_LOG_ERROR,
+               "HVQM2 supports at most 640x480 (got %dx%d).\n",
+               avctx->width, avctx->height);
+        return AVERROR(EINVAL);
+    }
+
+    s->mcu411      = avctx->pix_fmt == AV_PIX_FMT_YUV420P;   /* else yuv422p */
+    s->lum_hblocks = avctx->width  >> 2;
+    s->lum_vblocks = avctx->height >> 2;
+    s->lum_total   = s->lum_hblocks * s->lum_vblocks;
+    s->col_hblocks = avctx->width  >> 3;
+    s->col_vblocks = avctx->height >> (s->mcu411 ? 3 : 2);
+    s->col_total   = s->col_hblocks * s->col_vblocks;
+    lt = s->lum_total; ct = s->col_total;
+
+    /* AOT needs a full 70x38 nest window; smaller frames would hit the decoder's
+     * MakeNest mirror/empty bug, so they stay DC-only. */
+    s->aot = s->lum_hblocks >= HVQM2_NEST_W && s->lum_vblocks >= HVQM2_NEST_H;
+
+    s->dc[0] = av_malloc(lt);
+    s->dc[1] = av_malloc(ct);
+    s->dc[2] = av_malloc(ct);
+
+    s->nest       = av_malloc(HVQM2_NEST_W * HVQM2_NEST_H);
+    s->atom_tmp   = av_malloc(HVQM2_NATOMS * 16 * sizeof(*s->atom_tmp));
+    s->atom_norm2 = av_malloc(HVQM2_NATOMS * sizeof(*s->atom_norm2));
+    s->atom_inv   = av_malloc(HVQM2_NATOMS * sizeof(*s->atom_inv));
+    s->atom_div   = av_malloc(HVQM2_NATOMS * sizeof(*s->atom_div));
+    s->atom_px    = av_malloc(HVQM2_NATOMS);
+    s->atom_py    = av_malloc(HVQM2_NATOMS);
+    s->atom_xs    = av_malloc(HVQM2_NATOMS);
+    s->atom_ys    = av_malloc(HVQM2_NATOMS);
+
+    s->bn[0] = av_malloc(lt); s->bn[1] = av_malloc(ct); s->bn[2] = av_malloc(ct);
+    for (int pl = 0; pl < 3; pl++) {
+        int nblk = pl ? ct : lt;
+        s->fixw[pl] = av_malloc(nblk * HVQM2_MAXB * sizeof(*s->fixw[pl]));
+        s->scl[pl]  = av_malloc(nblk * HVQM2_MAXB);
+        s->oscl[pl] = av_malloc(nblk * HVQM2_MAXB);
+        s->ofix[pl] = av_malloc(nblk * HVQM2_MAXB * sizeof(*s->ofix[pl]));
+        s->dcd[pl]   = av_malloc(nblk * sizeof(*s->dcd[pl]));
+        s->dcsym[pl] = av_malloc(2 * nblk);
+        s->dcrun[pl] = av_malloc(nblk);
+    }
+    s->bnval[0] = av_malloc(lt); s->bnrun[0] = av_malloc(lt);
+    s->bnval[1] = av_malloc(ct); s->bnrun[1] = av_malloc(ct);
+
+    /* ---- inter (P) frame state ---- */
+    s->width  = avctx->width;
+    s->height = avctx->height;
+    s->mb_w   = avctx->width  >> 3;
+    s->mb_h   = avctx->height >> 3;
+    s->nmb    = s->mb_w * s->mb_h;
+    /* Keyframe interval = -g (Hudson -k); codec default 30 via hvqm2_defaults[]. -g <= 0
+     * means no periodic keyframes (infinite GOP -> scene cuts only). me_range/scene come
+     * straight from the private options. */
+    s->gop_size = avctx->gop_size;
+    /* 8x8 SAD threshold for choosing INTER; scales with -quality (~per-pixel error). */
+    s->sad_thresh = av_clip(s->quality, 64, 64 * 64);
+    s->frame_index = 0;
+    s->have_prev   = 0;
+    s->mvsym   = av_malloc(2 * s->nmb);
+    s->mbbits  = av_malloc(s->nmb);
+    s->mb_mode = av_malloc(s->nmb);
+    s->pf_bnl  = av_malloc(lt);                 /* <= 4 luma basisnum / MB == lum_total */
+    s->pf_bnc  = av_malloc(ct);                 /* <= 1 (4:1:1) / 2 (4:2:2) per MB == col_total */
+    if (!s->mvsym || !s->mbbits || !s->mb_mode || !s->pf_bnl || !s->pf_bnc)
+        return AVERROR(ENOMEM);
+
+    /* ---- closed-loop reconstruction (Phase B2b) ---- */
+    s->buf_cur = 0;
+    s->divT[0] = 0;
+    for (int i = 1; i < 0x200; i++)
+        s->divT[i] = 4096 / i;
+    for (int i = 0; i < 2; i++) {
+        s->ref_rgba[i] = av_malloc((size_t)s->width * s->height * sizeof(*s->ref_rgba[i]));
+        s->ref_y[i]    = av_mallocz((size_t)s->width * s->height);   /* z: clean ME ref */
+        if (!s->ref_rgba[i] || !s->ref_y[i])
+            return AVERROR(ENOMEM);
+    }
+    s->rbn[0] = av_malloc(lt); s->rbn[1] = av_malloc(ct); s->rbn[2] = av_malloc(ct);
+    s->rdc[0] = av_malloc(lt); s->rdc[1] = av_malloc(ct); s->rdc[2] = av_malloc(ct);
+    for (int pl = 0; pl < 3; pl++)
+        if (!s->rbn[pl] || !s->rdc[pl])
+            return AVERROR(ENOMEM);
+
+    /* body = 68B headers + 16 framed streams; bound payloads generously. */
+    maxb = HVQM2_MAXB;
+    s->pktbuf_size = 8192 + 80 * (lt + 2 * ct) + 4 * (lt + 2 * ct) * maxb;
+    s->pktbuf = av_malloc(s->pktbuf_size);
+
+    if (!s->dc[0] || !s->dc[1] || !s->dc[2] || !s->nest || !s->atom_tmp ||
+        !s->atom_norm2 || !s->atom_inv || !s->atom_div || !s->atom_px || !s->atom_py ||
+        !s->atom_xs || !s->atom_ys || !s->bn[0] || !s->bn[1] || !s->bn[2] ||
+        !s->bnval[0] || !s->bnrun[0] || !s->bnval[1] || !s->bnrun[1] || !s->pktbuf)
+        return AVERROR(ENOMEM);
+    for (int pl = 0; pl < 3; pl++)
+        if (!s->fixw[pl] || !s->scl[pl] || !s->oscl[pl] || !s->ofix[pl] ||
+            !s->dcd[pl] || !s->dcsym[pl] || !s->dcrun[pl])
+            return AVERROR(ENOMEM);
+
+    /* Surface the fixed profile (y_shiftnum, video_quantize_shift) to the muxer so the
+     * container header — and any later stream-copy remux — matches what we encoded. */
+    avctx->extradata = av_mallocz(2 + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!avctx->extradata)
+        return AVERROR(ENOMEM);
+    avctx->extradata[0]   = HVQM2_Y_SHIFTNUM;
+    avctx->extradata[1]   = HVQM2_VIDEO_QUANTIZE_SHIFT;
+    avctx->extradata_size = 2;
+
+    avctx->bits_per_coded_sample = 12;
+    avctx->bit_rate              = ff_guess_coded_bitrate(avctx);
+    return 0;
+}
+
+static av_cold int hvqm2_encode_close(AVCodecContext *avctx)
+{
+    HVQM2EncContext *s = avctx->priv_data;
+    for (int i = 0; i < 3; i++) {
+        av_freep(&s->dc[i]);
+        av_freep(&s->bn[i]);
+        av_freep(&s->fixw[i]);
+        av_freep(&s->scl[i]);
+        av_freep(&s->oscl[i]);
+        av_freep(&s->ofix[i]);
+        av_freep(&s->dcd[i]);
+        av_freep(&s->dcsym[i]);
+        av_freep(&s->dcrun[i]);
+    }
+    for (int i = 0; i < 2; i++) {
+        av_freep(&s->bnval[i]);
+        av_freep(&s->bnrun[i]);
+        av_freep(&s->ref_rgba[i]);
+        av_freep(&s->ref_y[i]);
+    }
+    for (int i = 0; i < 3; i++) {
+        av_freep(&s->rbn[i]);
+        av_freep(&s->rdc[i]);
+    }
+    av_freep(&s->nest);
+    av_freep(&s->atom_tmp);
+    av_freep(&s->atom_norm2);
+    av_freep(&s->atom_inv);
+    av_freep(&s->atom_div);
+    av_freep(&s->atom_px);
+    av_freep(&s->atom_py);
+    av_freep(&s->atom_xs);
+    av_freep(&s->atom_ys);
+    av_freep(&s->pktbuf);
+    av_freep(&s->mvsym);
+    av_freep(&s->mbbits);
+    av_freep(&s->mb_mode);
+    av_freep(&s->pf_bnl);
+    av_freep(&s->pf_bnc);
+    return 0;
+}
+
+#define OFFSET(x) offsetof(HVQM2EncContext, x)
+#define VE (AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_ENCODING_PARAM)
+/* Rate control mirrors Hudson's hvqm2enc knobs:
+ *   -q  -> quality (matching-pursuit threshold Z)   |  -k -> -g (keyframe interval)
+ *   -r  -> me_range (motion search range)           |  -a -> scene (scene-change keys) */
+static const AVOption hvqm2_options[] = {
+    { "quality", "compression quality / matching-pursuit threshold; higher = fewer AOT bases, "
+      "more compression (Hudson -q)",
+      OFFSET(quality), AV_OPT_TYPE_INT, { .i64 = 400 }, 0, INT_MAX, VE },
+    { "me_range", "motion search range in pixels for P-frames; 0 = no motion (Hudson -r)",
+      OFFSET(me_range), AV_OPT_TYPE_INT, { .i64 = 32 }, 0, 63, VE },
+    { "scene", "scene-change keyframe sensitivity: 0 = every frame is a key, 100 = never "
+      "insert one (Hudson -a)",
+      OFFSET(scene), AV_OPT_TYPE_INT, { .i64 = 80 }, 0, 100, VE },
+    { NULL },
+};
+
+static const AVClass hvqm2_class = {
+    .class_name = "hvqm2 encoder",
+    .item_name  = av_default_item_name,
+    .option     = hvqm2_options,
+    .version    = LIBAVUTIL_VERSION_INT,
+};
+
+/* Codec-specific default for the generic GOP option: Hudson's -k default is 30
+ * (FFmpeg's generic -g default is 12). User -g still overrides. */
+static const FFCodecDefault hvqm2_defaults[] = {
+    { "g", "30" },
+    { NULL },
+};
+
+const FFCodec ff_hvqm2_encoder = {
+    .p.name         = "hvqm2",
+    CODEC_LONG_NAME("Hudson HVQM2 VQ video"),
+    .p.type         = AVMEDIA_TYPE_VIDEO,
+    .p.id           = AV_CODEC_ID_HVQM2,
+    .p.capabilities = AV_CODEC_CAP_DR1,
+    .p.priv_class   = &hvqm2_class,
+    .priv_data_size = sizeof(HVQM2EncContext),
+    .init           = hvqm2_encode_init,
+    FF_CODEC_ENCODE_CB(hvqm2_encode_frame),
+    .close          = hvqm2_encode_close,
+    .defaults       = hvqm2_defaults,
+    CODEC_PIXFMTS(AV_PIX_FMT_YUV420P, AV_PIX_FMT_YUV422P),
+    .caps_internal  = FF_CODEC_CAP_INIT_CLEANUP,
+};
