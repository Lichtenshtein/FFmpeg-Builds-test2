index 0000000..2a36540
--- /dev/null
+++ b/libavcodec/hvqm2dec.c
@@ -0,0 +1,973 @@
+/*
+ * Hudson HVQM2 (Hybrid Vector Quantization) video decoder
+ *
+ * Copyright (c) 2026 FFmpeg HVQM2 port
+ * Derived from Tilka's reference HVQM2 decoder (MIT licensed); the VQ/AOT
+ * reconstruction math is reproduced bit-for-bit so output matches that decoder.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * Hudson HVQM2 1.0 (N64) video decoder.
+ *
+ * Decodes the VQ frames of the .hvqm container (key / predict / hold) to RGBA.
+ * The codec's display stage is YUV->RGBA (yuv2rgba), so RGBA is the native
+ * decoded output; the intermediate YUV is never exposed. The demuxer
+ * (libavformat/hvqmdec.c) feeds one record body per packet and signals the
+ * frame type via AV_PKT_FLAG_KEY (keyframe), pkt->size == 0 (hold), else predict.
+ *
+ * Profile (y_shiftnum, video_quantize_shift) arrives as 2-byte extradata; the
+ * 60-byte file header is parsed by the demuxer, not here.
+ */
+
+#include "libavutil/intreadwrite.h"
+#include "libavutil/mem.h"
+#include "avcodec.h"
+#include "codec_internal.h"
+#include "decode.h"
+
+#define HVQM2_KEYFRAME 0
+#define HVQM2_PREDICT  1
+#define HVQM2_HOLD     2
+/* A keyframe/predict body begins with the 52-byte HVQM2Frame offset table, so any
+ * video packet smaller than that is a HOLD marker (the demuxer emits 1 byte). */
+#define HVQM2_FRAME_MIN 52
+
+#define HVQM2_NEST_L   70
+#define HVQM2_NEST_S   38
+#define HVQM2_NESTSIZE (HVQM2_NEST_L * HVQM2_NEST_S)   /* 2660 */
+
+typedef struct HVQM2Tree {
+    int16_t  root;
+    uint16_t array[2][0x200];
+} HVQM2Tree;
+
+/* Bit reader: reads 32 big-endian bits at a time, MSB first (matches the
+ * reference decoder). Reads past `end` yield zero bits. */
+typedef struct HVQM2BitBuf {
+    uint32_t       bit;
+    uint32_t       value;
+    const uint8_t *pos;
+    const uint8_t *end;
+} HVQM2BitBuf;
+
+/* Per-plane "weight code" walk state (basis/DC of the block grid). */
+typedef struct RWcode {
+    uint8_t *basis_prev_line, *dcbuf_prev_line;
+    uint8_t *basis_curr_line, *dcbuf_curr_line;
+    uint8_t *basis_next_line, *dcbuf_next_line;
+    uint8_t  basis_next, dcbuf_next, basis_curr, dcbuf_curr, dcbuf_prev;
+} RWcode;
+
+typedef struct HVQM2DecContext {
+    int im_width, im_height, fb_width;
+    int mcu411;                       /* 1 = 4:1:1 (yuv420p), 0 = 4:2:2 (yuv422p) */
+    int mcu_h_pix, mcu_v_pix, next_macroblk_line;
+    int lum_hblocks, lum_vblocks, lum_total;
+    int col_hblocks, col_vblocks, col_total;
+    int nest_w, nest_h;
+    uint8_t  yshift, video_quantize_shift, pix_alpha;
+    int16_t  dc_min, dc_max;
+    uint32_t divT[0x200];
+
+    HVQM2BitBuf macroblock_buf, movevector_buf;
+    HVQM2BitBuf basisnum_buf[2], basisnumrun_buf[2];
+    HVQM2BitBuf scale_buf[3], dcval_buf[3], dcrun_buf[3];
+    const uint8_t *fixvl[3];
+    const uint8_t *body_end;
+
+    HVQM2Tree dcval_tree, basisnum_tree, basisnumrun_tree, scale_tree, movevector_tree;
+    uint16_t  huff_nodeno;
+
+    uint8_t  *workbuf;                /* 2*lum_total + 4*col_total */
+    uint8_t  *basis[3], *dcbuf[3];
+    uint8_t   nest[HVQM2_NESTSIZE];
+
+    RWcode    u_wcode, v_wcode, y0wcode, y1wcode;
+    uint16_t  pix_y[4][16], pix_u[16], pix_v[16];
+
+    uint32_t *fb[2];                  /* RGBA framebuffers, fb_width*height */
+    int       fb_idx;
+    int       have_prev;
+} HVQM2DecContext;
+
+/* ---- bit / huffman primitives (reference: getBit/getByte/readHuffTree/...) ---- */
+
+static unsigned hvqm2_get_bit(HVQM2BitBuf *b)
+{
+    unsigned bit = b->bit;
+    if (bit == 0) {
+        if (b->pos && b->pos + 4 <= b->end) {
+            b->value = AV_RB32(b->pos);
+            b->pos  += 4;
+        } else {
+            b->value = 0;
+        }
+        bit = 0x80000000u;
+    }
+    b->bit = bit >> 1;
+    return (b->value & bit) ? 1 : 0;
+}
+
+static unsigned hvqm2_get_byte(HVQM2BitBuf *b)
+{
+    unsigned result = 0;
+    for (int i = 7; i >= 0; --i)
+        result |= hvqm2_get_bit(b) << i;
+    return result;
+}
+
+static int16_t hvqm2_read_huff_tree(HVQM2DecContext *s, HVQM2BitBuf *src, HVQM2Tree *dst)
+{
+    if (hvqm2_get_bit(src) == 0)
+        return hvqm2_get_byte(src);                  /* leaf */
+    /* internal node; cap node count to the array bound to stay in-buffer */
+    if (s->huff_nodeno >= 0x200)
+        return 0;
+    int16_t pos = s->huff_nodeno++;
+    dst->array[0][pos] = hvqm2_read_huff_tree(s, src, dst);
+    dst->array[1][pos] = hvqm2_read_huff_tree(s, src, dst);
+    return pos;
+}
+
+static void hvqm2_set_code(HVQM2DecContext *s, HVQM2BitBuf *b, const uint8_t *p)
+{
+    uint32_t size = (p && p + 4 <= s->body_end) ? AV_RB32(p) : 0;
+    b->pos = size ? p + 4 : NULL;
+    b->bit = 0;
+    b->end = s->body_end;
+}
+
+static void hvqm2_read_tree(HVQM2DecContext *s, HVQM2BitBuf *b, HVQM2Tree *tree)
+{
+    s->huff_nodeno = 0x100;
+    if (b->pos)
+        tree->root = hvqm2_read_huff_tree(s, b, tree);
+}
+
+static int16_t hvqm2_decode_huff(HVQM2BitBuf *b, HVQM2Tree *tree)
+{
+    int16_t pos = tree->root;
+    while (pos >= 0x100)
+        pos = tree->array[hvqm2_get_bit(b)][pos];
+    return pos;
+}
+
+static int16_t hvqm2_decode_huff2(HVQM2BitBuf *b, HVQM2Tree *tree)
+{
+    int16_t pos = hvqm2_decode_huff(b, tree);
+    return tree->array[0][pos];
+}
+
+static int16_t hvqm2_decode_dc(HVQM2DecContext *s, HVQM2BitBuf *b)
+{
+    int16_t value = hvqm2_decode_huff2(b, &s->dcval_tree);
+    int16_t sum = value;
+    if (value == s->dc_min || value == s->dc_max) {
+        /* Bound the escape chain: on an exhausted/hostile stream decode_huff2 can
+         * keep returning a sentinel forever. Valid chains are a handful of symbols;
+         * 4096 is far beyond that and stops the hang. */
+        int guard = 4096;
+        do {
+            value = hvqm2_decode_huff2(b, &s->dcval_tree);
+            sum  += value;
+        } while ((value <= s->dc_min || value >= s->dc_max) && --guard > 0);
+    }
+    return sum;
+}
+
+static uint8_t hvqm2_get_delta_bn(HVQM2DecContext *s, uint8_t *rle,
+                                  HVQM2BitBuf *val_buf, HVQM2BitBuf *rle_buf)
+{
+    if (*rle) {
+        --*rle;
+        return 0;
+    }
+    uint8_t value = hvqm2_decode_huff(val_buf, &s->basisnum_tree);
+    if (value == 0)
+        *rle = hvqm2_decode_huff(rle_buf, &s->basisnumrun_tree);
+    return value;
+}
+
+/* ---- block reconstruction (reference: WeightImBlock / decBlockCPU) ---- */
+
+static void hvqm2_weight_block(uint16_t *pix, uint8_t curr, uint8_t top,
+                               uint8_t bottom, uint8_t left, uint8_t right)
+{
+    uint32_t tmb = top - bottom;
+    uint32_t lmr = left - right;
+    uint32_t vph = tmb + lmr;
+    uint32_t vmh = tmb - lmr;
+    uint32_t c2  = curr * 2;
+    uint32_t c8  = (curr * 8) + 4;
+
+    uint32_t tpl = top + left  - c2;
+    uint32_t tpr = top + right - c2;
+    uint32_t bpr = bottom + right - c2;
+    uint32_t bpl = bottom + left  - c2;
+
+    uint32_t tml = top - left;
+    uint32_t tmr = top - right;
+    uint32_t bmr = bottom - right;
+    uint32_t bml = bottom - left;
+
+    pix[0]  = (c8 + vph + tpl) / 8;
+    pix[1]  = (c8 + vph + tml) / 8;
+    pix[2]  = (c8 + vmh + tmr) / 8;
+    pix[3]  = (c8 + vmh + tpr) / 8;
+    pix[4]  = (c8 + vph - tml) / 8;
+    pix[5]  = (c8 - bpr)       / 8;
+    pix[6]  = (c8 - bpl)       / 8;
+    pix[7]  = (c8 + vmh - tmr) / 8;
+    pix[8]  = (c8 - vmh - bml) / 8;
+    pix[9]  = (c8 - tpr)       / 8;
+    pix[10] = (c8 - tpl)       / 8;
+    pix[11] = (c8 - vph - bmr) / 8;
+    pix[12] = (c8 - vmh + bpl) / 8;
+    pix[13] = (c8 - vmh + bml) / 8;
+    pix[14] = (c8 - vph + bmr) / 8;
+    pix[15] = (c8 - vph + bpr) / 8;
+}
+
+static unsigned hvqm2_fixvl16(HVQM2DecContext *s, int plane)
+{
+    const uint8_t *p = s->fixvl[plane];
+    unsigned v = (p + 2 <= s->body_end) ? AV_RB16(p) : 0;
+    s->fixvl[plane] = p + 2;
+    return v;
+}
+
+static void hvqm2_dec_block(HVQM2DecContext *s, uint16_t *pix, RWcode *w, int plane)
+{
+    if (w->basis_curr == 0) {
+        uint8_t curr   =  w->dcbuf_curr;
+        uint8_t right  =  w->basis_next      == 0 ?  w->dcbuf_next      : curr;
+        uint8_t top    = *w->basis_prev_line == 0 ? *w->dcbuf_prev_line : curr;
+        uint8_t bottom = *w->basis_next_line == 0 ? *w->dcbuf_next_line : curr;
+        uint8_t left   =  w->dcbuf_prev;
+        hvqm2_weight_block(pix, curr, top, bottom, left, right);
+        w->dcbuf_prev = w->dcbuf_curr;
+    } else if (w->basis_curr == 8) {
+        const uint8_t *src = s->fixvl[plane];
+        for (int i = 0; i < 16; ++i)
+            pix[i] = (src + i < s->body_end) ? src[i] : 0;
+        s->fixvl[plane] += 16;
+        w->dcbuf_prev = w->dcbuf_next;
+    } else {
+        for (int i = 0; i < 16; ++i)
+            pix[i] = w->dcbuf_curr;
+        for (int i = 0; i < w->basis_curr; ++i) {
+            unsigned bits = hvqm2_fixvl16(s, plane);
+            unsigned x_stride = ((bits >> 0) & 1) + 1;
+            unsigned y_stride = ((bits >> 1) & 1) + 1;
+            unsigned nest_pos_x, nest_pos_y;
+            if (s->yshift == 8) {                    /* landscape nest */
+                nest_pos_y = (bits >> 8) & 0x1F;
+                nest_pos_x = (bits >> 2) & 0x3F;
+            } else {                                 /* portrait nest */
+                nest_pos_y = (bits >> 7) & 0x3F;
+                nest_pos_x = (bits >> 2) & 0x1F;
+            }
+            int16_t tmp[4][4];
+            const uint8_t *nest = s->nest + nest_pos_y * s->nest_w + nest_pos_x;
+            int32_t sum = 0;
+            for (int y = 0; y < 4; ++y)
+                for (int x = 0; x < 4; ++x) {
+                    uint8_t nv = nest[y * y_stride * s->nest_w + x * x_stride];
+                    tmp[y][x] = nv;
+                    sum += nv;
+                }
+            int32_t mean = (sum + 8) >> 4;
+            int16_t max = -1;
+            for (int y = 0; y < 4; ++y)
+                for (int x = 0; x < 4; ++x) {
+                    tmp[y][x] -= mean;
+                    int16_t v = tmp[y][x] < 0 ? -tmp[y][x] : tmp[y][x];
+                    if (max < v)
+                        max = v;
+                }
+            if (max < 0)                             /* flat patch contributes 0 either way */
+                max = 0;
+            int32_t beta_q = (bits >> 13) & 7;
+            int32_t scale  = hvqm2_decode_huff2(&s->scale_buf[plane], &s->scale_tree);
+            int32_t div    = s->divT[max];
+            int32_t bar    = (beta_q + scale) * div;
+            for (int y = 0; y < 4; ++y)
+                for (int x = 0; x < 4; ++x)
+                    pix[y * 4 + x] += (tmp[y][x] * bar + 512) >> 10;
+        }
+        w->dcbuf_prev = w->dcbuf_next;
+    }
+    w->basis_prev_line++;
+    w->dcbuf_prev_line++;
+    w->basis_next_line++;
+    w->dcbuf_next_line++;
+}
+
+/* ---- colour conversion (reference: yuv2rgba / ColorConv411|422) ---- */
+
+static uint32_t hvqm2_yuv2rgba(int16_t y, int16_t u, int16_t v, uint8_t a)
+{
+    u -= 128;
+    v -= 128;
+    int32_t y6  = y << 6;
+    int16_t r16 = 0x4020 + v * 90;
+    int16_t g16 = 0x4020 - v * 46 - u * 22;
+    int16_t b16 = 0x4020 + u * 113;
+    int32_t rr  = (y6 + r16) >> 6;
+    int32_t gg  = (y6 + g16) >> 6;
+    int32_t bb  = (y6 + b16) >> 6;
+    rr -= 0x100; gg -= 0x100; bb -= 0x100;
+    uint8_t r = rr < 0 ? 0 : rr > 0xff ? 0xff : rr;
+    uint8_t g = gg < 0 ? 0 : gg > 0xff ? 0xff : gg;
+    uint8_t b = bb < 0 ? 0 : bb > 0xff ? 0xff : bb;
+    return (uint32_t)a << 24 | (uint32_t)b << 16 | (uint32_t)g << 8 | r;
+}
+
+static void hvqm2_color_conv_422(HVQM2DecContext *s, uint32_t *outbuf,
+                                 const uint16_t *py, const uint16_t *pu, const uint16_t *pv)
+{
+    const uint16_t *y0 = py, *y1 = py + 16;
+    uint8_t a = s->pix_alpha;
+    for (int i = 0; i < 4; ++i) {
+        uint32_t *out = outbuf;
+        for (int j = 0; j < 2; ++j) {
+            *out++ = hvqm2_yuv2rgba(*y0++, *pu,   *pv,   a);
+            *out++ = hvqm2_yuv2rgba(*y0++, *pu++, *pv++, a);
+        }
+        for (int j = 0; j < 2; ++j) {
+            *out++ = hvqm2_yuv2rgba(*y1++, *pu,   *pv,   a);
+            *out++ = hvqm2_yuv2rgba(*y1++, *pu++, *pv++, a);
+        }
+        outbuf += s->fb_width;
+    }
+}
+
+static void hvqm2_color_conv_411(HVQM2DecContext *s, uint32_t *outbuf,
+                                 const uint16_t *py, const uint16_t *pu, const uint16_t *pv)
+{
+    const uint16_t *y0 = py, *y1 = py + 16;
+    uint8_t a = s->pix_alpha;
+    for (int k = 0; k < 2; ++k) {
+        for (int i = 0; i < 2; ++i) {
+            for (int n = 0; n < 2; ++n) {
+                uint32_t *out = outbuf;
+                const uint16_t *u = pu, *v = pv;
+                for (int j = 0; j < 2; ++j) {
+                    *out++ = hvqm2_yuv2rgba(*y0++, *u,   *v,   a);
+                    *out++ = hvqm2_yuv2rgba(*y0++, *u++, *v++, a);
+                }
+                for (int j = 0; j < 2; ++j) {
+                    *out++ = hvqm2_yuv2rgba(*y1++, *u,   *v,   a);
+                    *out++ = hvqm2_yuv2rgba(*y1++, *u++, *v++, a);
+                }
+                outbuf += s->fb_width;
+            }
+            pu += 4;
+            pv += 4;
+        }
+        y0 += 16;
+        y1 += 16;
+    }
+}
+
+static void hvqm2_color_conv(HVQM2DecContext *s, uint32_t *outbuf,
+                             const uint16_t *py, const uint16_t *pu, const uint16_t *pv)
+{
+    if (s->mcu411)
+        hvqm2_color_conv_411(s, outbuf, py, pu, pv);
+    else
+        hvqm2_color_conv_422(s, outbuf, py, pu, pv);
+}
+
+/* ---- per-line / per-frame walk (reference: advance_wcode/update_wcode/decLine/decFrame) ---- */
+
+static void hvqm2_advance_wcode(RWcode *w, int amount)
+{
+    w->basis_prev_line += amount; w->dcbuf_prev_line += amount;
+    w->basis_curr_line += amount; w->dcbuf_curr_line += amount;
+    w->basis_next_line += amount; w->dcbuf_next_line += amount;
+}
+
+static void hvqm2_update_wcode(RWcode *w)
+{
+    w->basis_curr = w->basis_next;
+    w->dcbuf_curr = w->dcbuf_next;
+    w->basis_curr_line++;
+    w->dcbuf_curr_line++;
+    w->basis_next = *w->basis_curr_line;
+    w->dcbuf_next = *w->dcbuf_curr_line;
+}
+
+static void hvqm2_dec_line(HVQM2DecContext *s, uint32_t *outbuf)
+{
+    RWcode *y0 = &s->y0wcode, *y1 = &s->y1wcode, *u = &s->u_wcode, *v = &s->v_wcode;
+
+    u->basis_next = *u->basis_curr_line; u->dcbuf_prev = *u->dcbuf_curr_line; u->dcbuf_next = *u->dcbuf_curr_line;
+    v->basis_next = *v->basis_curr_line; v->dcbuf_prev = *v->dcbuf_curr_line; v->dcbuf_next = *v->dcbuf_curr_line;
+    y0->basis_next = *y0->basis_curr_line; y0->dcbuf_prev = *y0->dcbuf_curr_line; y0->dcbuf_next = *y0->dcbuf_curr_line;
+    if (s->mcu411) {
+        y1->basis_next = *y1->basis_curr_line; y1->dcbuf_prev = *y1->dcbuf_curr_line; y1->dcbuf_next = *y1->dcbuf_curr_line;
+    }
+
+    for (int i = 0; i < s->col_hblocks - 1; ++i) {
+        if (y0->basis_next == 0x80) {
+            hvqm2_advance_wcode(y0, 2);
+            y0->basis_next = *y0->basis_curr_line; y0->dcbuf_prev = *y0->dcbuf_curr_line; y0->dcbuf_next = *y0->dcbuf_curr_line;
+            if (s->mcu411) {
+                hvqm2_advance_wcode(y1, 2);
+                y1->basis_next = *y1->basis_curr_line; y1->dcbuf_prev = *y1->dcbuf_curr_line; y1->dcbuf_next = *y1->dcbuf_curr_line;
+            }
+            hvqm2_advance_wcode(u, 1);
+            u->basis_next = *u->basis_curr_line; u->dcbuf_prev = *u->dcbuf_curr_line; u->dcbuf_next = *u->dcbuf_curr_line;
+            hvqm2_advance_wcode(v, 1);
+            v->basis_next = *v->basis_curr_line; v->dcbuf_prev = *v->dcbuf_curr_line; v->dcbuf_next = *v->dcbuf_curr_line;
+        } else {
+            hvqm2_update_wcode(y0); hvqm2_dec_block(s, s->pix_y[0], y0, 0);
+            hvqm2_update_wcode(y0); hvqm2_dec_block(s, s->pix_y[1], y0, 0);
+            if (s->mcu411) {
+                hvqm2_update_wcode(y1); hvqm2_dec_block(s, s->pix_y[2], y1, 0);
+                hvqm2_update_wcode(y1); hvqm2_dec_block(s, s->pix_y[3], y1, 0);
+            }
+            hvqm2_update_wcode(u); hvqm2_dec_block(s, s->pix_u, u, 1);
+            hvqm2_update_wcode(v); hvqm2_dec_block(s, s->pix_v, v, 2);
+            hvqm2_color_conv(s, outbuf, s->pix_y[0], s->pix_u, s->pix_v);
+        }
+        outbuf += s->mcu_h_pix;
+    }
+
+    /* last column: next == curr */
+    if (y0->basis_next == 0x80) {
+        hvqm2_advance_wcode(y0, 2);
+        if (s->mcu411) hvqm2_advance_wcode(y1, 2);
+        hvqm2_advance_wcode(u, 1);
+        hvqm2_advance_wcode(v, 1);
+    } else {
+        hvqm2_update_wcode(y0); hvqm2_dec_block(s, s->pix_y[0], y0, 0);
+        y0->basis_curr = y0->basis_next; y0->dcbuf_curr = y0->dcbuf_next;
+        y0->basis_curr_line++; y0->dcbuf_curr_line++;
+        hvqm2_dec_block(s, s->pix_y[1], y0, 0);
+        if (s->mcu411) {
+            hvqm2_update_wcode(y1); hvqm2_dec_block(s, s->pix_y[2], y1, 0);
+            y1->basis_curr = y1->basis_next; y1->dcbuf_curr = y1->dcbuf_next;
+            y1->basis_curr_line++; y1->dcbuf_curr_line++;
+            hvqm2_dec_block(s, s->pix_y[3], y1, 0);
+        }
+        u->basis_curr = u->basis_next; u->dcbuf_curr = u->dcbuf_next;
+        u->basis_curr_line++; u->dcbuf_curr_line++;
+        hvqm2_dec_block(s, s->pix_u, u, 1);
+        v->basis_curr = v->basis_next; v->dcbuf_curr = v->dcbuf_next;
+        v->basis_curr_line++; v->dcbuf_curr_line++;
+        hvqm2_dec_block(s, s->pix_v, v, 2);
+        hvqm2_color_conv(s, outbuf, s->pix_y[0], s->pix_u, s->pix_v);
+    }
+}
+
+static void hvqm2_dec_frame(HVQM2DecContext *s, uint32_t *outbuf)
+{
+    RWcode *y0 = &s->y0wcode, *y1 = &s->y1wcode, *u = &s->u_wcode, *v = &s->v_wcode;
+    uint8_t *b0 = s->basis[0], *d0 = s->dcbuf[0];
+    uint8_t *b1 = s->basis[1], *d1 = s->dcbuf[1];
+    uint8_t *b2 = s->basis[2], *d2 = s->dcbuf[2];
+
+    u->basis_prev_line = b1; u->dcbuf_prev_line = d1; u->basis_curr_line = b1; u->dcbuf_curr_line = d1;
+    u->basis_next_line = b1 + s->col_hblocks; u->dcbuf_next_line = d1 + s->col_hblocks;
+    v->basis_prev_line = b2; v->dcbuf_prev_line = d2; v->basis_curr_line = b2; v->dcbuf_curr_line = d2;
+    v->basis_next_line = b2 + s->col_hblocks; v->dcbuf_next_line = d2 + s->col_hblocks;
+    y0->basis_prev_line = b0; y0->dcbuf_prev_line = d0; y0->basis_curr_line = b0; y0->dcbuf_curr_line = d0;
+    y0->basis_next_line = b0 + s->lum_hblocks; y0->dcbuf_next_line = d0 + s->lum_hblocks;
+    if (s->mcu411) {
+        y1->basis_prev_line = b0; y1->dcbuf_prev_line = d0;
+        y1->basis_curr_line = b0 + s->lum_hblocks; y1->dcbuf_curr_line = d0 + s->lum_hblocks;
+        y1->basis_next_line = b0 + 2 * s->lum_hblocks; y1->dcbuf_next_line = d0 + 2 * s->lum_hblocks;
+    }
+    hvqm2_dec_line(s, outbuf);
+
+    outbuf += s->mcu_v_pix;
+    u->basis_prev_line = b1; u->dcbuf_prev_line = d1;
+    v->basis_prev_line = b2; v->dcbuf_prev_line = d2;
+    if (s->mcu411) {
+        y0->basis_curr_line += s->lum_hblocks; y0->dcbuf_curr_line += s->lum_hblocks;
+        y0->basis_next_line += s->lum_hblocks; y0->dcbuf_next_line += s->lum_hblocks;
+        hvqm2_advance_wcode(y1, s->lum_hblocks);
+    } else {
+        y0->basis_prev_line = b0; y0->dcbuf_prev_line = d0;
+    }
+
+    for (int line = 1; line < s->col_vblocks - 1; ++line) {
+        hvqm2_dec_line(s, outbuf);
+        outbuf += s->mcu_v_pix;
+        if (s->mcu411) {
+            hvqm2_advance_wcode(y0, s->lum_hblocks);
+            hvqm2_advance_wcode(y1, s->lum_hblocks);
+        }
+    }
+
+    /* last line: next == curr */
+    u->basis_next_line = u->basis_curr_line; u->dcbuf_next_line = u->dcbuf_curr_line;
+    v->basis_next_line = v->basis_curr_line; v->dcbuf_next_line = v->dcbuf_curr_line;
+    if (s->mcu411) {
+        y1->basis_next_line = y1->basis_curr_line; y1->dcbuf_next_line = y1->dcbuf_curr_line;
+    } else {
+        y0->basis_next_line = y0->basis_curr_line; y0->dcbuf_next_line = y0->dcbuf_curr_line;
+    }
+    hvqm2_dec_line(s, outbuf);
+}
+
+/* ---- intra (reference: Ipic_BasisNumDec/getDeltaDC/IpicDcvDec/MakeNest/HVQMDecodeIpic) ---- */
+
+static void hvqm2_ipic_basisnum(HVQM2DecContext *s)
+{
+    uint8_t rle = 0;
+    for (int i = 0; i < s->lum_total; ++i) {
+        if (rle) {
+            s->basis[0][i] = 0;
+            --rle;
+        } else {
+            uint8_t value = hvqm2_decode_huff(&s->basisnum_buf[0], &s->basisnum_tree);
+            if (value == 0)
+                rle = hvqm2_decode_huff(&s->basisnumrun_buf[0], &s->basisnumrun_tree);
+            s->basis[0][i] = value;
+        }
+    }
+    rle = 0;
+    for (int i = 0; i < s->col_total; ++i) {
+        if (rle) {
+            s->basis[1][i] = 0;
+            s->basis[2][i] = 0;
+            --rle;
+        } else {
+            uint8_t value = hvqm2_decode_huff(&s->basisnum_buf[1], &s->basisnum_tree);
+            if (value == 0)
+                rle = hvqm2_decode_huff(&s->basisnumrun_buf[1], &s->basisnumrun_tree);
+            s->basis[1][i] = value & 0xF;
+            s->basis[2][i] = value >> 4;
+        }
+    }
+}
+
+static int16_t hvqm2_get_delta_dc(HVQM2DecContext *s, int plane, int *rle)
+{
+    if (*rle == 0) {
+        int16_t delta = hvqm2_decode_dc(s, &s->dcval_buf[plane]);
+        if (delta == 0)
+            *rle = hvqm2_decode_huff(&s->dcrun_buf[plane], &s->basisnumrun_tree);
+        return delta;
+    }
+    --*rle;
+    return 0;
+}
+
+static unsigned hvqm2_mean(unsigned a, unsigned b)
+{
+    return (a + b) / 2;
+}
+
+static void hvqm2_ipic_dcv(HVQM2DecContext *s)
+{
+    uint8_t dcvalY = 0, dcvalU = 0, dcvalV = 0;
+    int rleY = 0, rleU = 0, rleV = 0;
+    uint8_t *dY = s->dcbuf[0], *dU = s->dcbuf[1], *dV = s->dcbuf[2];
+    uint8_t *pY = s->dcbuf[0], *pU = s->dcbuf[1], *pV = s->dcbuf[2];
+
+    for (int h = 0; h < s->col_hblocks; ++h) {
+        dcvalY += hvqm2_get_delta_dc(s, 0, &rleY); *dY++ = dcvalY;
+        dcvalY += hvqm2_get_delta_dc(s, 0, &rleY); *dY++ = dcvalY;
+        dcvalU += hvqm2_get_delta_dc(s, 1, &rleU); *dU++ = dcvalU;
+        dcvalV += hvqm2_get_delta_dc(s, 2, &rleV); *dV++ = dcvalV;
+    }
+    dcvalY = *pY++; dcvalU = *pU++; dcvalV = *pV++;
+    if (s->mcu411) {
+        for (int h = 0; h < s->col_hblocks; ++h) {
+            dcvalY += hvqm2_get_delta_dc(s, 0, &rleY); *dY++ = dcvalY; dcvalY = hvqm2_mean(dcvalY, *pY++);
+            dcvalY += hvqm2_get_delta_dc(s, 0, &rleY); *dY++ = dcvalY; dcvalY = hvqm2_mean(dcvalY, *pY++);
+        }
+    }
+    for (int vline = 0; vline < s->col_vblocks - 1; ++vline) {
+        dcvalY = *(pY - 1); dcvalU = *(pU - 1); dcvalV = *(pV - 1);
+        for (int h = 0; h < s->col_hblocks; ++h) {
+            dcvalY += hvqm2_get_delta_dc(s, 0, &rleY); *dY++ = dcvalY; dcvalY = hvqm2_mean(dcvalY, *pY++);
+            dcvalY += hvqm2_get_delta_dc(s, 0, &rleY); *dY++ = dcvalY; dcvalY = hvqm2_mean(dcvalY, *pY++);
+            dcvalU += hvqm2_get_delta_dc(s, 1, &rleU); *dU++ = dcvalU; dcvalU = hvqm2_mean(dcvalU, *pU++);
+            dcvalV += hvqm2_get_delta_dc(s, 2, &rleV); *dV++ = dcvalV; dcvalV = hvqm2_mean(dcvalV, *pV++);
+        }
+        dcvalY = *(pY - 1);
+        if (s->mcu411) {
+            for (int h = 0; h < s->col_hblocks; ++h) {
+                dcvalY += hvqm2_get_delta_dc(s, 0, &rleY); *dY++ = dcvalY; dcvalY = hvqm2_mean(dcvalY, *pY++);
+                dcvalY += hvqm2_get_delta_dc(s, 0, &rleY); *dY++ = dcvalY; dcvalY = hvqm2_mean(dcvalY, *pY++);
+            }
+        }
+    }
+}
+
+static void hvqm2_make_nest(HVQM2DecContext *s, unsigned nest_start_x, unsigned nest_start_y)
+{
+    unsigned h_nest, v_nest, h_mirror, v_mirror, h_empty, v_empty;
+    if (s->lum_hblocks < s->nest_w) {
+        h_nest   = s->lum_hblocks;
+        h_mirror = s->lum_hblocks < s->nest_w - s->lum_hblocks ? s->lum_hblocks : s->nest_w - s->lum_hblocks;
+        h_empty  = s->nest_w - (h_nest + h_mirror);
+    } else {
+        h_nest = s->nest_w; h_mirror = 0; h_empty = 0;
+    }
+    if (s->lum_vblocks < s->nest_h) {
+        v_nest   = s->lum_vblocks;
+        v_mirror = s->lum_vblocks < s->nest_h - s->lum_vblocks ? s->lum_vblocks : s->nest_h - s->lum_vblocks;
+        v_empty  = s->nest_w - (v_nest + v_mirror);   /* reference quirk: uses nest_w here */
+    } else {
+        v_nest = s->nest_h; v_mirror = 0; v_empty = 0;
+    }
+    /* nest_start comes from the untrusted keyframe header; keep the read window
+     * inside dcbuf[0] (valid streams use (0,0)). */
+    unsigned max_x = s->lum_hblocks > h_nest ? s->lum_hblocks - h_nest : 0;
+    unsigned max_y = s->lum_vblocks > v_nest ? s->lum_vblocks - v_nest : 0;
+    if (nest_start_x > max_x) nest_start_x = max_x;
+    if (nest_start_y > max_y) nest_start_y = max_y;
+    uint8_t *nest = s->nest;
+    const uint8_t *ptr = s->dcbuf[0] + s->lum_hblocks * nest_start_y + nest_start_x;
+    for (unsigned i = 0; i < v_nest; ++i) {
+        const uint8_t *p = ptr;
+        for (unsigned j = 0; j < h_nest; ++j)   *nest++ = *p++;
+        for (unsigned j = 0; j < h_mirror; ++j) *nest++ = *--p;
+        for (unsigned j = 0; j < h_empty; ++j)  *nest++ = 0;
+        ptr += s->lum_hblocks;
+    }
+    const uint8_t *nest2 = nest - s->nest_w;
+    for (unsigned i = 0; i < v_mirror; ++i) {
+        for (unsigned j = 0; j < (unsigned)s->nest_w; ++j) *nest++ = nest2[j];
+        nest2 -= s->nest_w;
+    }
+    for (unsigned i = 0; i < v_empty; ++i)
+        for (unsigned j = 0; j < (unsigned)s->nest_w; ++j) *nest++ = 0;
+}
+
+static void hvqm2_decode_ipic(HVQM2DecContext *s, const uint8_t *code, const uint8_t *kf)
+{
+    for (int i = 0; i < 3; ++i)
+        hvqm2_set_code(s, &s->dcrun_buf[i], code + AV_RB32(kf + i * 4));
+    hvqm2_ipic_basisnum(s);
+    hvqm2_ipic_dcv(s);
+    /* The nest is only used (and only well-formed) when the DC image is at least
+     * nest-sized; for smaller frames it is unused (DC-only) and the reference's
+     * mirror/empty math underflows. Skip it there — output is unchanged. */
+    if (s->lum_hblocks >= s->nest_w && s->lum_vblocks >= s->nest_h)
+        hvqm2_make_nest(s, AV_RB16(kf + 12), AV_RB16(kf + 14));
+}
+
+/* ---- inter (reference: HVQMDecodePpic / HVQMDecodeHpic) ---- */
+
+static void hvqm2_decode_ppic(HVQM2DecContext *s, const uint8_t *code, const uint8_t *pf,
+                              uint32_t *outbuf, const uint32_t *previm)
+{
+    hvqm2_set_code(s, &s->movevector_buf, code + AV_RB32(pf + 0));
+    hvqm2_read_tree(s, &s->movevector_buf, &s->movevector_tree);
+    hvqm2_set_code(s, &s->macroblock_buf, code + AV_RB32(pf + 4));
+
+    RWcode *y0 = &s->y0wcode, *u = &s->u_wcode, *v = &s->v_wcode;
+    y0->basis_curr_line = s->basis[0]; y0->dcbuf_curr_line = s->dcbuf[0];
+    u->basis_curr_line  = s->basis[1]; u->dcbuf_curr_line  = s->dcbuf[1];
+    v->basis_curr_line  = s->basis[2]; v->dcbuf_curr_line  = s->dcbuf[2];
+    y0->basis_next_line = s->basis[0] + s->lum_hblocks; y0->dcbuf_next_line = s->dcbuf[0] + s->lum_hblocks;
+    if (!s->mcu411) {
+        u->basis_next_line = s->basis[1] + s->col_hblocks; u->dcbuf_next_line = s->dcbuf[1] + s->col_hblocks;
+        v->basis_next_line = s->basis[2] + s->col_hblocks; v->dcbuf_next_line = s->dcbuf[2] + s->col_hblocks;
+    }
+
+    uint8_t rle_lum = 0, rle_col = 0;
+    uint8_t dc_y = 0, dc_u = 0, dc_v = 0;
+    int8_t  mv_x = 0, mv_y = 0;
+    uint32_t *outbuf_line = outbuf;
+
+    for (int y = 0; y < s->im_height; y += 8) {
+        uint32_t *outbuf_pos = outbuf_line;
+        for (int x = 0; x < s->im_width; x += 8) {
+            if (hvqm2_get_bit(&s->macroblock_buf)) {
+                if (hvqm2_get_bit(&s->macroblock_buf)) {        /* intra DC-only MB */
+                    dc_y += hvqm2_decode_dc(s, &s->dcval_buf[0]);
+                    dc_u += hvqm2_decode_dc(s, &s->dcval_buf[1]);
+                    dc_v += hvqm2_decode_dc(s, &s->dcval_buf[2]);
+                    *y0->basis_curr_line++ = 0; *y0->basis_curr_line++ = 0;
+                    *y0->dcbuf_curr_line++ = dc_y; *y0->dcbuf_curr_line++ = dc_y;
+                    *y0->basis_next_line++ = 0; *y0->basis_next_line++ = 0;
+                    *y0->dcbuf_next_line++ = dc_y; *y0->dcbuf_next_line++ = dc_y;
+                    *u->basis_curr_line++ = 0; *u->dcbuf_curr_line++ = dc_u;
+                    *v->basis_curr_line++ = 0; *v->dcbuf_curr_line++ = dc_v;
+                    if (!s->mcu411) {
+                        *u->basis_next_line++ = 0; *u->dcbuf_next_line++ = dc_u;
+                        *v->basis_next_line++ = 0; *v->dcbuf_next_line++ = dc_v;
+                    }
+                } else {                                        /* intra full MB */
+                    *y0->basis_curr_line++ = hvqm2_get_delta_bn(s, &rle_lum, &s->basisnum_buf[0], &s->basisnumrun_buf[0]);
+                    *y0->basis_curr_line++ = hvqm2_get_delta_bn(s, &rle_lum, &s->basisnum_buf[0], &s->basisnumrun_buf[0]);
+                    *y0->dcbuf_curr_line++ = (dc_y += hvqm2_decode_dc(s, &s->dcval_buf[0]));
+                    *y0->dcbuf_curr_line++ = (dc_y += hvqm2_decode_dc(s, &s->dcval_buf[0]));
+                    *y0->basis_next_line++ = hvqm2_get_delta_bn(s, &rle_lum, &s->basisnum_buf[0], &s->basisnumrun_buf[0]);
+                    *y0->basis_next_line++ = hvqm2_get_delta_bn(s, &rle_lum, &s->basisnum_buf[0], &s->basisnumrun_buf[0]);
+                    *y0->dcbuf_next_line++ = (dc_y += hvqm2_decode_dc(s, &s->dcval_buf[0]));
+                    *y0->dcbuf_next_line++ = (dc_y += hvqm2_decode_dc(s, &s->dcval_buf[0]));
+                    uint8_t bn = hvqm2_get_delta_bn(s, &rle_col, &s->basisnum_buf[1], &s->basisnumrun_buf[1]);
+                    *u->basis_curr_line++ = (bn >> 0) & 0xF;
+                    *v->basis_curr_line++ = (bn >> 4) & 0xF;
+                    *u->dcbuf_curr_line++ = (dc_u += hvqm2_decode_dc(s, &s->dcval_buf[1]));
+                    *v->dcbuf_curr_line++ = (dc_v += hvqm2_decode_dc(s, &s->dcval_buf[2]));
+                    if (!s->mcu411) {
+                        bn = hvqm2_get_delta_bn(s, &rle_col, &s->basisnum_buf[1], &s->basisnumrun_buf[1]);
+                        *u->basis_next_line++ = (bn >> 0) & 0xF;
+                        *v->basis_next_line++ = (bn >> 4) & 0xF;
+                        *u->dcbuf_next_line++ = (dc_u += hvqm2_decode_dc(s, &s->dcval_buf[1]));
+                        *v->dcbuf_next_line++ = (dc_v += hvqm2_decode_dc(s, &s->dcval_buf[2]));
+                    }
+                }
+            } else {                                            /* inter (motion comp) MB */
+                mv_x += hvqm2_decode_huff(&s->movevector_buf, &s->movevector_tree);
+                mv_y += hvqm2_decode_huff(&s->movevector_buf, &s->movevector_tree);
+
+                int src_x = x + mv_x, src_y = y + mv_y;
+                if (src_x < 0) src_x = 0; else if (src_x > s->im_width  - 8) src_x = s->im_width  - 8;
+                if (src_y < 0) src_y = 0; else if (src_y > s->im_height - 8) src_y = s->im_height - 8;
+
+                const uint32_t *src = previm + src_x + (size_t)src_y * s->fb_width;
+                uint32_t *dst = outbuf_pos;
+                for (int i = 0; i < 8; ++i) {
+                    for (int j = 0; j < 8; ++j)
+                        dst[j] = src[j];
+                    src += s->fb_width;
+                    dst += s->fb_width;
+                }
+
+                *y0->basis_curr_line++ = 0x80; *y0->basis_curr_line++ = 0x80; y0->dcbuf_curr_line += 2;
+                *y0->basis_next_line++ = 0x80; *y0->basis_next_line++ = 0x80; y0->dcbuf_next_line += 2;
+                *u->basis_curr_line++ = 0x80; u->dcbuf_curr_line++;
+                *v->basis_curr_line++ = 0x80; v->dcbuf_curr_line++;
+                if (!s->mcu411) {
+                    *u->basis_next_line++ = 0x80; u->dcbuf_next_line++;
+                    *v->basis_next_line++ = 0x80; v->dcbuf_next_line++;
+                }
+            }
+            outbuf_pos += 8;
+        }
+        y0->basis_curr_line += s->lum_hblocks; y0->dcbuf_curr_line += s->lum_hblocks;
+        y0->basis_next_line += s->lum_hblocks; y0->dcbuf_next_line += s->lum_hblocks;
+        if (!s->mcu411) {
+            u->basis_curr_line += s->col_hblocks; u->dcbuf_curr_line += s->col_hblocks;
+            u->basis_next_line += s->col_hblocks; u->dcbuf_next_line += s->col_hblocks;
+            v->basis_curr_line += s->col_hblocks; v->dcbuf_curr_line += s->col_hblocks;
+            v->basis_next_line += s->col_hblocks; v->dcbuf_next_line += s->col_hblocks;
+        }
+        outbuf_line += s->next_macroblk_line;
+    }
+}
+
+/* ---- top-level dispatch (reference: my_hvqm2Decode2) ---- */
+
+static int hvqm2_decode2(HVQM2DecContext *s, const uint8_t *code, int size, int format,
+                         uint32_t *outbuf, const uint32_t *previm)
+{
+    if (format == HVQM2_HOLD) {
+        for (int i = 0; i < s->im_height; ++i)
+            memcpy(outbuf + (size_t)i * s->fb_width, previm + (size_t)i * s->fb_width,
+                   s->im_width * sizeof(*outbuf));
+        return 0;
+    }
+
+    /* offset table (HVQM2Frame, 52 bytes) + sub-header must fit. */
+    int sub = format == HVQM2_KEYFRAME ? 16 : 8;
+    if (size < 52 + sub)
+        return AVERROR_INVALIDDATA;
+
+    /* The 13 stream offsets are file-controlled; a bad one would form an
+     * out-of-bounds pointer (undefined behaviour) before any read-time bounds
+     * check. Validate them all up front (size >= 60 here, so no underflow). The
+     * three fixvl pointers (indices 7..9) are advanced by +4 past a size prefix. */
+    for (int i = 0; i < 13; ++i) {
+        uint32_t off  = AV_RB32(code + i * 4);
+        unsigned tail = (i >= 7 && i <= 9) ? 4 : 0;
+        if (off > (uint32_t)size - tail)
+            return AVERROR_INVALIDDATA;
+    }
+
+    uint8_t *wb = s->workbuf;
+    s->basis[0] = wb; wb += s->lum_total;
+    s->dcbuf[0] = wb; wb += s->lum_total;
+    s->basis[1] = wb; wb += s->col_total;
+    s->dcbuf[1] = wb; wb += s->col_total;
+    s->basis[2] = wb; wb += s->col_total;
+    s->dcbuf[2] = wb;
+
+    for (int i = 0; i < 2; ++i) {
+        hvqm2_set_code(s, &s->basisnum_buf[i],    code + AV_RB32(code + i * 4));
+        hvqm2_set_code(s, &s->basisnumrun_buf[i], code + AV_RB32(code + 8 + i * 4));
+    }
+    for (int i = 0; i < 3; ++i) {
+        hvqm2_set_code(s, &s->scale_buf[i], code + AV_RB32(code + 16 + i * 4));
+        hvqm2_set_code(s, &s->dcval_buf[i], code + AV_RB32(code + 40 + i * 4));
+        s->fixvl[i] = code + AV_RB32(code + 28 + i * 4) + 4;   /* skip 4-byte size prefix */
+    }
+    hvqm2_read_tree(s, &s->basisnum_buf[0],    &s->basisnum_tree);
+    hvqm2_read_tree(s, &s->basisnumrun_buf[0], &s->basisnumrun_tree);
+    hvqm2_read_tree(s, &s->scale_buf[0],       &s->scale_tree);
+    hvqm2_read_tree(s, &s->dcval_buf[0],       &s->dcval_tree);
+
+    if (format == HVQM2_KEYFRAME) {
+        hvqm2_decode_ipic(s, code, code + 52);
+        hvqm2_dec_frame(s, outbuf);
+    } else {
+        hvqm2_decode_ppic(s, code, code + 52, outbuf, previm);
+        hvqm2_dec_frame(s, outbuf);
+    }
+    return 0;
+}
+
+/* ---- FFmpeg glue ---- */
+
+static av_cold int hvqm2_decode_init(AVCodecContext *avctx)
+{
+    HVQM2DecContext *s = avctx->priv_data;
+
+    if (avctx->width <= 0 || avctx->height <= 0 ||
+        (avctx->width & 7) || (avctx->height & 7)) {
+        av_log(avctx, AV_LOG_ERROR, "HVQM2 needs positive dimensions that are "
+               "multiples of 8 (got %dx%d).\n", avctx->width, avctx->height);
+        return AVERROR_INVALIDDATA;
+    }
+
+    s->yshift                = 8;
+    s->video_quantize_shift  = 0;
+    if (avctx->extradata_size >= 2) {
+        s->yshift               = avctx->extradata[0];
+        s->video_quantize_shift = avctx->extradata[1];
+    }
+    s->pix_alpha = 0xFF;
+    /* Chroma sampling comes from extradata[2] (v_sampling: 2 = 4:1:1/yuv420p,
+     * 1 = 4:2:2/yuv422p). avctx->pix_fmt can't be trusted here: this decoder
+     * outputs RGBA, and find_stream_info writes that back into the stream's
+     * codecpar, so a second open would see RGBA instead of the container format. */
+    if (avctx->extradata_size >= 3)
+        s->mcu411 = avctx->extradata[2] != 1;
+    else
+        s->mcu411 = avctx->pix_fmt != AV_PIX_FMT_YUV422P;
+    avctx->pix_fmt = AV_PIX_FMT_RGBA;
+
+    s->im_width  = avctx->width;
+    s->im_height = avctx->height;
+    s->fb_width  = avctx->width;
+    s->mcu_h_pix = (s->mcu411 ? 2 : 2) * 4;               /* h_sampling_rate (2) * 4 */
+    s->mcu_v_pix = (s->mcu411 ? 2 : 1) * 4 * s->fb_width; /* v_sampling_rate * 4 * fb_width */
+    s->next_macroblk_line = s->fb_width * 8;
+    s->lum_hblocks = avctx->width  >> 2;
+    s->lum_vblocks = avctx->height >> 2;
+    s->lum_total   = s->lum_hblocks * s->lum_vblocks;
+    s->col_hblocks = avctx->width  >> 3;
+    s->col_vblocks = avctx->height >> (s->mcu411 ? 3 : 2);
+    s->col_total   = s->col_hblocks * s->col_vblocks;
+    if (s->yshift == 8) { s->nest_w = HVQM2_NEST_L; s->nest_h = HVQM2_NEST_S; }
+    else                { s->nest_w = HVQM2_NEST_S; s->nest_h = HVQM2_NEST_L; }
+
+    /* video_quantize_shift is an untrusted byte; clamp to the legal range so the
+     * shifts stay well-defined (a count >= the int width is UB). Valid streams use 0. */
+    if (s->video_quantize_shift > 8)
+        s->video_quantize_shift = 8;
+    s->dc_min = (int16_t)(0xFF80 << s->video_quantize_shift);
+    s->dc_max = (int16_t)(0x007F << s->video_quantize_shift);
+    for (int i = 0; i < 0x100; ++i) {
+        /* multiply rather than left-shift a possibly-negative (int8_t)i (which is UB). */
+        s->scale_tree.array[0][i] = (int8_t)i * 8;
+        s->dcval_tree.array[0][i] = (int8_t)i * (1 << s->video_quantize_shift);
+    }
+    s->divT[0] = 0;
+    for (int i = 1; i < 0x200; ++i)
+        s->divT[i] = 0x1000 / i;
+
+    s->workbuf = av_malloc(2 * (size_t)s->lum_total + 4 * (size_t)s->col_total);
+    s->fb[0]   = av_malloc((size_t)s->fb_width * s->im_height * sizeof(uint32_t));
+    s->fb[1]   = av_malloc((size_t)s->fb_width * s->im_height * sizeof(uint32_t));
+    if (!s->workbuf || !s->fb[0] || !s->fb[1])
+        return AVERROR(ENOMEM);
+    s->fb_idx    = 0;
+    s->have_prev = 0;
+    return 0;
+}
+
+static int hvqm2_decode_frame(AVCodecContext *avctx, AVFrame *frame,
+                              int *got_frame, AVPacket *avpkt)
+{
+    HVQM2DecContext *s = avctx->priv_data;
+    int format, ret;
+
+    if (avpkt->size < HVQM2_FRAME_MIN)
+        format = HVQM2_HOLD;
+    else if (avpkt->flags & AV_PKT_FLAG_KEY)
+        format = HVQM2_KEYFRAME;
+    else
+        format = HVQM2_PREDICT;
+
+    if (format != HVQM2_KEYFRAME && !s->have_prev) {
+        av_log(avctx, AV_LOG_ERROR, "HVQM2 non-keyframe before any keyframe.\n");
+        return AVERROR_INVALIDDATA;
+    }
+
+    uint32_t *cur  = s->fb[s->fb_idx ^ 1];
+    uint32_t *prev = s->fb[s->fb_idx];
+
+    s->body_end = avpkt->data + avpkt->size;
+    ret = hvqm2_decode2(s, avpkt->data, avpkt->size, format, cur, prev);
+    if (ret < 0)
+        return ret;
+
+    if ((ret = ff_get_buffer(avctx, frame, 0)) < 0)
+        return ret;
+
+    for (int y = 0; y < s->im_height; ++y)
+        memcpy(frame->data[0] + (size_t)y * frame->linesize[0],
+               cur + (size_t)y * s->fb_width, (size_t)s->im_width * sizeof(uint32_t));
+
+    frame->pict_type = format == HVQM2_KEYFRAME ? AV_PICTURE_TYPE_I : AV_PICTURE_TYPE_P;
+    if (format == HVQM2_KEYFRAME)
+        frame->flags |= AV_FRAME_FLAG_KEY;
+    else
+        frame->flags &= ~AV_FRAME_FLAG_KEY;
+
+    s->fb_idx   ^= 1;
+    s->have_prev = 1;
+    *got_frame   = 1;
+    return avpkt->size;
+}
+
+static av_cold int hvqm2_decode_close(AVCodecContext *avctx)
+{
+    HVQM2DecContext *s = avctx->priv_data;
+    av_freep(&s->workbuf);
+    av_freep(&s->fb[0]);
+    av_freep(&s->fb[1]);
+    return 0;
+}
+
+const FFCodec ff_hvqm2_decoder = {
+    .p.name         = "hvqm2",
+    CODEC_LONG_NAME("Hudson HVQM2 VQ video"),
+    .p.type         = AVMEDIA_TYPE_VIDEO,
+    .p.id           = AV_CODEC_ID_HVQM2,
+    .p.capabilities = AV_CODEC_CAP_DR1,
+    .priv_data_size = sizeof(HVQM2DecContext),
+    .init           = hvqm2_decode_init,
+    .close          = hvqm2_decode_close,
+    FF_CODEC_DECODE_CB(hvqm2_decode_frame),
+    .caps_internal  = FF_CODEC_CAP_INIT_CLEANUP,
+};
