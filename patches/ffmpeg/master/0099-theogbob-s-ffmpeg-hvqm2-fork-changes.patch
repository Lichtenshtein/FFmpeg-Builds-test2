@@ -681,6 +696,41 @@ static int adpcm_encode_frame(AVCodecContext *avctx, AVPacket *avpkt,
 
         flush_put_bits(&pb);
         ) /* End of CASE */
+    CASE(ADPCM_IMA_HVQM2,
+        /* Mono IMA-QT ADPCM. Each packet is one self-describing .hvqm audio record:
+         * a 6-byte header [format u16][reserved u16 = 0][nb_samples u16] followed by the
+         * body. format 0 (the first record) carries a 4-byte state preamble (initial
+         * predictor BE16 + step_index BE16, both 0 at a cold start) ahead of the nibbles;
+         * format 1 records are pure continuation nibbles. Nibbles in sample order:
+         * even -> high, odd -> low. The muxer lifts the format word into the 8-byte record
+         * header and writes the rest of the body verbatim (so demux + remux round-trip). */
+        ADPCMChannelStatus *status = &c->status[0];
+        uint8_t *p = dst;
+        int parity = 0;
+        uint8_t cur = 0;
+        int first  = !c->hvqm2_started;
+        if (frame->nb_samples > UINT16_MAX) {
+            av_log(avctx, AV_LOG_ERROR,
+                   "HVQM2 audio record of %d samples exceeds 65535.\n", frame->nb_samples);
+            return AVERROR(EINVAL);
+        }
+        bytestream_put_be16(&p, first ? 0 : 1);          /* record format: 0 = key, 1 = cont */
+        bytestream_put_be16(&p, 0);                      /* reserved (always 0) */
+        bytestream_put_be16(&p, frame->nb_samples);      /* samples in this record */
+        if (first) {
+            bytestream_put_be16(&p, status->prev_sample & 0xFFFF);   /* initial predictor */
+            bytestream_put_be16(&p, status->step_index  & 0xFFFF);   /* initial step index */
+            c->hvqm2_started = 1;
+            avpkt->flags |= AV_PKT_FLAG_KEY;             /* also flag the record as a sync point */
+        }
+        for (int i = 0; i < frame->nb_samples; i++) {
+            int nib = adpcm_ima_qt_compress_sample(status, samples[i]);
+            if (!parity) cur = nib << 4;
+            else         *p++ = cur | nib;
+            parity ^= 1;
+        }
+        if (parity) *p++ = cur;                          /* trailing high nibble, low = 0 */
+        ) /* End of CASE */
     CASE(ADPCM_IMA_SSI,
         PutBitContext pb;
         init_put_bits(&pb, dst, pkt_size);
@@ -1013,6 +1063,7 @@ ADPCM_ENCODER(ADPCM_IMA_AMV, adpcm_ima_amv, sample_fmts,   0,
 ADPCM_ENCODER(ADPCM_IMA_APM, adpcm_ima_apm, sample_fmts,   AV_CODEC_CAP_SMALL_LAST_FRAME, "ADPCM IMA Ubisoft APM",                  MONO_STEREO, AVCLASS)
 ADPCM_ENCODER(ADPCM_IMA_ALP, adpcm_ima_alp, sample_fmts,   AV_CODEC_CAP_SMALL_LAST_FRAME, "ADPCM IMA High Voltage Software ALP",    MONO_STEREO, AVCLASS)
 ADPCM_ENCODER(ADPCM_IMA_QT,  adpcm_ima_qt,  sample_fmts_p, 0,                             "ADPCM IMA QuickTime",                    MONO_STEREO)
+ADPCM_ENCODER(ADPCM_IMA_HVQM2, adpcm_ima_hvqm2, sample_fmts, AV_CODEC_CAP_SMALL_LAST_FRAME, "ADPCM IMA HVQM2",                      CODEC_CH_LAYOUTS(AV_CHANNEL_LAYOUT_MONO), AVCLASS)
