+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * Hudson HVQM2 1.0 container muxer.
+ *
+ * Layout (big-endian): a 60-byte file header followed by a linear sequence of
+ * records, each an 8-byte header (type, format, body size) + body. Video records
+ * carry HVQM2 VQ frames (key/predict/hold); audio records carry mono IMA ADPCM.
+ * Video and audio are interleaved by DTS by the generic muxer.
+ *
+ * The encoding profile (y_shiftnum, video_quantize_shift) comes from the encoder
+ * via 2-byte stream extradata; it falls back to the fixed Phase-1 profile
+ * (y_shiftnum = 8, video_quantize_shift = 0) when extradata is absent.
+ */
+
+#include "libavutil/avutil.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/mathematics.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixfmt.h"
+#include "libavutil/rational.h"
+#include "avformat.h"
+#include "avio_internal.h"
+#include "mux.h"
+
+/* Phase-1 fixed profile — keep in sync with the encoder. */
+#define HVQM2_Y_SHIFTNUM            8
+#define HVQM2_VIDEO_QUANTIZE_SHIFT  0
+
+/* Record type / video format (HVQM2File.h). */
+#define HVQM2_RECORD_AUDIO          0
+#define HVQM2_RECORD_VIDEO          1
+#define HVQM2_VIDEO_KEYFRAME        0
+#define HVQM2_VIDEO_PREDICT         1
+#define HVQM2_VIDEO_HOLD            2
+
+typedef struct HVQM2MuxContext {
+    int64_t file_size_pos;       ///< header offset of file_size (u32)
+    int64_t total_frames_pos;    ///< header offset of total_frames (u32)
+    int64_t max_frame_pos;       ///< header offset of max_frame_size (u32)
+    int64_t total_audio_pos;     ///< header offset of total_audio_records (u32)
+    int64_t max_audio_pos;       ///< header offset of max_audio_record_size (u32)
+    uint32_t nb_video;
+    uint32_t max_frame_size;     ///< largest video record body written
+    uint32_t nb_audio;
+    uint32_t max_audio_size;     ///< largest audio record body written
+} HVQM2MuxContext;
+
+static int hvqm_write_header(AVFormatContext *s)
+{
+    HVQM2MuxContext *c = s->priv_data;
+    AVStream *st = NULL, *ast = NULL;
+    AVCodecParameters *par;
+    AVRational rate;
+
+    for (int i = 0; i < s->nb_streams; i++) {     /* one video + optional one audio */
+        enum AVMediaType t = s->streams[i]->codecpar->codec_type;
+        if (t == AVMEDIA_TYPE_VIDEO)      st  = s->streams[i];
+        else if (t == AVMEDIA_TYPE_AUDIO) ast = s->streams[i];
+    }
+    if (!st) {
+        av_log(s, AV_LOG_ERROR, "HVQM2 requires a video stream.\n");
+        return AVERROR(EINVAL);
+    }
+    par = st->codecpar;
+    if (ast && ast->codecpar->ch_layout.nb_channels != 1) {
+        av_log(s, AV_LOG_ERROR, "HVQM2 audio must be mono.\n");
+        return AVERROR(EINVAL);
+    }
+    int64_t usec_per_frame;
+    int v_sampling_rate;
+    /* Profile comes from the encoder (or a stream-copy source) via 2-byte extradata;
+     * fall back to the fixed Phase-1 profile when it is absent. */
+    int y_shiftnum           = HVQM2_Y_SHIFTNUM;
+    int video_quantize_shift = HVQM2_VIDEO_QUANTIZE_SHIFT;
+    if (par->extradata_size >= 2) {
+        y_shiftnum           = par->extradata[0];
+        video_quantize_shift = par->extradata[1];
+    }
+
+    if (!(s->pb->seekable & AVIO_SEEKABLE_NORMAL)) {
+        av_log(s, AV_LOG_ERROR, "HVQM2 muxer requires seekable output "
+               "(header counters are backfilled in the trailer).\n");
+        return AVERROR(EINVAL);
+    }
+
+    if ((par->width & 7) || (par->height & 7) ||
+        par->width < 144 || par->height < 80 ||
+        par->width > 65535 || par->height > 65535) {
+        av_log(s, AV_LOG_ERROR, "HVQM2 needs dimensions that are multiples of 8, "
+               "at least 144x80 and at most 65535 (got %dx%d).\n",
+               par->width, par->height);
+        return AVERROR(EINVAL);
+    }
+
+    switch (par->format) {
+    case AV_PIX_FMT_YUV420P: v_sampling_rate = 2; break; /* "4:1:1" mode = 2x2 chroma */
+    case AV_PIX_FMT_YUV422P: v_sampling_rate = 1; break; /* 4:2:2 */
+    default:
+        /* A stream-copied HVQM2 video carries its chroma in extradata[2] (the in-tree
+         * decoder reports RGBA, so par->format is not the container format). */
+        if (par->extradata_size >= 3 &&
+            (par->extradata[2] == 1 || par->extradata[2] == 2)) {
+            v_sampling_rate = par->extradata[2];
+            break;
+        }
+        av_log(s, AV_LOG_ERROR, "HVQM2 requires yuv420p or yuv422p input.\n");
+        return AVERROR(EINVAL);
+    }
+
+    rate = st->avg_frame_rate;
+    if (!rate.num || !rate.den)
+        rate = av_inv_q(st->time_base);
+    if (rate.num <= 0 || rate.den <= 0) {
+        av_log(s, AV_LOG_ERROR, "A valid frame rate is required for HVQM2 output.\n");
+        return AVERROR(EINVAL);
+    }
+    usec_per_frame = av_rescale(1000000, rate.den, rate.num);
+    if (usec_per_frame <= 0 || usec_per_frame > UINT32_MAX) {
+        av_log(s, AV_LOG_ERROR, "Frame rate %d/%d is out of range for HVQM2 "
+               "(frame interval must be a positive 32-bit microsecond value).\n",
+               rate.num, rate.den);
+        return AVERROR(EINVAL);
+    }
+
+    avio_write(s->pb, "HVQM2 1.0\0\0\0\0\0\0", 16);   /* file_version (ASCIIZ, padded) */
+    c->file_size_pos = avio_tell(s->pb);
+    avio_wb32(s->pb, 0);                              /* file_size (backfilled) */
+    avio_wb16(s->pb, par->width);
+    avio_wb16(s->pb, par->height);
+    avio_w8(s->pb, 2);                                /* h_sampling_rate */
+    avio_w8(s->pb, v_sampling_rate);
+    avio_w8(s->pb, y_shiftnum);
+    avio_w8(s->pb, video_quantize_shift);
+    c->total_frames_pos = avio_tell(s->pb);
+    avio_wb32(s->pb, 0);                              /* total_frames (backfilled) */
+    avio_wb32(s->pb, (uint32_t)usec_per_frame);
+    c->max_frame_pos = avio_tell(s->pb);
+    avio_wb32(s->pb, 0);                              /* max_frame_size (backfilled) */
+    avio_wb32(s->pb, 0);                              /* max_sp_packets (CPU decode: unused) */
+    avio_w8(s->pb, ast ? 1 : 0);                      /* audio_format: 1 = ADPCM */
+    avio_w8(s->pb, ast ? 1 : 0);                      /* channels (mono) */
+    avio_w8(s->pb, ast ? 16 : 0);                     /* sample_bits (ADPCM -> 16-bit PCM) */
+    avio_w8(s->pb, 0);                                /* audio_quantize_step */
+    c->total_audio_pos = avio_tell(s->pb);
+    avio_wb32(s->pb, 0);                              /* total_audio_records (backfilled) */
+    avio_wb32(s->pb, ast ? ast->codecpar->sample_rate : 0);  /* samples_per_sec */
+    c->max_audio_pos = avio_tell(s->pb);
+    avio_wb32(s->pb, 0);                              /* max_audio_record_size (backfilled) */
+
+    if (c->file_size_pos < 0 || c->total_frames_pos < 0 || c->max_frame_pos < 0 ||
+        c->total_audio_pos < 0 || c->max_audio_pos < 0)
+        return AVERROR(EIO);
+    return 0;
+}
+
+static int hvqm_write_packet(AVFormatContext *s, AVPacket *pkt)
+{
+    HVQM2MuxContext *c = s->priv_data;
+    AVCodecParameters *par = s->streams[pkt->stream_index]->codecpar;
+    unsigned pad, body;
+
+    if (pkt->size < 0 || (unsigned)pkt->size > UINT32_MAX - 8)
+        return AVERROR_INVALIDDATA;
+
+    if (par->codec_type == AVMEDIA_TYPE_AUDIO) {
+        /* The adpcm_ima_hvqm2 packet is one self-describing audio record:
+         * [format u16][reserved u16 = 0][nb_samples u16] + ADPCM body. We lift the format
+         * word into the 8-byte record header and write the rest of the packet verbatim as
+         * the record body, so a demux -> remux preserves the bytes exactly. format 0 is the
+         * first (key) record, format 1 a continuation. Body padded to a 4-byte multiple. */
+        unsigned afmt, abody, apad;
+        if (pkt->size < 6) {
+            av_log(s, AV_LOG_ERROR, "HVQM2 audio packet too short (%d bytes).\n", pkt->size);
+            return AVERROR(EINVAL);
+        }
+        afmt  = AV_RB16(pkt->data);
+        abody = (unsigned)pkt->size - 2;              /* strip the format word from the body */
+        apad  = (~abody + 1) & 3;
+        avio_wb16(s->pb, HVQM2_RECORD_AUDIO);
+        avio_wb16(s->pb, afmt);
+        avio_wb32(s->pb, abody + apad);
+        avio_write(s->pb, pkt->data + 2, abody);      /* [reserved][nb_samples] + ADPCM body */
+        if (apad)
+            ffio_fill(s->pb, 0, apad);
+        if (abody + apad > c->max_audio_size)
+            c->max_audio_size = abody + apad;
+        c->nb_audio++;
+        return 0;
+    }
+
+    /* A KEY/PREDICT body always carries the 52-byte HVQM2Frame offset table, so any
+     * video packet smaller than that is a HOLD (repeat previous frame): the encoder
+     * emits an empty packet, the demuxer a 1-byte marker. Either way the record body
+     * is empty. */
+    if (pkt->size < 52) {
+        avio_wb16(s->pb, HVQM2_RECORD_VIDEO);
+        avio_wb16(s->pb, HVQM2_VIDEO_HOLD);
+        avio_wb32(s->pb, 0);
+        c->nb_video++;
+        return 0;
+    }
+
+    /* Record bodies must be a multiple of 4 bytes. */
+    pad  = (~(unsigned)pkt->size + 1) & 3;
+    body = (unsigned)pkt->size + pad;
+
+    avio_wb16(s->pb, HVQM2_RECORD_VIDEO);
+    avio_wb16(s->pb, (pkt->flags & AV_PKT_FLAG_KEY) ? HVQM2_VIDEO_KEYFRAME
+                                                    : HVQM2_VIDEO_PREDICT);
+    avio_wb32(s->pb, body);
+    avio_write(s->pb, pkt->data, pkt->size);
+    if (pad)
+        ffio_fill(s->pb, 0, pad);
+
+    if (body > c->max_frame_size)
+        c->max_frame_size = body;
+    c->nb_video++;
+    return 0;
+}
+
+static int hvqm_write_trailer(AVFormatContext *s)
+{
+    HVQM2MuxContext *c = s->priv_data;
+    int64_t file_size = avio_tell(s->pb);
+    int64_t ret;
+
+    if (file_size < 0)
+        return AVERROR(EIO);
+    if (file_size > UINT32_MAX) {
+        av_log(s, AV_LOG_ERROR, "Output exceeds the 4 GiB HVQM2 file-size limit.\n");
+        return AVERROR(EINVAL);
+    }
+
+    if ((ret = avio_seek(s->pb, c->file_size_pos, SEEK_SET)) < 0)
+        return ret;
+    avio_wb32(s->pb, (uint32_t)file_size);
+    if ((ret = avio_seek(s->pb, c->total_frames_pos, SEEK_SET)) < 0)
+        return ret;
+    avio_wb32(s->pb, c->nb_video);
+    if ((ret = avio_seek(s->pb, c->max_frame_pos, SEEK_SET)) < 0)
+        return ret;
+    avio_wb32(s->pb, c->max_frame_size);
+    if ((ret = avio_seek(s->pb, c->total_audio_pos, SEEK_SET)) < 0)
+        return ret;
+    avio_wb32(s->pb, c->nb_audio);
+    if ((ret = avio_seek(s->pb, c->max_audio_pos, SEEK_SET)) < 0)
+        return ret;
+    avio_wb32(s->pb, c->max_audio_size);
+
+    if ((ret = avio_seek(s->pb, file_size, SEEK_SET)) < 0)
+        return ret;
+    return 0;
+}
+
+const FFOutputFormat ff_hvqm_muxer = {
+    .p.name           = "hvqm",
+    .p.long_name      = NULL_IF_CONFIG_SMALL("Hudson HVQM2"),
+    .p.extensions     = "hvqm",
+    .p.audio_codec    = AV_CODEC_ID_ADPCM_IMA_HVQM2,
+    .p.video_codec    = AV_CODEC_ID_HVQM2,
+    .p.subtitle_codec = AV_CODEC_ID_NONE,
+    .priv_data_size   = sizeof(HVQM2MuxContext),
+    /* No AVFMT_NOTIMESTAMPS: audio+video records are interleaved by the generic muxer in
+     * DTS order, which needs the packet timestamps the encoders provide. */
+    .flags_internal   = FF_OFMT_FLAG_MAX_ONE_OF_EACH |
+                        FF_OFMT_FLAG_ONLY_DEFAULT_CODECS,
+    .write_header     = hvqm_write_header,
+    .write_packet     = hvqm_write_packet,
+    .write_trailer    = hvqm_write_trailer,
+};
