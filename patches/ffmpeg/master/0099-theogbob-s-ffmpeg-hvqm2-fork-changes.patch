diff --git a/libavformat/hvqmdec.c b/libavformat/hvqmdec.c
new file mode 100644
index 0000000..6822f50
--- /dev/null
+++ b/libavformat/hvqmdec.c
@@ -0,0 +1,263 @@
+/*
+ * Hudson HVQM2 (.hvqm) demuxer
+ *
+ * Copyright (c) 2026 FFmpeg HVQM2 port
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * Hudson HVQM2 1.0 container demuxer.
+ *
+ * Layout (big-endian): a 60-byte file header followed by a linear sequence of
+ * records, each an 8-byte header (type u16, format u16, body size u32) + body.
+ * Video records carry HVQM2 VQ frames (key/predict/hold); audio records carry
+ * ADPCM. See libavformat/hvqmenc.c (the muxer) for the byte-exact header layout.
+ *
+ * Audio is handed to the in-tree adpcm_ima_hvqm2 decoder by prepending the
+ * record's 2-byte format word to the body, yielding the packet layout that
+ * decoder expects: [format u16][reserved u16][nb_samples u16][ADPCM payload].
+ *
+ * Video packets carry codec id AV_CODEC_ID_HVQM2 and are decoded by the in-tree
+ * hvqm2 decoder (libavcodec/hvqm2dec.c). A HOLD frame is emitted as a 1-byte
+ * marker rather than a zero-size packet, because FFmpeg drops empty packets
+ * before the decoder; the decoder and the muxer treat any video packet smaller
+ * than the 52-byte HVQM2Frame offset table as a HOLD (repeat previous frame).
+ */
+
+#include "libavutil/channel_layout.h"
+#include "libavutil/intreadwrite.h"
+#include "avformat.h"
+#include "demux.h"
+#include "internal.h"
+
+#define HVQM2_HEADER_SIZE       60
+#define HVQM2_RECORD_HEADER     8
+#define HVQM2_RECORD_AUDIO      0
+#define HVQM2_RECORD_VIDEO      1
+#define HVQM2_VIDEO_KEYFRAME    0
+#define HVQM2_VIDEO_PREDICT     1
+#define HVQM2_VIDEO_HOLD        2
+/* Sanity ceiling on a record body. Video is hard-capped at 30000 by the decoder;
+ * audio records are far smaller. Anything larger means a corrupt/oversized file. */
+#define HVQM2_RECORD_BODY_MAX   (1 << 20)
+
+typedef struct HVQM2DemuxContext {
+    int      video_index;
+    int      audio_index;       ///< -1 when the file has no audio
+    int64_t  video_pts;         ///< running video frame index
+    int64_t  audio_pts;         ///< running audio sample position
+} HVQM2DemuxContext;
+
+static int hvqm2_probe(const AVProbeData *p)
+{
+    if (p->buf_size < 16)
+        return 0;
+    if (memcmp(p->buf, "HVQM2 1.0", 9))
+        return 0;
+    return AVPROBE_SCORE_MAX;
+}
+
+static int hvqm2_read_header(AVFormatContext *s)
+{
+    HVQM2DemuxContext *c = s->priv_data;
+    AVIOContext *pb = s->pb;
+    AVStream *st, *ast;
+    char magic[16];
+    int width, height, v_sampling, y_shiftnum, vqs, audio_format, ret;
+    uint32_t total_frames, usec_per_frame, sample_rate;
+    enum AVPixelFormat pix_fmt;
+
+    if (avio_read(pb, magic, sizeof(magic)) != sizeof(magic) ||
+        memcmp(magic, "HVQM2 1.0", 9))
+        return AVERROR_INVALIDDATA;
+
+    avio_rb32(pb);                              /* file_size (ignored) */
+    width      = avio_rb16(pb);
+    height     = avio_rb16(pb);
+    avio_r8(pb);                                /* h_sampling_rate (always 2) */
+    v_sampling = avio_r8(pb);
+    y_shiftnum = avio_r8(pb);
+    vqs        = avio_r8(pb);                    /* video_quantize_shift */
+    total_frames   = avio_rb32(pb);
+    usec_per_frame = avio_rb32(pb);
+    avio_rb32(pb);                              /* max_frame_size (ignored) */
+    avio_rb32(pb);                              /* max_sp_packets (ignored) */
+    audio_format = avio_r8(pb);
+    avio_r8(pb);                                /* channels (mono) */
+    avio_r8(pb);                                /* sample_bits */
+    avio_r8(pb);                                /* audio_quantize_step */
+    avio_rb32(pb);                              /* total_audio_records (ignored) */
+    sample_rate = avio_rb32(pb);
+    avio_rb32(pb);                              /* max_audio_record_size (ignored) */
+
+    if (avio_feof(pb))
+        return AVERROR_INVALIDDATA;
+    if (width <= 0 || height <= 0 || (width & 7) || (height & 7)) {
+        av_log(s, AV_LOG_ERROR, "Invalid HVQM2 dimensions %dx%d.\n", width, height);
+        return AVERROR_INVALIDDATA;
+    }
+    if (!usec_per_frame) {
+        av_log(s, AV_LOG_ERROR, "HVQM2 frame interval is zero.\n");
+        return AVERROR_INVALIDDATA;
+    }
+    switch (v_sampling) {
+    case 2:  pix_fmt = AV_PIX_FMT_YUV420P; break;   /* "4:1:1" = 2x2 chroma */
+    case 1:  pix_fmt = AV_PIX_FMT_YUV422P; break;
+    default:
+        av_log(s, AV_LOG_ERROR, "Unsupported HVQM2 chroma sampling %d.\n", v_sampling);
+        return AVERROR_INVALIDDATA;
+    }
+
+    st = avformat_new_stream(s, NULL);
+    if (!st)
+        return AVERROR(ENOMEM);
+    st->codecpar->codec_type = AVMEDIA_TYPE_VIDEO;
+    st->codecpar->codec_id   = AV_CODEC_ID_HVQM2;
+    st->codecpar->width      = width;
+    st->codecpar->height     = height;
+    st->codecpar->format     = pix_fmt;
+    st->nb_frames            = total_frames;
+    st->start_time           = 0;
+    st->duration             = total_frames;
+    avpriv_set_pts_info(st, 64, usec_per_frame, 1000000);
+    /* Profile for the decoder and a stream-copy muxer: [y_shiftnum][video_quantize_shift]
+     * [v_sampling]. v_sampling (chroma) matters because the decoder outputs RGBA, which
+     * find_stream_info writes back into codecpar->format, losing the container's pixel
+     * format; extradata survives that, so both the decoder and the muxer read it here. */
+    if ((ret = ff_alloc_extradata(st->codecpar, 3)) < 0)
+        return ret;
+    st->codecpar->extradata[0] = y_shiftnum;
+    st->codecpar->extradata[1] = vqs;
+    st->codecpar->extradata[2] = v_sampling;
+    c->video_index = st->index;
+
+    c->audio_index = -1;
+    if (audio_format) {
+        ast = avformat_new_stream(s, NULL);
+        if (!ast)
+            return AVERROR(ENOMEM);
+        ast->codecpar->codec_type  = AVMEDIA_TYPE_AUDIO;
+        ast->codecpar->codec_id    = AV_CODEC_ID_ADPCM_IMA_HVQM2;
+        ast->codecpar->ch_layout   = (AVChannelLayout)AV_CHANNEL_LAYOUT_MONO;
+        ast->codecpar->sample_rate = sample_rate;
+        ast->codecpar->bits_per_coded_sample = 4;
+        if (!sample_rate) {
+            av_log(s, AV_LOG_ERROR, "HVQM2 audio sample rate is zero.\n");
+            return AVERROR_INVALIDDATA;
+        }
+        avpriv_set_pts_info(ast, 64, 1, sample_rate);
+        c->audio_index = ast->index;
+    }
+
+    return 0;
+}
+
+static int hvqm2_read_packet(AVFormatContext *s, AVPacket *pkt)
+{
+    HVQM2DemuxContext *c = s->priv_data;
+    AVIOContext *pb = s->pb;
+
+    for (;;) {
+        int64_t pos = avio_tell(pb);
+        unsigned type, format, size;
+        int ret;
+
+        type   = avio_rb16(pb);
+        format = avio_rb16(pb);
+        size   = avio_rb32(pb);
+        if (avio_feof(pb))
+            return AVERROR_EOF;
+        if (size > HVQM2_RECORD_BODY_MAX) {
+            av_log(s, AV_LOG_ERROR, "HVQM2 record body %u too large.\n", size);
+            return AVERROR_INVALIDDATA;
+        }
+
+        if (type == HVQM2_RECORD_VIDEO) {
+            if (format == HVQM2_VIDEO_HOLD || size == 0) {
+                /* HOLD = repeat the previous frame; the record body is empty. FFmpeg
+                 * drops zero-size packets before the decoder, so emit a 1-byte marker
+                 * (a body too small to hold a frame header) that the decoder and a
+                 * stream-copy muxer both treat as HOLD. */
+                if ((ret = av_new_packet(pkt, 1)) < 0)
+                    return ret;
+                pkt->data[0] = 0;
+                if (size && avio_skip(pb, size) < 0) {
+                    av_packet_unref(pkt);
+                    return AVERROR_INVALIDDATA;
+                }
+            } else {
+                if ((ret = av_get_packet(pb, pkt, size)) < 0)
+                    return ret;
+                if (ret != (int)size) {            /* body truncated by EOF */
+                    av_packet_unref(pkt);
+                    return AVERROR_INVALIDDATA;
+                }
+                if (format == HVQM2_VIDEO_KEYFRAME)
+                    pkt->flags |= AV_PKT_FLAG_KEY;
+            }
+            pkt->stream_index = c->video_index;
+            pkt->pos          = pos;
+            pkt->pts          = pkt->dts = c->video_pts++;
+            pkt->duration     = 1;
+            return 0;
+        }
+
+        if (type == HVQM2_RECORD_AUDIO && c->audio_index >= 0) {
+            /* Prepend the 2-byte record format word so the body becomes the packet
+             * the in-tree decoder reads: [format][reserved][nb_samples][payload]. */
+            if (size < 4) {
+                av_log(s, AV_LOG_ERROR, "HVQM2 audio record too short (%u).\n", size);
+                return AVERROR_INVALIDDATA;
+            }
+            if ((ret = av_new_packet(pkt, size + 2)) < 0)
+                return ret;
+            AV_WB16(pkt->data, format);
+            ret = avio_read(pb, pkt->data + 2, size);
+            if (ret != (int)size) {
+                av_packet_unref(pkt);
+                return ret < 0 ? ret : AVERROR_EOF;
+            }
+            pkt->stream_index = c->audio_index;
+            pkt->pos          = pos;
+            if (format == 0)
+                pkt->flags |= AV_PKT_FLAG_KEY;
+            pkt->pts       = pkt->dts = c->audio_pts;
+            pkt->duration  = AV_RB16(pkt->data + 4);   /* nb_samples in this record */
+            c->audio_pts  += pkt->duration;
+            return 0;
+        }
+
+        /* Unknown or audio-without-stream record: skip its body and continue. */
+        if (avio_skip(pb, size) < 0)
+            return AVERROR_INVALIDDATA;
+        if (avio_feof(pb))
+            return AVERROR_EOF;
+    }
+}
+
+const FFInputFormat ff_hvqm_demuxer = {
+    .p.name         = "hvqm",
+    .p.long_name    = NULL_IF_CONFIG_SMALL("Hudson HVQM2"),
+    .p.extensions   = "hvqm",
+    .p.flags        = AVFMT_GENERIC_INDEX,
+    .priv_data_size = sizeof(HVQM2DemuxContext),
+    .read_probe     = hvqm2_probe,
+    .read_header    = hvqm2_read_header,
+    .read_packet    = hvqm2_read_packet,
+};
