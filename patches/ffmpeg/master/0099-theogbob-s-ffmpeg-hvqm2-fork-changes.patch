index 0000000..04f6638
--- /dev/null
+++ b/libavformat/hvqmenc.c
@@ -0,0 +1,292 @@
+/*
+ * Hudson HVQM2 (.hvqm) muxer
+ *
+ * Copyright (c) 2026 FFmpeg HVQM2 port
+ *
