+/* Decode %XX escapes in place. The var_stream_map syntax is split on
+ * spaces, so values that need a space (e.g. aname:English%205.1) use
+ * percent-encoding instead. */
+static void percent_decode_inplace(char *str)
+{
+    char *w = str;
+    const char *r = str;
+
+    while (*r) {
+        if (r[0] == '%' && av_isxdigit(r[1]) && av_isxdigit(r[2])) {
+            char hex[3] = { r[1], r[2], '\0' };
+            *w++ = (char)strtol(hex, NULL, 16);
+            r += 3;
+        } else {
+            *w++ = *r++;
+        }
+    }
+    *w = '\0';
+}
