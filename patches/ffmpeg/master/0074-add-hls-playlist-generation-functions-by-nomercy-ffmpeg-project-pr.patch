 libavformat/dashenc.c     |   4 +-
 libavformat/hlsenc.c      | 225 +++++++++++++++++++++++++-------------
 libavformat/hlsplaylist.c |  67 ++++++++++--
 libavformat/hlsplaylist.h |   9 +-
 5 files changed, 241 insertions(+), 99 deletions(-)

diff --git a/libavformat/codecstring.c b/libavformat/codecstring.c
index 6ecec13..cd9a0ed 100644
--- a/libavformat/codecstring.c
+++ b/libavformat/codecstring.c
@@ -164,6 +164,32 @@ int ff_make_codec_str(void *logctx, const AVCodecParameters *par,
             }
             data++;
         }
+        /* No annex-B SPS found: fall back to hvcC extradata (ISO/IEC
+         * 14496-15). Bytes 1..12 of HEVCDecoderConfigurationRecord carry
+         * the same profile_tier_level layout the SPS parse above reads,
+         * so stream copies from MP4/MOV sources also get a CODECS string. */
+        if (tier == 0 && par->extradata && par->extradata_size >= 13 &&
+            par->extradata[0] == 1) {
+            const uint8_t *cfg = par->extradata;
+            uint32_t compat_flags;
+            uint8_t high_nibble;
+
+            tier = (cfg[1] & 0x20) == 0 ? 'L' : 'H';
+            profile = cfg[1] & 0x1f;
+            /* general_profile_compatibility_flags in reverse bit order,
+             * same transformation as the SPS path above */
+            compat_flags = AV_RB32(cfg + 2);
+            compat_flags = ((compat_flags & 0x55555555U) << 1) | ((compat_flags >> 1) & 0x55555555U);
+            compat_flags = ((compat_flags & 0x33333333U) << 2) | ((compat_flags >> 2) & 0x33333333U);
+            compat_flags = ((compat_flags & 0x0F0F0F0FU) << 4) | ((compat_flags >> 4) & 0x0F0F0F0FU);
+            compat_flags = ((compat_flags & 0x00FF00FFU) << 8) | ((compat_flags >> 8) & 0x00FF00FFU);
+            profile_compatibility = (compat_flags << 16) | (compat_flags >> 16);
+            high_nibble = cfg[7] >> 4;
+            snprintf(constraints, sizeof(constraints),
+                     high_nibble ? "%02x.%x" : "%02x",
+                     cfg[6], high_nibble);
+            level = cfg[12];
+        }
         if (par->codec_tag == MKTAG('h','v','c','1') &&
             profile != AV_PROFILE_UNKNOWN &&
             profile_compatibility != AV_PROFILE_UNKNOWN &&
@@ -180,7 +206,7 @@ int ff_make_codec_str(void *logctx, const AVCodecParameters *par,
         int err;
         if (!par->extradata_size)
             return AVERROR(EINVAL);
-        if ((err = ff_lcvec_parse_config_record(&lvcc, par->extradata, par->extradata_size, logctx)) < 0)
+        if ((err = ff_lcvec_parse_config_record(&lvcc, par->extradata, par->extradata_size)) < 0)
             return err;
         av_bprintf(out, "lvc1.vprf%u.vlev%u", lvcc.profile_idc, lvcc.level_idc);
     } else if (par->codec_id == AV_CODEC_ID_AV1) {
