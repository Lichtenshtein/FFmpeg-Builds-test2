From: Lichtenshtein <altruumann@protonmail.com>
Date: Fri, 24 Jul 2026 08:22:36 +0300
Subject: [PATCH] Change frei0r plugins search default location to bin/frei0r-1

---
 libavfilter/vf_frei0r.c | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/libavfilter/vf_frei0r.c b/libavfilter/vf_frei0r.c
index 722d6dc..89fc698 100644
--- a/libavfilter/vf_frei0r.c
+++ b/libavfilter/vf_frei0r.c
@@ -200,10 +200,7 @@ static av_cold int frei0r_init(AVFilterContext *ctx,
     int ret = 0;
     int i;
     static const char* const frei0r_pathlist[] = {
-        "/usr/local/lib/frei0r-1/",
-        "/usr/lib/frei0r-1/",
-        "/usr/local/lib64/frei0r-1/",
-        "/usr/lib64/frei0r-1/"
+        "frei0r-1/"
     };
 
     if (!dl_name) {
