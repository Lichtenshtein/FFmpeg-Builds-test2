From 205ec77a2a37e7b84a749fc21ea29bcaa8de03d1 Mon Sep 17 00:00:00 2001
From: Lichtenshtein <altruumann@protonmail.com>
Date: Sun, 26 Apr 2026 21:22:41 +0300
Subject: [PATCH] fix paths

---
 src_base/CMakeLists.txt | 16 ++++++++++++++--
 src_main/CMakeLists.txt | 16 ++++++++++++++--
 2 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/src_base/CMakeLists.txt b/src_base/CMakeLists.txt
index 2018b16..043b4d9 100644
--- a/src_base/CMakeLists.txt
+++ b/src_base/CMakeLists.txt
@@ -45,8 +45,20 @@ set(BASE_INCLUDE_DIRS
     $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
 )
 
-target_include_directories(${LIB_NAME_BASE} PUBLIC ${BASE_INCLUDE_DIRS})
-target_include_directories(${LIB_NAME_BASE}_shared PUBLIC ${BASE_INCLUDE_DIRS})
+target_include_directories(${LIB_NAME_BASE} PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/sse>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/avx>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/../inc>
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+)
+target_include_directories(${LIB_NAME_BASE}_shared PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/sse>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/avx>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/../inc>
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+)
 
 if(UNIX OR MINGW)
     target_compile_definitions(${LIB_NAME_BASE} PUBLIC ANY LINUX)
diff --git a/src_main/CMakeLists.txt b/src_main/CMakeLists.txt
index 20f5aaf..bbb20e4 100644
--- a/src_main/CMakeLists.txt
+++ b/src_main/CMakeLists.txt
@@ -46,8 +46,20 @@ set(XEVD_INCLUDE_DIRS
     $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
 )
 
-target_include_directories(${LIB_NAME} PUBLIC ${XEVD_INCLUDE_DIRS})
-target_include_directories(${LIB_NAME}_shared PUBLIC ${XEVD_INCLUDE_DIRS})
+target_include_directories(${LIB_NAME_BASE} PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/sse>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/avx>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/../inc>
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+)
+target_include_directories(${LIB_NAME_BASE}_shared PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/sse>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/avx>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/../inc>
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+)
 
 if(NOT MSVC AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
     set(X86_FLAGS -mssse3 -msse4.1 -msse4.2 -mavx -mavx2 -fno-tree-vectorize)
-- 
2.52.0.windows.1

