From 2ecb4f8afc3e42854b1eefc4fb6bce251410cf27 Mon Sep 17 00:00:00 2001
From: Lichtenshtein <altruumann@protonmail.com>
Date: Sun, 26 Apr 2026 20:11:00 +0300
Subject: [PATCH] fix dynamic lib installation

---
 src_base/CMakeLists.txt | 17 +++++++++++++++++
 src_main/CMakeLists.txt | 18 +++++++++++++++++-
 2 files changed, 34 insertions(+), 1 deletion(-)

diff --git a/src_base/CMakeLists.txt b/src_base/CMakeLists.txt
index 244740d..8683f40 100644
--- a/src_base/CMakeLists.txt
+++ b/src_base/CMakeLists.txt
@@ -16,6 +16,16 @@ include_directories("${CMAKE_CURRENT_BINARY_DIR}")
 
 add_library(${LIB_NAME_BASE} STATIC ${LIB_API_SRC} ${XEVD_INC} ${LIB_BASE_SRC} ${LIB_BASE_INC})
 
+add_library(${LIB_NAME}_shared SHARED
+        ${LIB_API_MAIN_SRC}
+        ${XEVD_INC}
+        ${LIB_BASE_SRC}
+        ${LIB_BASE_INC}
+        ${LIB_MAIN_SRC}
+        ${LIB_MAIN_INC})
+
+set_target_properties(${LIB_NAME}_shared PROPERTIES OUTPUT_NAME ${LIB_NAME})
+
 add_library(XEVD::${LIB_NAME_BASE} ALIAS ${LIB_NAME_BASE})
 
 if("${ARM}" STREQUAL "TRUE")
@@ -110,6 +120,13 @@ if (XEVD_INSTALL)
             INCLUDES DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
     )
 
+    install(TARGETS ${LIB_NAME} ${LIB_NAME}_shared
+            EXPORT XEVDTargets
+            ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+            LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+            RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+    )
+
     configure_file(
         "${CMAKE_CURRENT_SOURCE_DIR}/pkgconfig/${LIB_NAME_BASE}.pc.in"
         "${CMAKE_CURRENT_BINARY_DIR}/${LIB_NAME_BASE}.pc"
diff --git a/src_main/CMakeLists.txt b/src_main/CMakeLists.txt
index 4decfca..d37582c 100644
--- a/src_main/CMakeLists.txt
+++ b/src_main/CMakeLists.txt
@@ -30,6 +30,16 @@ add_library(${LIB_NAME} STATIC
         ${LIB_MAIN_SRC}
         ${LIB_MAIN_INC})
 
+add_library(${LIB_NAME}_shared SHARED
+        ${LIB_API_MAIN_SRC}
+        ${XEVD_INC}
+        ${LIB_BASE_SRC}
+        ${LIB_BASE_INC}
+        ${LIB_MAIN_SRC}
+        ${LIB_MAIN_INC})
+
+set_target_properties(${LIB_NAME}_shared PROPERTIES OUTPUT_NAME ${LIB_NAME})
+
 add_library(XEVD::${LIB_NAME} ALIAS ${LIB_NAME})
 
 if("${ARM}" STREQUAL "TRUE")
@@ -57,7 +67,6 @@ if(NOT MSVC AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
             -msse4.2
             -mavx
             -mavx2
-            -mavx512f
             -fno-tree-vectorize
     )
 endif ()
@@ -143,6 +152,13 @@ if (XEVD_INSTALL)
             INCLUDES DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
     )
 
+    install(TARGETS ${LIB_NAME} ${LIB_NAME}_shared
+            EXPORT XEVDTargets
+            ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+            LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+            RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+    )
+
     configure_file(
         "${CMAKE_CURRENT_SOURCE_DIR}/pkgconfig/${LIB_NAME}.pc.in"
         "${CMAKE_CURRENT_BINARY_DIR}/${LIB_NAME}.pc"
-- 
