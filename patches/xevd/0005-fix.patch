-add_library(${LIB_NAME} STATIC ${ALL_SOURCES})
-add_library(${LIB_NAME}_shared SHARED ${ALL_SOURCES})
-
-set_target_properties(${LIB_NAME} PROPERTIES OUTPUT_NAME ${LIB_NAME})
-set_target_properties(${LIB_NAME}_shared PROPERTIES OUTPUT_NAME ${LIB_NAME})
+add_library(xevd STATIC ${ALL_SOURCES})
+add_library(xevd_shared SHARED ${ALL_SOURCES})
 
-if("${ARM}" STREQUAL "TRUE")
-    set(SIMD_SOURCES ${LIB_NEON_SRC} ${LIB_NEON_INC} ${LIB_MAIN_NEON_SRC} ${LIB_MAIN_NEON_INC})
-else()
-    set(SIMD_SOURCES ${LIB_SSE_SRC} ${LIB_SSE_INC} ${LIB_MAIN_SSE_SRC} ${LIB_MAIN_SSE_INC} ${LIB_AVX_SRC} ${LIB_AVX_INC} ${LIB_MAIN_AVX_SRC} ${LIB_MAIN_AVX_INC})
-endif()
+set_target_properties(xevd PROPERTIES OUTPUT_NAME "xevd")
+set_target_properties(xevd_shared PROPERTIES OUTPUT_NAME "xevd")
 
-target_sources(${LIB_NAME} PRIVATE ${SIMD_SOURCES})
-target_sources(${LIB_NAME}_shared PRIVATE ${SIMD_SOURCES})
+set(SIMD_SOURCES ${LIB_SSE_SRC} ${LIB_SSE_INC} ${LIB_MAIN_SSE_SRC} ${LIB_MAIN_SSE_INC} ${LIB_AVX_SRC} ${LIB_AVX_INC} ${LIB_MAIN_AVX_SRC} ${LIB_MAIN_AVX_INC})
+target_sources(xevd PRIVATE ${SIMD_SOURCES})
+target_sources(xevd_shared PRIVATE ${SIMD_SOURCES})
 
-set(XEVD_INCLUDE_DIRS
+set(INC_DIRS 
     $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
     $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/../src_base>
-    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/../inc>
-    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
-)
-
-target_include_directories(${LIB_NAME_BASE} PUBLIC
-    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
-    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/sse>
-    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/avx>
-    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/../inc>
-    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
-)
-target_include_directories(${LIB_NAME_BASE}_shared PUBLIC
-    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
