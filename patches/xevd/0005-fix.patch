-    set_target_properties(${LIB_NAME} PROPERTIES PUBLIC_HEADER "${XEVD_INC}")
-
-    install(TARGETS ${LIB_NAME} ${LIB_NAME}_shared
+    install(TARGETS xevd xevd_shared
             EXPORT XEVDTargets
             ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
