+target_include_directories(xevd PUBLIC ${INC_DIRS})
+target_include_directories(xevd_shared PUBLIC ${INC_DIRS})
+
+if(NOT MSVC)
     set(X86_FLAGS -mssse3 -msse4.1 -msse4.2 -mavx -mavx2 -fno-tree-vectorize)
-    target_compile_options(${LIB_NAME} PRIVATE ${X86_FLAGS})
-    target_compile_options(${LIB_NAME}_shared PRIVATE ${X86_FLAGS})
+    target_compile_options(xevd PRIVATE ${X86_FLAGS})
+    target_compile_options(xevd_shared PRIVATE ${X86_FLAGS})
 endif()
 
 if(UNIX OR MINGW)
-    target_compile_definitions(${LIB_NAME} PUBLIC ANY LINUX)
-    target_compile_definitions(${LIB_NAME}_shared PUBLIC ANY LINUX)
-    target_link_libraries(${LIB_NAME} m)
-    target_link_libraries(${LIB_NAME}_shared m)
+    target_link_libraries(xevd m)
+    target_link_libraries(xevd_shared m)
+    target_compile_definitions(xevd PUBLIC ANY LINUX)
+    target_compile_definitions(xevd_shared PUBLIC ANY LINUX)
 endif()
 
 if(XEVD_INSTALL)
     include(GNUInstallDirs)
