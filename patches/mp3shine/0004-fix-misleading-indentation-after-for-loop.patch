From c53df91c4cc195c5a7dd31401486b0d312b6748f Mon Sep 17 00:00:00 2001
From: Arvin <arvin.sonuhi@gmail.com>
Date: Mon, 3 Oct 2022 20:11:36 -0600
Subject: [PATCH] Fix misleading indentation after for loop

---
 src/lib/l3loop.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/lib/l3loop.c b/src/lib/l3loop.c
index 6ba7bc0..e125ca8 100644
--- a/src/lib/l3loop.c
+++ b/src/lib/l3loop.c
@@ -445,12 +445,14 @@ void calc_runlen(int ix[GRANULE_SIZE], gr_info *cod_info) {
 
   cod_info->count1 = 0;
   for (; i > 3; i -= 4)
+  {
     if (ix[i - 1] <= 1 && ix[i - 2] <= 1 && ix[i - 3] <= 1 && ix[i - 4] <= 1)
       cod_info->count1++;
     else
       break;
+  }
 
-  cod_info->big_values = i >> 1;
+  cod_info->big_values = i>>1;
 }
 
