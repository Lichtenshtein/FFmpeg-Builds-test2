From ad1e6078d67c7df9409f295df0b3f9677b460086 Mon Sep 17 00:00:00 2001
From: Lichtenshtein <altruumann@protonmail.com>
Date: Mon, 13 Jul 2026 04:35:16 +0300
Subject: [PATCH] fix CMakeLists.txt

---
 0001-test.patch | 25 +++++++++++++++++++++++++
 CMakeLists.txt  | 45 +++++++++++++++++++++++++++++++--------------
 2 files changed, 56 insertions(+), 14 deletions(-)
 create mode 100644 0001-test.patch

diff --git a/spng/spng.c b/spng/spng.c
index 7a3252a..f45061b 100644
--- a/spng/spng.c
+++ b/spng/spng.c
@@ -18,7 +18,7 @@
     #ifdef SPNG_USE_MINIZ
         #include <miniz.h>
     #else
-        #include <zlib-ng.h>
+        #include <zlib.h>
     #endif
 #endif
 
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6fca4e2..6d293e1 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -10,9 +10,9 @@ set(SPNG_REVISION 4)
 set(SPNG_VERSION ${SPNG_MAJOR}.${SPNG_MINOR}.${SPNG_REVISION})
 
 option(SPNG_ENABLE_OPT "Enable architecture-specific optimizations" ON)
-option(SPNG_SHARED "Build shared lib" ON)
+option(SPNG_SHARED "Build shared lib" OFF)
 option(SPNG_STATIC "Build static lib" ON)
-option(SPNG_BUILD_EXAMPLES "Build examples" ON)
+option(SPNG_BUILD_EXAMPLES "Build examples" OFF)
 option(SPNG_INSTALL "Enable install" ON)
 
 unset(SPNG_CUSTOM_ZLIB_TARGET CACHE)
@@ -24,7 +24,7 @@ if(SPNG_INSTALL)
     include(CMakePackageConfigHelpers)
 endif()
 
-if(NOT CMAKE_HOST_WIN32)
+if(NOT WIN32)
     set(SPNG_DEPENDENCIES "m")
 endif()
 
@@ -43,23 +43,41 @@ if(NOT SPNG_ENABLE_OPT)
 endif()
 
 set(spng_TARGETS "")
-
 set(spng_SOURCES spng/spng.c)
 
 if(SPNG_SHARED)
     add_library(spng SHARED ${spng_SOURCES})
     list(APPEND spng_TARGETS spng)
+endif()
 
-    if(SPNG_BUILD_EXAMPLES)
-        add_executable(example examples/example.c)
-        target_link_libraries(example PRIVATE spng)
+if(SPNG_STATIC)
+    if(NOT SPNG_SHARED)
+        add_library(spng STATIC ${spng_SOURCES})
+        set_target_properties(spng PROPERTIES OUTPUT_NAME spng)
+        list(APPEND spng_TARGETS spng)
+    else()
+        add_library(spng_static STATIC ${spng_SOURCES})
+        set_target_properties(spng_static PROPERTIES OUTPUT_NAME spng)
+        list(APPEND spng_TARGETS spng_static)
+    endif()
+    
+    foreach(tgt ${spng_TARGETS})
+        if(tgt MATCHES "static")
+            target_compile_definitions(${tgt} PUBLIC SPNG_STATIC)
+        endif()
+    endforeach()
+    if(NOT SPNG_SHARED)
+        target_compile_definitions(spng PUBLIC SPNG_STATIC)
     endif()
 endif()
 
-if(SPNG_STATIC)
-    add_library(spng_static STATIC ${spng_SOURCES})
-    target_compile_definitions(spng_static PUBLIC SPNG_STATIC)
-    list(APPEND spng_TARGETS spng_static)
+if(SPNG_BUILD_EXAMPLES)
+    add_executable(example examples/example.c)
+    if(TARGET spng)
+        target_link_libraries(example PRIVATE spng)
+    else()
+        target_link_libraries(example PRIVATE spng_static)
+    endif()
 endif()
 
 foreach(spng_TARGET ${spng_TARGETS})
@@ -118,9 +136,8 @@ if(SPNG_INSTALL)
         set(LIBS        "-lm")
 
         foreach(libname ${spng_TARGETS})
-            configure_file(${CMAKE_CURRENT_SOURCE_DIR}/cmake/libspng.pc.in ${CMAKE_CURRENT_BINARY_DIR}/cmake/lib${libname}.pc @ONLY)
-
-            install(FILES ${CMAKE_CURRENT_BINARY_DIR}/cmake/lib${libname}.pc DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig)
+            configure_file(${CMAKE_CURRENT_SOURCE_DIR}/cmake/libspng.pc.in ${CMAKE_CURRENT_BINARY_DIR}/cmake/spng.pc @ONLY)
+            install(FILES ${CMAKE_CURRENT_BINARY_DIR}/cmake/spng.pc DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig)
         endforeach()
     endif()
 endif()
-- 
2.52.0.windows.1

