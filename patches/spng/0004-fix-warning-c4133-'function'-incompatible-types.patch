From f7f84f0551a5b14ce71fdaf661fcd6d2b21cf6e7 Mon Sep 17 00:00:00 2001
From: Ger Hobbelt <ger@hobbelt.com>
Date: Mon, 22 Dec 2025 23:04:12 +0100
Subject: [PATCH] fix warning C4133: 'function': incompatible types - from
 'spng_errno *' to 'int *'

---
 tests/testsuite.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tests/testsuite.c b/tests/testsuite.c
index fc0c87e5..0a0fad37 100644
--- a/tests/testsuite.c
+++ b/tests/testsuite.c
@@ -1118,7 +1118,7 @@ static void dump_buffer(void *buf, size_t size, const char *opt_name)
 
 static int spngt_run_test(const char *filename, struct spngt_test_case *test_case)
 {
-    enum spng_errno ret;
+    int ret;
     size_t file_length = 0;
     struct spngt_test_case spng = *test_case;
     struct spngt_test_case libpng = *test_case;
@@ -1412,7 +1412,7 @@ static int stream_write_checked(spng_ctx *ctx, void *user, void *data, size_t le
 static int extended_tests(FILE *file, int fmt)
 {
     uint32_t i;
-    enum spng_errno ret = 0;
+    int ret = 0;
     unsigned char *image = NULL;
     unsigned char *encoded = NULL;
     spng_ctx *enc = NULL;
