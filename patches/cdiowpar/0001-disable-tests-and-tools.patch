From 51e901d982e3b1a3e45e39967d625293f049f041 Mon Sep 17 00:00:00 2001
From: Lichtenshtein <altruumann@protonmail.com>
Date: Sat, 11 Jul 2026 16:10:42 +0300
Subject: [PATCH] disable tests and tools

---
 Makefile.am     | 14 ++------------
 configure.ac    | 14 +-------------
 src/Makefile.am |  2 +-
 3 files changed, 4 insertions(+), 26 deletions(-)

diff --git a/Makefile.am b/Makefile.am
index b4c282e..8a6249a 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -13,15 +13,9 @@ EXTRA_DIST = \
         INSTALL.md \
         README.md \
 	make-check-filter.rb \
-	example/README \
-	COPYING \
-	$(wildcard test/data/*.bin) \
-	$(wildcard test/data/*.BIN) \
-	$(wildcard test/data/*.cue) \
-	$(wildcard test/data/*.iso) \
-	$(wildcard test/*.right)
+	COPYING
 
-SUBDIRS = doc include lib src test example
+SUBDIRS = include lib src
 
 paranoiapcs = libcdio_paranoia.pc libcdio_cdda.pc
 
@@ -48,10 +42,6 @@ test: check
 check-short:
 	$(MAKE) check 2>&1  | ruby @abs_top_srcdir@/make-check-filter.rb
 
-#: Make documentation via Doxygen http://www.stack.nl/~dimitri/doxygen/
-doxygen:
-	-( cd ${top_srcdir}/doc/doxygen && /bin/sh ${srcdir}/run_doxygen )
-
 MAINTAINERCLEANFILES = ChangeLog *.rej *.orig
 
 if MAINTAINER_MODE
diff --git a/configure.ac b/configure.ac
index 18e54a8..549a766 100644
--- a/configure.ac
+++ b/configure.ac
@@ -447,14 +447,6 @@ dnl
 ## AC_CONFIG_FILES([  po/Makefile.in\
 AC_CONFIG_FILES([
        Makefile \
-       doc/Makefile \
-       doc/doxygen/Doxyfile \
-       doc/en/Makefile \
-       doc/en/cd-paranoia.1 \
-       doc/ja/Makefile \
-       doc/ja/cd-paranoia.1 \
-       example/Makefile \
-       example/C++/Makefile \
        include/Makefile \
        include/cdio/Makefile \
        include/cdio/paranoia/Makefile \
@@ -465,11 +457,7 @@ AC_CONFIG_FILES([
        libcdio_cdda.pc \
        libcdio_paranoia.pc \
        src/Makefile \
-       src/usage.txt \
-       test/data/Makefile
-       test/cdda_interface/Makefile
-       test/cdda_interface/toc.c
-       test/Makefile
+       src/usage.txt
        ])
 
 # AC_CONFIG_FILES([po/Makefile])
diff --git a/src/Makefile.am b/src/Makefile.am
index 4abedaf..a87e107 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -21,7 +21,7 @@ cd_paranoia_LDADD =  $(LIBCDIO_LIBS) $(LIBCDIO_CDDA_LIBS) $(LIBCDIO_PARANOIA_LIB
 
 cd_paranoia_DEPENDENCIES =  $(LIBCDIO_DEPS) $(LIBCDIO_CDDA_LIBS) $(LIBCDIO_PARANOIA_LIBS)
 
-bin_PROGRAMS = cd-paranoia
+bin_PROGRAMS =
 
 AM_CPPFLAGS = -I$(top_srcdir) $(LIBCDIO_PARANOIA_CFLAGS) $(LIBCDIO_CFLAGS)
 
-- 
2.52.0.windows.1

