+#!/usr/bin/env python3
+"""
+Batch VMAF Comparison - Compare multiple video pairs.
+
+Usage:
+    python batch_compare.py -c comparisons.json -o results/
+    python batch_compare.py --reference-dir originals/ --distorted-dir transcoded/ -o results/
+"""
+
+import argparse
+import json
+import os
+import sys
+from datetime import datetime
+from pathlib import Path
+from typing import List, Dict, Any
+from concurrent.futures import ThreadPoolExecutor, as_completed
+
+from vmaf_calculator import VMAFCalculator
+
+
+def load_comparisons_from_json(json_path: str) -> List[Dict[str, str]]:
+    """Load comparison pairs from a JSON file."""
+    with open(json_path, "r") as f:
+        data = json.load(f)
+    return data.get("comparisons", data)
+
+
+def discover_pairs(
+    reference_dir: str,
+    distorted_dir: str,
+    extensions: tuple = (".mp4", ".mkv", ".mov", ".m3u8")
+) -> List[Dict[str, str]]:
+    """Discover matching video pairs from two directories."""
+    pairs = []
+    ref_path = Path(reference_dir)
+    dist_path = Path(distorted_dir)
+
+    for ref_file in ref_path.iterdir():
+        if ref_file.suffix.lower() in extensions:
+            # Look for matching distorted file
+            for ext in extensions:
+                dist_file = dist_path / f"{ref_file.stem}{ext}"
+                if dist_file.exists():
+                    pairs.append({
+                        "reference": str(ref_file),
+                        "distorted": str(dist_file),
+                        "name": ref_file.stem,
+                    })
+                    break
+
+    return pairs
+
+
+def run_comparison(
+    pair: Dict[str, str],
+    output_dir: str,
+    model: str,
+    verbose: bool,
+    mongodb_uri: str = None,
+    mongodb_enabled: bool = False
+) -> Dict[str, Any]:
+    """Run a single VMAF comparison."""
+    name = pair.get("name", Path(pair["reference"]).stem)
+    output_file = os.path.join(output_dir, f"{name}_vmaf.json")
+
+    print(f"\n[{name}] Starting comparison...")
+
+    try:
+        # Prepare show metadata for MongoDB if enabled
+        show_metadata = None
+        if mongodb_enabled and pair.get("metadata"):
+            show_metadata = pair["metadata"]
+        elif mongodb_enabled:
+            # Create basic metadata from pair info
+            show_metadata = {
+                "s3_link_name": pair["distorted"],
+                "show_title": name,
+                "episode_number": 0,
+                "show_id": name.lower().replace(" ", "_"),
+                "trail_name": "default",
+            }
+
+        calculator = VMAFCalculator(
+            reference_path=pair["reference"],
+            distorted_path=pair["distorted"],
+            output_path=output_file,
+            model=model,
+            verbose=verbose,
+            mongodb_uri=mongodb_uri,
+            mongodb_enabled=mongodb_enabled,
+            show_metadata=show_metadata,
+        )
+
+        result = calculator.calculate()
+
+        return {
+            "name": name,
+            "status": "success",
+            "vmaf_score": result["metrics"]["vmaf"]["score"],
+            "output_file": output_file,
+        }
+
+    except Exception as e:
+        print(f"[{name}] ERROR: {e}")
+        return {
+            "name": name,
+            "status": "error",
+            "error": str(e),
+        }
+
+
+def generate_report(results: List[Dict], output_dir: str):
+    """Generate a summary report of all comparisons."""
+    report = {
+        "timestamp": datetime.now().isoformat(),
+        "total_comparisons": len(results),
+        "successful": sum(1 for r in results if r["status"] == "success"),
+        "failed": sum(1 for r in results if r["status"] == "error"),
+        "results": results,
+    }
+
+    # Calculate statistics for successful comparisons
+    successful = [r for r in results if r["status"] == "success"]
+    if successful:
+        scores = [r["vmaf_score"] for r in successful]
+        report["statistics"] = {
+            "mean_vmaf": sum(scores) / len(scores),
+            "min_vmaf": min(scores),
+            "max_vmaf": max(scores),
+        }
+
+    # Save report
+    report_path = os.path.join(output_dir, "batch_report.json")
+    with open(report_path, "w") as f:
+        json.dump(report, f, indent=2)
+
+    # Print summary
+    print("\n" + "=" * 60)
+    print("BATCH COMPARISON SUMMARY")
+    print("=" * 60)
+    print(f"Total comparisons: {report['total_comparisons']}")
+    print(f"Successful: {report['successful']}")
+    print(f"Failed: {report['failed']}")
+
+    if "statistics" in report:
+        stats = report["statistics"]
+        print(f"\nVMAF Statistics:")
+        print(f"  Mean:  {stats['mean_vmaf']:.2f}")
+        print(f"  Min:   {stats['min_vmaf']:.2f}")
+        print(f"  Max:   {stats['max_vmaf']:.2f}")
+
+    print(f"\nReport saved to: {report_path}")
+    print("=" * 60)
+
+    return report
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Batch VMAF comparison for multiple video pairs"
+    )
+
+    group = parser.add_mutually_exclusive_group(required=True)
+    group.add_argument(
+        "-c", "--config",
+        help="JSON file with comparison pairs",
+    )
+    group.add_argument(
+        "--reference-dir",
+        help="Directory containing reference videos",
+    )
+
+    parser.add_argument(
+        "--distorted-dir",
+        help="Directory containing distorted videos (required with --reference-dir)",
+    )
+    parser.add_argument(
+        "-o", "--output-dir",
+        default="vmaf_results",
+        help="Output directory for results (default: vmaf_results)",
+    )
+    parser.add_argument(
+        "-m", "--model",
+        choices=["vmaf_v0.6.1", "vmaf_4k", "vmaf_b"],
+        default="vmaf_v0.6.1",
+        help="VMAF model to use",
+    )
+    parser.add_argument(
+        "-p", "--parallel",
+        type=int,
+        default=1,
+        help="Number of parallel comparisons (default: 1)",
+    )
+    parser.add_argument(
+        "-v", "--verbose",
+        action="store_true",
+        help="Enable verbose output",
+    )
+    parser.add_argument(
+        "--mongodb-uri",
+        help="MongoDB connection URI (enables MongoDB storage)",
+    )
+    parser.add_argument(
+        "--store-to-mongodb",
+        action="store_true",
+        help="Store results to MongoDB (requires --mongodb-uri)",
+    )
+
+    args = parser.parse_args()
+
+    # Validate arguments
+    if args.reference_dir and not args.distorted_dir:
+        parser.error("--distorted-dir is required when using --reference-dir")
+
+    # Create output directory
+    os.makedirs(args.output_dir, exist_ok=True)
+
+    # Get comparison pairs
+    if args.config:
+        pairs = load_comparisons_from_json(args.config)
+    else:
+        pairs = discover_pairs(args.reference_dir, args.distorted_dir)
+
+    if not pairs:
+        print("No video pairs found to compare.")
+        sys.exit(1)
+
+    print(f"Found {len(pairs)} video pairs to compare")
+
+    # Check MongoDB configuration
+    mongodb_enabled = args.store_to_mongodb and args.mongodb_uri is not None
+    if args.store_to_mongodb and not args.mongodb_uri:
+        print("Warning: --store-to-mongodb requires --mongodb-uri. MongoDB storage disabled.")
+        mongodb_enabled = False
+
+    # Run comparisons
+    results = []
+    if args.parallel > 1:
+        with ThreadPoolExecutor(max_workers=args.parallel) as executor:
+            futures = {
+                executor.submit(
+                    run_comparison, pair, args.output_dir, args.model, args.verbose,
+                    args.mongodb_uri, mongodb_enabled
+                ): pair
+                for pair in pairs
+            }
+            for future in as_completed(futures):
+                results.append(future.result())
+    else:
+        for pair in pairs:
+            result = run_comparison(
+                pair, args.output_dir, args.model, args.verbose,
+                args.mongodb_uri, mongodb_enabled
+            )
+            results.append(result)
+
+    # Generate report
+    generate_report(results, args.output_dir)
+
+
+if __name__ == "__main__":
+    main()
