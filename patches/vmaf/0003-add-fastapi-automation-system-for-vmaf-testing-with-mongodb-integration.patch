+@app.route("/api/codec-compare", methods=["POST"])
+def codec_compare():
+    """Handle codec comparison request."""
+    try:
+        # Get form data
+        model = request.form.get("model", "vmaf_phone")
+        h264_url = request.form.get("h264_url", "").strip()
+        h265_url = request.form.get("h265_url", "").strip()
+
+        # Validate at least one URL
+        if not h264_url and not h265_url:
+            return jsonify({"error": "At least one codec URL is required"}), 400
+
+        # Validate reference file
+        if "reference" not in request.files:
+            return jsonify({"error": "No reference file provided"}), 400
+
+        reference_file = request.files["reference"]
+        if reference_file.filename == "":
+            return jsonify({"error": "No reference file selected"}), 400
+
+        if not allowed_file(reference_file.filename):
+            return jsonify({"error": "Invalid reference file type"}), 400
+
+        # Generate job ID
+        job_id = str(uuid.uuid4())[:8]
+
+        # Save reference file
+        ref_filename = secure_filename(f"{job_id}_ref_{reference_file.filename}")
+        reference_path = str(UPLOAD_FOLDER / ref_filename)
+        reference_file.save(reference_path)
+
+        # Initialize job
+        jobs[job_id] = {
+            "id": job_id,
+            "status": "queued",
+            "message": "Job queued",
+            "created_at": datetime.now().isoformat(),
+            "reference": reference_path,
+            "h264": h264_url or None,
+            "h265": h265_url or None,
+            "model": model,
+            "result": None,
+        }
+
+        # Start background thread
+        thread = threading.Thread(
+            target=run_codec_comparison,
+            args=(job_id, reference_path, h264_url or None, h265_url or None, model)
+        )
+        thread.start()
+
+        return jsonify({
+            "job_id": job_id,
+            "status": "queued",
+            "message": "Comparison started"
+        })
+
+    except Exception as e:
+        return jsonify({"error": str(e)}), 500
