+import os
+from dataclasses import dataclass, field
+from typing import Dict, List
+
+
+@dataclass
+class ResolutionTarget:
+    name: str
+    width: int
+    height: int
+    vmaf_target: float
+    bitrate_min: int  # kbps
+    bitrate_max: int  # kbps
+
+
+# Landscape (horizontal) resolution targets
+LANDSCAPE_TARGETS: List[ResolutionTarget] = [
+    ResolutionTarget(
+        name="1080p",
+        width=1920,
+        height=1080,
+        vmaf_target=92.0,
+        bitrate_min=3500,
+        bitrate_max=5000,
+    ),
+    ResolutionTarget(
+        name="720p",
+        width=1280,
+        height=720,
+        vmaf_target=87.0,
+        bitrate_min=2000,
+        bitrate_max=3500,
+    ),
+    ResolutionTarget(
+        name="480p",
+        width=854,
+        height=480,
+        vmaf_target=83.0,
+        bitrate_min=1500,
+        bitrate_max=2500,
+    ),
+]
+
+# Portrait (vertical) resolution targets
+PORTRAIT_TARGETS: List[ResolutionTarget] = [
+    ResolutionTarget(
+        name="1080p",
+        width=1080,
+        height=1920,
+        vmaf_target=92.0,
+        bitrate_min=3500,
+        bitrate_max=5000,
+    ),
+    ResolutionTarget(
+        name="720p",
+        width=720,
+        height=1280,
+        vmaf_target=87.0,
+        bitrate_min=2000,
+        bitrate_max=3500,
+    ),
+    ResolutionTarget(
+        name="480p",
+        width=480,
+        height=854,
+        vmaf_target=83.0,
+        bitrate_min=1500,
+        bitrate_max=2500,
+    ),
+]
+
+
+def get_resolution_targets(width: int, height: int) -> List[ResolutionTarget]:
+    """Get appropriate resolution targets based on video orientation.
+
+    Args:
+        width: Source video width
+        height: Source video height
+
+    Returns:
+        List of ResolutionTarget for the detected orientation
+    """
+    if height > width:
+        # Portrait video
+        return PORTRAIT_TARGETS
+    else:
+        # Landscape or square video
+        return LANDSCAPE_TARGETS
+
+
+BITRATE_GRANULARITY_KBPS = 100  # Stop binary search at this granularity
+
+
+@dataclass
+class GCPConfig:
+    project_id: str = ""
+    location: str = ""
+    bucket: str = ""
+    gcs_base_path: str = "bitrate-optimization"
+
+    @classmethod
+    def from_environment(cls) -> "GCPConfig":
+        return cls(
+            project_id=os.environ.get("GCP_PROJECT", "media-cdn-poc-466009"),
+            location=os.environ.get("TRANSCODER_LOCATION", "asia-south1"),
+            bucket=os.environ.get("OUTPUT_BUCKET", "chai-shots-manifests"),
+            gcs_base_path=os.environ.get("GCS_BASE_PATH", "bitrate-optimization"),
+        )
