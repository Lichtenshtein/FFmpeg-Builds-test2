+        "fps": 23.976,
+        "duration": 97.024,
+        "codec": "h264",
+        "bitrate": 6254771  # bits per second
+    }
+```
+
+#### Step 5: Convert to Y4M
+```python
+def _convert_to_y4m(self, input_path, name, width, height):
+    output_file = os.path.join(self.temp_dir, f"{name}.y4m")
+
+    cmd = [
+        self.ffmpeg,
+        "-y",                    # Overwrite output
+        "-i", input_path,        # Input file
+        "-vf", f"scale={width}:{height}",  # Resize if needed
+        "-pix_fmt", "yuv420p",   # Pixel format
+        "-f", "yuv4mpegpipe",    # Output format
+        output_file
+    ]
+
+    subprocess.run(cmd)
+    return output_file  # Returns path to Y4M file
+```
+
+**Why Y4M format?**
+- VMAF needs raw, uncompressed frames to compare
+- Y4M is a simple format: header + raw pixel data
+- Every frame is stored exactly as pixels (no compression)
+
+#### Step 6: Run VMAF Tool
+```python
+def _run_vmaf(self, reference_y4m, distorted_y4m):
+    vmaf_log = os.path.join(self.temp_dir, "vmaf_output.json")
+
+    cmd = [
+        str(VMAF_TOOL),
+        "--reference", reference_y4m,
+        "--distorted", distorted_y4m,
+        "--model", "version=vmaf_v0.6.1",
+        "--output", vmaf_log,
+        "--json",
+        "--threads", "10",        # Use 10 CPU threads
+        "--feature", "psnr",      # Also calculate PSNR
+        "--feature", "float_ssim" # Also calculate SSIM
+    ]
+
+    subprocess.run(cmd)
+
+    # Read results
+    with open(vmaf_log) as f:
+        return json.load(f)
+```
