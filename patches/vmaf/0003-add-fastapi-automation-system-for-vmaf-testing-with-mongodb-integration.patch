+#!/usr/bin/env python3
+"""
+M3U8 Parser - Extract variant streams from HLS playlists.
+"""
+
+import re
+import requests
+from typing import List, Dict, Optional
+from urllib.parse import urljoin
+
+
+def parse_m3u8(m3u8_url: str) -> List[Dict]:
+    """
+    Parse an M3U8 playlist and extract all variant streams.
+
+    Returns a list of variants with resolution, bandwidth, and URL.
+    """
+    try:
+        response = requests.get(m3u8_url, timeout=30)
+        response.raise_for_status()
+        content = response.text
+    except Exception as e:
+        print(f"Error fetching M3U8: {e}")
+        return []
+
+    variants = []
+    lines = content.strip().split('\n')
+
+    # Get base URL for resolving relative paths
+    base_url = m3u8_url.rsplit('/', 1)[0] + '/'
+
+    i = 0
+    while i < len(lines):
+        line = lines[i].strip()
+
+        if line.startswith('#EXT-X-STREAM-INF:'):
+            # Parse stream info
+            info = parse_stream_info(line)
+
+            # Next line should be the URL
+            if i + 1 < len(lines):
+                url_line = lines[i + 1].strip()
+                if not url_line.startswith('#'):
+                    # Resolve relative URL
+                    if not url_line.startswith('http'):
+                        info['url'] = urljoin(base_url, url_line)
+                    else:
+                        info['url'] = url_line
+
+                    variants.append(info)
+                    i += 1
+
+        i += 1
+
+    # Sort by resolution (highest first)
+    variants.sort(key=lambda x: x.get('height', 0), reverse=True)
+
+    return variants
+
+
+def parse_stream_info(line: str) -> Dict:
+    """Parse EXT-X-STREAM-INF line to extract metadata."""
+    info = {}
+
+    # Extract BANDWIDTH
+    bandwidth_match = re.search(r'BANDWIDTH=(\d+)', line)
+    if bandwidth_match:
+        info['bandwidth'] = int(bandwidth_match.group(1))
+        info['bandwidth_mbps'] = round(int(bandwidth_match.group(1)) / 1_000_000, 2)
+
+    # Extract AVERAGE-BANDWIDTH
+    avg_bandwidth_match = re.search(r'AVERAGE-BANDWIDTH=(\d+)', line)
+    if avg_bandwidth_match:
+        info['avg_bandwidth'] = int(avg_bandwidth_match.group(1))
+        info['avg_bandwidth_mbps'] = round(int(avg_bandwidth_match.group(1)) / 1_000_000, 2)
+
+    # Extract RESOLUTION
+    resolution_match = re.search(r'RESOLUTION=(\d+)x(\d+)', line)
+    if resolution_match:
+        info['width'] = int(resolution_match.group(1))
+        info['height'] = int(resolution_match.group(2))
+        info['resolution'] = f"{resolution_match.group(1)}x{resolution_match.group(2)}"
+        # Determine common name (720p, 1080p, etc.)
+        # Use the smaller dimension (works for both landscape and portrait)
+        short_side = min(info['width'], info['height'])
+        if short_side >= 2160:
+            info['quality'] = '4K'
+        elif short_side >= 1080:
+            info['quality'] = '1080p'
+        elif short_side >= 720:
+            info['quality'] = '720p'
+        elif short_side >= 480:
+            info['quality'] = '480p'
+        elif short_side >= 360:
+            info['quality'] = '360p'
+        else:
+            info['quality'] = f'{short_side}p'
+
+    # Extract CODECS
+    codecs_match = re.search(r'CODECS="([^"]+)"', line)
+    if codecs_match:
+        info['codecs'] = codecs_match.group(1)
+        # Determine video codec
+        codecs = codecs_match.group(1)
+        if 'avc1' in codecs:
+            info['video_codec'] = 'H.264'
+        elif 'hvc1' in codecs or 'hev1' in codecs:
+            info['video_codec'] = 'H.265'
+        elif 'vp9' in codecs:
+            info['video_codec'] = 'VP9'
+        elif 'av01' in codecs:
+            info['video_codec'] = 'AV1'
+        else:
+            info['video_codec'] = 'unknown'
+
+    # Extract FRAME-RATE
+    fps_match = re.search(r'FRAME-RATE=([\d.]+)', line)
+    if fps_match:
+        info['fps'] = float(fps_match.group(1))
+
+    return info
+
+
+def get_variant_by_resolution(variants: List[Dict], target_height: int) -> Optional[Dict]:
+    """Get a specific variant by target resolution height."""
+    for variant in variants:
+        if variant.get('height') == target_height:
+            return variant
+    return None
+
+
+def get_variant_by_quality(variants: List[Dict], quality: str) -> Optional[Dict]:
+    """Get a specific variant by quality name (e.g., '720p', '1080p')."""
+    for variant in variants:
+        if variant.get('quality') == quality:
+            return variant
+    return None
+
+
+if __name__ == "__main__":
+    # Test with example URL
+    import sys
+    if len(sys.argv) > 1:
+        url = sys.argv[1]
+        print(f"Parsing: {url}\n")
+        variants = parse_m3u8(url)
+        for v in variants:
+            print(f"  {v.get('quality', 'Unknown'):6} | {v.get('resolution', 'N/A'):10} | "
+                  f"{v.get('avg_bandwidth_mbps', 0):.2f} Mbps | {v.get('video_codec', 'N/A')} | {v.get('url', '')[:50]}...")
+    else:
+        print("Usage: python m3u8_parser.py <m3u8_url>")
