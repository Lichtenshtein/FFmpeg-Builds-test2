+"""
+Pydantic models for API request/response validation
+"""
+from pydantic import BaseModel, HttpUrl, Field
+from typing import Optional, List, Dict
+from datetime import datetime
+
+class ShowResponse(BaseModel):
+    """Show information"""
+    id: str
+    title: str
+    slug: Optional[str] = None
+    description: Optional[str] = None
+    episode_count: Optional[int] = 0
+
+class EpisodeResponse(BaseModel):
+    """Episode information"""
+    id: str
+    episode_number: int
+    title: str
+    description: Optional[str] = None
+    show_id: str
+    show_title: Optional[str] = None
+    duration: Optional[float] = None
+    s3_url: Optional[str] = None  # From vmaf_scores if exists
+    has_vmaf_data: bool = False
+
+class S3UrlResponse(BaseModel):
+    """S3 URL for a specific episode"""
+    show_id: str
+    show_title: str
+    episode_number: int
+    s3_url: Optional[str] = None
+    has_vmaf_data: bool
+    vmaf_test_count: int = 0
+    message: str
+
+class VMAFTestRequest(BaseModel):
+    """Request to run VMAF tests"""
+    show_id: str = Field(..., description="Show ID (e.g., 'akrama_001')")
+    show_title: str = Field(..., description="Show title")
+    episode_number: int = Field(..., description="Episode number", ge=1)
+    s3_url: str = Field(..., description="S3 URL of the video")
+
+    # Optional: Override default config
+    custom_bitrates: Optional[Dict[str, List[float]]] = None
+    custom_codecs: Optional[List[str]] = None
+
+class VMAFTestResponse(BaseModel):
+    """Response after starting VMAF tests"""
+    job_id: str
+    status: str
+    message: str
+    show_id: str
+    episode_number: int
+    estimated_duration_minutes: int = 30
+
+class JobStatus(BaseModel):
+    """Job status information"""
+    job_id: str
+    status: str  # "pending", "processing", "completed", "failed"
+    progress: int  # 0-100
+    message: str
+    started_at: Optional[datetime] = None
+    completed_at: Optional[datetime] = None
+    error: Optional[str] = None
+
+class VMAFResult(BaseModel):
+    """Single VMAF test result"""
+    resolution: str
+    codec: str
+    bitrate_mbps: float
+    vmaf_score: float
+    trail_name: str
+    quality_rating: str  # "Excellent", "Good", "Fair", "Poor"
+
+class VMAFResultsResponse(BaseModel):
+    """Complete VMAF results for an episode"""
+    show_id: str
+    show_title: str
+    episode_number: int
+    s3_url: str
+    total_tests: int
+    results: List[VMAFResult]
+    created_at: datetime
