+import asyncio
+import logging
+import uuid
+
+from fastapi import BackgroundTasks, FastAPI, HTTPException
+
+from .job_store import job_store
+from .models import JobResponse, JobStatus, OptimizeRequest, OptimizeResponse
+from .services.optimizer_service import run_optimization
+
+logging.basicConfig(
+    level=logging.INFO,
+    format="%(asctime)s [%(levelname)s] %(name)s: %(message)s",
+)
+logger = logging.getLogger(__name__)
+
+app = FastAPI(
+    title="Bitrate Optimizer API",
+    description="Find optimal H.264 bitrates per resolution using VMAF phone model analysis.",
+    version="1.0.0",
+)
+
+
+@app.get("/health")
+async def health():
+    return {"status": "healthy"}
+
+
+@app.post("/optimize", status_code=202, response_model=OptimizeResponse)
+async def optimize(request: OptimizeRequest, background_tasks: BackgroundTasks):
+    job_id = uuid.uuid4().hex[:12]
+
+    job_store.create_job(
+        job_id=job_id,
+        show_id=request.show_id,
+        show_title=request.show_title,
+        episode_number=request.episode_number,
+        s3_url=request.s3_url,
+    )
+
+    background_tasks.add_task(_run_optimization_wrapper, job_id, request.s3_url)
+
+    logger.info(f"Job {job_id} created for show={request.show_id}, episode={request.episode_number}")
+
+    return OptimizeResponse(
+        job_id=job_id,
+        status="pending",
+        poll_url=f"/jobs/{job_id}",
+    )
+
+
+@app.get("/jobs/{job_id}", response_model=JobResponse)
+async def get_job(job_id: str):
+    job = job_store.get_job(job_id)
+    if not job:
+        raise HTTPException(status_code=404, detail=f"Job {job_id} not found")
+    return job
+
+
+async def _run_optimization_wrapper(job_id: str, s3_url: str):
+    """Wrapper to run the async optimization in the background task context."""
+    await run_optimization(job_id, s3_url)
