+                        "resolution": f"{ref_info.get('width', 0)}x{ref_info.get('height', 0)}",
+                        "bitrate_mbps": round(ref_info.get("bitrate", 0) / 1_000_000, 2),
+                        "codec": ref_info.get("codec", "unknown"),
+                    }
+
+            except Exception as e:
+                result["h264_resolutions"][quality] = {"error": str(e)}
+
+        # Analyze Other codec variants
+        for variant in other_variants:
+            quality = variant.get("quality", f"{variant.get('height', 0)}p")
+            variant_url = variant.get("url")
+            current += 1
+
+            jobs[job_id]["message"] = f"Analyzing Other {quality} ({current}/{total})..."
+            jobs[job_id]["result"] = {"progress": {"current": current, "total": total}}
+
+            try:
+                output_file = str(RESULTS_FOLDER / f"{job_id}_other_{quality}.json")
+                calculator = VMAFCalculator(
+                    reference_path=reference_path,
+                    distorted_path=variant_url,
+                    output_path=output_file,
+                    model=model,
+                    verbose=False,
+                )
+                calc_result = calculator.calculate()
+
+                result["other_resolutions"][quality] = {
+                    "resolution": variant.get("resolution"),
+                    "width": variant.get("width"),
+                    "height": variant.get("height"),
+                    "video_codec": variant.get("video_codec") or "Other",
+                    "expected_bitrate_mbps": variant.get("avg_bandwidth_mbps"),
+                    "actual_bitrate_mbps": calc_result.get("bitrate_analysis", {}).get("distorted_mbps", 0),
+                    "bpp": calc_result.get("bitrate_analysis", {}).get("distorted_bpp", 0),
+                    "bpp_quality": calc_result.get("bitrate_analysis", {}).get("bpp_quality", "N/A"),
+                    "vmaf_score": calc_result["metrics"]["vmaf"]["score"],
+                    "vmaf_mean": calc_result["metrics"]["vmaf"].get("mean", calc_result["metrics"]["vmaf"]["score"]),
+                    "vmaf_median": calc_result["metrics"]["vmaf"].get("median", 0),
+                    "vmaf_segments": calc_result["metrics"]["vmaf"].get("segments", []),
+                    "psnr": calc_result["metrics"]["psnr"]["y"],
+                    "ssim": calc_result["metrics"]["ssim"],
+                }
+
+                # Store reference info
+                if "reference_info" not in result:
+                    ref_info = calc_result["reference"]["info"]
+                    result["reference_info"] = {
+                        "resolution": f"{ref_info.get('width', 0)}x{ref_info.get('height', 0)}",
+                        "bitrate_mbps": round(ref_info.get("bitrate", 0) / 1_000_000, 2),
+                        "codec": ref_info.get("codec", "unknown"),
+                    }
+
+            except Exception as e:
+                result["other_resolutions"][quality] = {"error": str(e)}
+
+        # Calculate summary and determine winner
+        jobs[job_id]["message"] = "Generating summary..."
+
+        # Calculate average VMAF (Mean) for each codec
+        h264_valid = {k: v for k, v in result["h264_resolutions"].items() if "error" not in v}
+        other_valid = {k: v for k, v in result["other_resolutions"].items() if "error" not in v}
+
+        h264_avg_vmaf = None
+        other_avg_vmaf = None
+        winner = None
+
+        if h264_valid:
+            h264_scores = [v["vmaf_mean"] for v in h264_valid.values()]
+            h264_avg_vmaf = sum(h264_scores) / len(h264_scores)
+
+        if other_valid:
+            other_scores = [v["vmaf_mean"] for v in other_valid.values()]
+            other_avg_vmaf = sum(other_scores) / len(other_scores)
+
+        # Determine winner based on Mean VMAF
+        if h264_avg_vmaf is not None and other_avg_vmaf is not None:
+            if other_avg_vmaf > h264_avg_vmaf:
+                winner = "Other"
+            elif h264_avg_vmaf > other_avg_vmaf:
+                winner = "H.264"
+            else:
+                winner = "Tie"
+        elif h264_avg_vmaf is not None:
+            winner = "H.264"
+        elif other_avg_vmaf is not None:
+            winner = "Other"
+
+        result["summary"] = {
+            "h264_avg_vmaf": round(h264_avg_vmaf, 2) if h264_avg_vmaf else None,
+            "other_avg_vmaf": round(other_avg_vmaf, 2) if other_avg_vmaf else None,
+            "winner": winner,
+        }
+
+        # Save results
+        with open(str(RESULTS_FOLDER / f"{job_id}_multi.json"), "w") as f:
+            json.dump(result, f, indent=2)
+
+        # Save to history - one row per resolution comparing both codecs
+        try:
+            video_name = os.path.basename(reference_path)
+            if "_ref_" in video_name:
+                video_name = video_name.split("_ref_", 1)[1]
+
+            h264_res = result.get("h264_resolutions", {})
+            other_res = result.get("other_resolutions", {})
+
+            # Get all unique quality levels from both codecs
+            all_qualities = set(h264_res.keys()) | set(other_res.keys())
+
+            for quality in all_qualities:
+                h264_data = h264_res.get(quality, {})
+                other_data = other_res.get(quality, {})
+
+                # Skip if both have errors
+                h264_valid = h264_data and "error" not in h264_data
+                other_valid = other_data and "error" not in other_data
+
+                if not h264_valid and not other_valid:
+                    continue
+
+                # Get VMAF Mean scores
+                h264_vmaf = round(h264_data.get("vmaf_mean", h264_data.get("vmaf_score", 0)), 2) if h264_valid else None
+                other_vmaf = round(other_data.get("vmaf_mean", other_data.get("vmaf_score", 0)), 2) if other_valid else None
+
+                # Determine winner for this resolution
+                res_winner = None
+                if h264_vmaf is not None and other_vmaf is not None:
+                    if other_vmaf > h264_vmaf:
+                        res_winner = "Other"
+                    elif h264_vmaf > other_vmaf:
+                        res_winner = "H.264"
+                    else:
+                        res_winner = "Tie"
+                elif h264_vmaf is not None:
+                    res_winner = "H.264"
+                elif other_vmaf is not None:
+                    res_winner = "Other"
+
+                # Get resolution string (prefer from valid data)
+                resolution_str = quality
+                if h264_valid and h264_data.get("resolution"):
+                    resolution_str = h264_data.get("resolution")
+                elif other_valid and other_data.get("resolution"):
+                    resolution_str = other_data.get("resolution")
+
+                history_manager.add_comparison(
+                    video_name=video_name,
+                    resolution=resolution_str,
+                    vmaf_h264=h264_vmaf,
+                    vmaf_h265=other_vmaf,
+                    bitrate_h264=round(h264_data.get("actual_bitrate_mbps", 0), 2) if h264_valid and h264_data.get("actual_bitrate_mbps") else None,
+                    bitrate_h265=round(other_data.get("actual_bitrate_mbps", 0), 2) if other_valid and other_data.get("actual_bitrate_mbps") else None,
+                    psnr_h264=round(h264_data.get("psnr", 0), 2) if h264_valid and h264_data.get("psnr") else None,
+                    psnr_h265=round(other_data.get("psnr", 0), 2) if other_valid and other_data.get("psnr") else None,
+                    ssim_h264=round(h264_data.get("ssim", 0), 4) if h264_valid and h264_data.get("ssim") else None,
+                    ssim_h265=round(other_data.get("ssim", 0), 4) if other_valid and other_data.get("ssim") else None,
+                    model=model,
+                    winner=res_winner,
+                    comparison_type="Codec Comparison",
+                    notes=f"H.264: {h264_data.get('video_codec', 'N/A') if h264_valid else 'N/A'}, Other: {other_data.get('video_codec', 'N/A') if other_valid else 'N/A'}",
+                    graph_h264=h264_data.get("vmaf_segments") if h264_valid else None,
+                    graph_h265=other_data.get("vmaf_segments") if other_valid else None,
+                )
+
+        except Exception as e:
+            print(f"Error saving to history: {e}")
+
+        jobs[job_id]["status"] = "completed"
+        jobs[job_id]["message"] = "All resolutions analyzed"
+        jobs[job_id]["result"] = result
+
+    except Exception as e:
+        jobs[job_id]["status"] = "error"
+        jobs[job_id]["message"] = str(e)
+        jobs[job_id]["result"] = None
+
+
+@app.route("/api/multi-resolution", methods=["POST"])
+def multi_resolution_compare():
+    """Compare all resolutions in both M3U8 playlists (H.264 and Other) against reference."""
+    try:
+        model = request.form.get("model", "vmaf_phone")
+        h264_m3u8_url = request.form.get("h264_m3u8_url", "").strip()
