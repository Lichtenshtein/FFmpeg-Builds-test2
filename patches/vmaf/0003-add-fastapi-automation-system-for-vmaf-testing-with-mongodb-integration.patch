+#!/usr/bin/env python3
+"""
+Codec Comparison Tool - Compare H.264 vs H.265 quality using VMAF.
+
+This script compares the original video against both H.264 and H.265
+encoded versions to determine which codec provides better quality
+at what bitrate.
+
+Usage:
+    python codec_compare.py -r original.mp4 --h264 url_h264.m3u8 --h265 url_h265.m3u8
+"""
+
+import argparse
+import json
+import os
+import sys
+from datetime import datetime
+from typing import Dict, Any, Optional
+
+from vmaf_calculator import VMAFCalculator
+
+
+class CodecComparer:
+    """Compare H.264 vs H.265 codec quality."""
+
+    def __init__(
+        self,
+        reference_path: str,
+        h264_path: Optional[str] = None,
+        h265_path: Optional[str] = None,
+        output_path: str = "codec_comparison.json",
+        model: str = "vmaf_phone",
+        verbose: bool = False,
+    ):
+        self.reference_path = reference_path
+        self.h264_path = h264_path
+        self.h265_path = h265_path
+        self.output_path = output_path
+        self.model = model
+        self.verbose = verbose
+        self.results = {}
+
+    def _run_single_comparison(self, distorted_path: str, codec_name: str) -> Dict[str, Any]:
+        """Run VMAF comparison for a single codec."""
+        print(f"\n{'='*60}")
+        print(f"Analyzing {codec_name}...")
+        print(f"{'='*60}")
+
+        output_file = self.output_path.replace(".json", f"_{codec_name.lower()}.json")
+
+        calculator = VMAFCalculator(
+            reference_path=self.reference_path,
+            distorted_path=distorted_path,
+            output_path=output_file,
+            model=self.model,
+            verbose=self.verbose,
+        )
+
+        result = calculator.calculate()
+        return result
+
+    def compare(self) -> Dict[str, Any]:
+        """Run comparison for all codecs."""
+        comparison = {
+            "timestamp": datetime.now().isoformat(),
+            "reference": self.reference_path,
+            "model": self.model,
+            "codecs": {},
+        }
+
+        # Compare H.264
+        if self.h264_path:
+            try:
+                h264_result = self._run_single_comparison(self.h264_path, "H.264")
+                comparison["codecs"]["h264"] = {
+                    "path": self.h264_path,
+                    "vmaf_score": h264_result["metrics"]["vmaf"]["score"],
+                    "vmaf_min": h264_result["metrics"]["vmaf"]["min"],
+                    "vmaf_max": h264_result["metrics"]["vmaf"]["max"],
+                    "psnr": h264_result["metrics"]["psnr"]["y"],
+                    "ssim": h264_result["metrics"]["ssim"],
+                    "bitrate_mbps": h264_result.get("bitrate_analysis", {}).get("distorted_mbps", 0),
+                    "resolution": f"{h264_result['distorted']['info'].get('width', 0)}x{h264_result['distorted']['info'].get('height', 0)}",
+                    "codec": h264_result["distorted"]["info"].get("codec", "unknown"),
+                    "full_result": h264_result,
+                }
+            except Exception as e:
+                print(f"Error analyzing H.264: {e}")
+                comparison["codecs"]["h264"] = {"error": str(e)}
+
+        # Compare H.265
+        if self.h265_path:
+            try:
+                h265_result = self._run_single_comparison(self.h265_path, "H.265")
+                comparison["codecs"]["h265"] = {
+                    "path": self.h265_path,
+                    "vmaf_score": h265_result["metrics"]["vmaf"]["score"],
+                    "vmaf_min": h265_result["metrics"]["vmaf"]["min"],
+                    "vmaf_max": h265_result["metrics"]["vmaf"]["max"],
+                    "psnr": h265_result["metrics"]["psnr"]["y"],
+                    "ssim": h265_result["metrics"]["ssim"],
+                    "bitrate_mbps": h265_result.get("bitrate_analysis", {}).get("distorted_mbps", 0),
+                    "resolution": f"{h265_result['distorted']['info'].get('width', 0)}x{h265_result['distorted']['info'].get('height', 0)}",
+                    "codec": h265_result["distorted"]["info"].get("codec", "unknown"),
+                    "full_result": h265_result,
+                }
+            except Exception as e:
+                print(f"Error analyzing H.265: {e}")
+                comparison["codecs"]["h265"] = {"error": str(e)}
+
+        # Add reference info
+        if comparison["codecs"]:
+            first_result = list(comparison["codecs"].values())[0]
+            if "full_result" in first_result:
+                ref_info = first_result["full_result"]["reference"]["info"]
+                comparison["reference_info"] = {
+                    "resolution": f"{ref_info.get('width', 0)}x{ref_info.get('height', 0)}",
+                    "bitrate_mbps": round(ref_info.get("bitrate", 0) / 1_000_000, 2),
+                    "codec": ref_info.get("codec", "unknown"),
+                    "duration": ref_info.get("duration", 0),
+                }
+
+        # Calculate comparison metrics
+        comparison["comparison"] = self._calculate_comparison(comparison["codecs"])
+
+        # Save results
+        # Remove full_result to keep JSON clean
+        clean_comparison = json.loads(json.dumps(comparison))
+        for codec in clean_comparison.get("codecs", {}).values():
+            if isinstance(codec, dict) and "full_result" in codec:
+                del codec["full_result"]
+
+        with open(self.output_path, "w") as f:
+            json.dump(clean_comparison, f, indent=2)
+
+        print(f"\nResults saved to: {self.output_path}")
+
+        self.results = comparison
+        return comparison
+
+    def _calculate_comparison(self, codecs: Dict) -> Dict[str, Any]:
+        """Calculate comparison metrics between codecs."""
+        comparison = {}
+
+        h264 = codecs.get("h264", {})
+        h265 = codecs.get("h265", {})
+
+        if "error" not in h264 and "error" not in h265 and h264 and h265:
+            # VMAF comparison
+            vmaf_diff = h265.get("vmaf_score", 0) - h264.get("vmaf_score", 0)
+            comparison["vmaf_difference"] = round(vmaf_diff, 2)
+            comparison["vmaf_winner"] = "H.265" if vmaf_diff > 0 else "H.264" if vmaf_diff < 0 else "Tie"
+
+            # Bitrate comparison
+            h264_bitrate = h264.get("bitrate_mbps", 0)
+            h265_bitrate = h265.get("bitrate_mbps", 0)
+            if h264_bitrate and h265_bitrate:
+                bitrate_savings = ((h264_bitrate - h265_bitrate) / h264_bitrate) * 100
+                comparison["h265_bitrate_savings_percent"] = round(bitrate_savings, 1)
+
+            # Efficiency comparison (VMAF per Mbps)
+            h264_efficiency = h264.get("vmaf_score", 0) / h264_bitrate if h264_bitrate else 0
+            h265_efficiency = h265.get("vmaf_score", 0) / h265_bitrate if h265_bitrate else 0
+            comparison["h264_efficiency"] = round(h264_efficiency, 1)
+            comparison["h265_efficiency"] = round(h265_efficiency, 1)
+            comparison["efficiency_winner"] = "H.265" if h265_efficiency > h264_efficiency else "H.264"
+
+            # Overall recommendation
+            if h265.get("vmaf_score", 0) >= h264.get("vmaf_score", 0) and h265_bitrate <= h264_bitrate:
+                comparison["recommendation"] = "H.265 - Better quality at same or lower bitrate"
+            elif h265.get("vmaf_score", 0) >= 90 and bitrate_savings > 20:
+                comparison["recommendation"] = "H.265 - Good quality with significant bandwidth savings"
+            elif h264.get("vmaf_score", 0) > h265.get("vmaf_score", 0):
+                comparison["recommendation"] = "H.264 - Better quality in this encoding"
+            else:
+                comparison["recommendation"] = "H.265 - Better efficiency overall"
+
+        return comparison
+
+    def print_summary(self):
+        """Print comparison summary."""
+        if not self.results:
+            print("No results to display. Run compare() first.")
+            return
+
+        codecs = self.results.get("codecs", {})
+        comparison = self.results.get("comparison", {})
+        ref_info = self.results.get("reference_info", {})
+
+        print("\n" + "=" * 70)
+        print("CODEC COMPARISON RESULTS")
+        print("=" * 70)
+
+        # Reference info
+        print(f"\n📁 REFERENCE (Original)")
+        print(f"   Resolution: {ref_info.get('resolution', 'N/A')}")
+        print(f"   Bitrate:    {ref_info.get('bitrate_mbps', 'N/A')} Mbps")
+        print(f"   Codec:      {ref_info.get('codec', 'N/A')}")
+
+        # H.264 results
+        if "h264" in codecs and "error" not in codecs["h264"]:
+            h264 = codecs["h264"]
+            print(f"\n🎬 H.264 (AVC)")
+            print(f"   VMAF Score: {h264['vmaf_score']:.2f}")
+            print(f"   Bitrate:    {h264['bitrate_mbps']:.2f} Mbps")
+            print(f"   PSNR:       {h264['psnr']:.2f} dB")
+            print(f"   SSIM:       {h264['ssim']:.4f}")
+            print(f"   Resolution: {h264['resolution']}")
+
+        # H.265 results
+        if "h265" in codecs and "error" not in codecs["h265"]:
+            h265 = codecs["h265"]
+            print(f"\n🎬 H.265 (HEVC)")
+            print(f"   VMAF Score: {h265['vmaf_score']:.2f}")
+            print(f"   Bitrate:    {h265['bitrate_mbps']:.2f} Mbps")
+            print(f"   PSNR:       {h265['psnr']:.2f} dB")
+            print(f"   SSIM:       {h265['ssim']:.4f}")
+            print(f"   Resolution: {h265['resolution']}")
+
+        # Comparison
+        if comparison:
+            print(f"\n" + "-" * 70)
+            print("📊 COMPARISON")
+            print("-" * 70)
+
+            if "vmaf_difference" in comparison:
+                diff = comparison["vmaf_difference"]
+                winner = comparison["vmaf_winner"]
+                print(f"   VMAF Difference:    {diff:+.2f} points ({winner} wins)")
+
+            if "h265_bitrate_savings_percent" in comparison:
+                savings = comparison["h265_bitrate_savings_percent"]
+                print(f"   H.265 Bitrate Savings: {savings:.1f}%")
+
+            if "h264_efficiency" in comparison:
+                print(f"   H.264 Efficiency:   {comparison['h264_efficiency']:.1f} VMAF/Mbps")
+                print(f"   H.265 Efficiency:   {comparison['h265_efficiency']:.1f} VMAF/Mbps")
+                print(f"   Efficiency Winner:  {comparison['efficiency_winner']}")
+
+            if "recommendation" in comparison:
+                print(f"\n   ✅ RECOMMENDATION: {comparison['recommendation']}")
+
+        print("\n" + "=" * 70)
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Compare H.264 vs H.265 codec quality using VMAF",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="""
+Examples:
+  # Compare both codecs
+  python codec_compare.py -r original.mp4 --h264 h264_stream.m3u8 --h265 h265_stream.m3u8
+
+  # Compare only H.265
+  python codec_compare.py -r original.mp4 --h265 h265_stream.m3u8
+
+  # Use phone model (recommended for mobile viewing)
+  python codec_compare.py -r original.mp4 --h264 h264.m3u8 --h265 h265.m3u8 -m vmaf_phone
+        """,
+    )
+
+    parser.add_argument(
+        "-r", "--reference",
+        required=True,
+        help="Path to reference video (original MP4)",
+    )
+    parser.add_argument(
+        "--h264",
+        help="Path or URL to H.264 encoded video",
+    )
+    parser.add_argument(
+        "--h265",
+        help="Path or URL to H.265 encoded video",
+    )
+    parser.add_argument(
+        "-o", "--output",
+        default="codec_comparison.json",
+        help="Output JSON file path",
+    )
+    parser.add_argument(
+        "-m", "--model",
+        choices=["vmaf_v0.6.1", "vmaf_4k", "vmaf_b", "vmaf_phone"],
+        default="vmaf_phone",
+        help="VMAF model to use (default: vmaf_phone)",
+    )
+    parser.add_argument(
+        "-v", "--verbose",
+        action="store_true",
+        help="Enable verbose output",
+    )
+
+    args = parser.parse_args()
+
+    if not args.h264 and not args.h265:
+        parser.error("At least one of --h264 or --h265 must be provided")
+
+    if not os.path.exists(args.reference):
+        print(f"ERROR: Reference file not found: {args.reference}")
+        sys.exit(1)
+
+    comparer = CodecComparer(
+        reference_path=args.reference,
+        h264_path=args.h264,
+        h265_path=args.h265,
+        output_path=args.output,
+        model=args.model,
+        verbose=args.verbose,
+    )
+
+    comparer.compare()
+    comparer.print_summary()
+
+
+if __name__ == "__main__":
+    main()
