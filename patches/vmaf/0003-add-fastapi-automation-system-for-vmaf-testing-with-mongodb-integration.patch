+#!/usr/bin/env python3
+"""
+History Manager - Save and retrieve VMAF comparison results.
+"""
+
+import json
+import os
+from datetime import datetime
+from pathlib import Path
+from typing import Dict, List, Any, Optional
+
+HISTORY_FILE = Path(__file__).parent / "comparison_history.json"
+
+
+class HistoryManager:
+    """Manage comparison history storage."""
+
+    def __init__(self, history_file: Path = HISTORY_FILE):
+        self.history_file = history_file
+        self._ensure_file_exists()
+
+    def _ensure_file_exists(self):
+        """Create history file if it doesn't exist."""
+        if not self.history_file.exists():
+            self._save_data({"comparisons": []})
+
+    def _load_data(self) -> Dict:
+        """Load history data from file."""
+        try:
+            with open(self.history_file, "r") as f:
+                return json.load(f)
+        except (json.JSONDecodeError, FileNotFoundError):
+            return {"comparisons": []}
+
+    def _save_data(self, data: Dict):
+        """Save history data to file."""
+        with open(self.history_file, "w") as f:
+            json.dump(data, f, indent=2)
+
+    def add_comparison(
+        self,
+        video_name: str,
+        resolution: str,
+        vmaf_h264: Optional[float] = None,
+        vmaf_h265: Optional[float] = None,
+        bitrate_h264: Optional[float] = None,
+        bitrate_h265: Optional[float] = None,
+        psnr_h264: Optional[float] = None,
+        psnr_h265: Optional[float] = None,
+        ssim_h264: Optional[float] = None,
+        ssim_h265: Optional[float] = None,
+        model: str = "vmaf_phone",
+        winner: Optional[str] = None,
+        notes: str = "",
+        comparison_type: str = "Codec Comparison",
+        graph_h264: Optional[List] = None,
+        graph_h265: Optional[List] = None,
+    ) -> Dict:
+        """Add a new comparison to history."""
+        data = self._load_data()
+
+        # Generate ID
+        comparison_id = len(data["comparisons"]) + 1
+
+        # Determine winner if both scores exist
+        if winner is None and vmaf_h264 is not None and vmaf_h265 is not None:
+            if vmaf_h265 > vmaf_h264:
+                winner = "H.265"
+            elif vmaf_h264 > vmaf_h265:
+                winner = "H.264"
+            else:
+                winner = "Tie"
+
+        comparison = {
+            "id": comparison_id,
+            "timestamp": datetime.now().isoformat(),
+            "type": comparison_type,
+            "video_name": video_name,
+            "resolution": resolution,
+            "model": model,
+            "vmaf_h264": round(vmaf_h264, 2) if vmaf_h264 is not None else None,
+            "vmaf_h265": round(vmaf_h265, 2) if vmaf_h265 is not None else None,
+            "bitrate_h264": round(bitrate_h264, 2) if bitrate_h264 is not None else None,
+            "bitrate_h265": round(bitrate_h265, 2) if bitrate_h265 is not None else None,
+            "psnr_h264": round(psnr_h264, 2) if psnr_h264 is not None else None,
+            "psnr_h265": round(psnr_h265, 2) if psnr_h265 is not None else None,
+            "ssim_h264": round(ssim_h264, 4) if ssim_h264 is not None else None,
+            "ssim_h265": round(ssim_h265, 4) if ssim_h265 is not None else None,
+            "winner": winner,
+            "notes": notes,
+            "graph_h264": graph_h264,
+            "graph_h265": graph_h265,
+        }
+
+        data["comparisons"].append(comparison)
+        self._save_data(data)
+
+        return comparison
+
+    def get_all_comparisons(self) -> List[Dict]:
+        """Get all comparisons, newest first."""
+        data = self._load_data()
+        return sorted(data["comparisons"], key=lambda x: x["id"], reverse=True)
+
+    def get_comparison(self, comparison_id: int) -> Optional[Dict]:
+        """Get a specific comparison by ID."""
+        data = self._load_data()
+        for comp in data["comparisons"]:
+            if comp["id"] == comparison_id:
+                return comp
+        return None
+
+    def delete_comparison(self, comparison_id: int) -> bool:
+        """Delete a comparison by ID."""
+        data = self._load_data()
+        original_length = len(data["comparisons"])
+        data["comparisons"] = [c for c in data["comparisons"] if c["id"] != comparison_id]
+
+        if len(data["comparisons"]) < original_length:
+            self._save_data(data)
+            return True
+        return False
+
+    def clear_history(self):
+        """Clear all history."""
+        self._save_data({"comparisons": []})
+
+    def get_statistics(self) -> Dict:
+        """Get statistics from all comparisons."""
+        comparisons = self.get_all_comparisons()
+
+        if not comparisons:
+            return {"total": 0}
+
+        h264_scores = [c["vmaf_h264"] for c in comparisons if c["vmaf_h264"] is not None]
+        h265_scores = [c["vmaf_h265"] for c in comparisons if c["vmaf_h265"] is not None]
+
+        h264_wins = sum(1 for c in comparisons if c["winner"] == "H.264")
+        h265_wins = sum(1 for c in comparisons if c["winner"] == "H.265")
+
+        return {
+            "total": len(comparisons),
+            "h264_avg_vmaf": round(sum(h264_scores) / len(h264_scores), 2) if h264_scores else None,
+            "h265_avg_vmaf": round(sum(h265_scores) / len(h265_scores), 2) if h265_scores else None,
+            "h264_wins": h264_wins,
+            "h265_wins": h265_wins,
+            "ties": len(comparisons) - h264_wins - h265_wins,
+        }
+
+
+# Global instance
+history_manager = HistoryManager()
