+#!/usr/bin/env python3
+"""
+Example: VMAF Calculator with MongoDB Integration
+
+This script demonstrates how to calculate VMAF scores and automatically
+store them in MongoDB with show metadata.
+"""
+
+import sys
+from pathlib import Path
+
+# Add vmaf_calculator to path
+sys.path.insert(0, str(Path(__file__).parent / "vmaf_calculator"))
+
+from vmaf_calculator import VMAFCalculator
+
+# MongoDB connection URI
+MONGO_URI = 'mongodb+srv://chai-shots-prod:wwCuI7ThUjIemQD1@prodcluster.mfhti8.mongodb.net/master?retryWrites=true&w=majority'
+
+
+def example_with_mongodb():
+    """Example: Calculate VMAF and store to MongoDB"""
+
+    # Show metadata for MongoDB storage
+    show_metadata = {
+        "s3_link_name": "s3://chai-shots-videos/shows/breaking-bad/s01e01.mp4",
+        "show_title": "Breaking Bad",
+        "episode_number": 1,
+        "show_id": "bb_001",
