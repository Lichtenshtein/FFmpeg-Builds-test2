+import logging
+import time
+
+from google.cloud.video import transcoder_v1
+
+from ..config import GCPConfig
+
+logger = logging.getLogger(__name__)
+
+_transcoder_client = None
+
+
+def _get_transcoder_client():
+    global _transcoder_client
+    if _transcoder_client is None:
+        _transcoder_client = transcoder_v1.TranscoderServiceClient()
+    return _transcoder_client
+
+
+def create_single_resolution_job(
+    input_uri: str,
+    output_uri: str,
+    width: int,
+    height: int,
+    bitrate_kbps: int,
+    config: GCPConfig,
+) -> str:
+    """Create a GCP Transcoder job for a single resolution/bitrate.
+
+    Returns the full job name (resource path).
+    """
+    bitrate_bps = bitrate_kbps * 1000
+
+    elementary_streams = [
+        {
+            "key": "video_stream_0",
+            "video_stream": {
+                "h264": {
+                    "width_pixels": width,
+                    "height_pixels": height,
+                    "bitrate_bps": bitrate_bps,
+                    "frame_rate": 30,
+                }
+            },
+        },
+        {
+            "key": "audio_stream_0",
+            "audio_stream": {
+                "codec": "aac",
+                "bitrate_bps": 128000,
+            },
+        },
+    ]
+
+    mux_streams = [
+        {
+            "key": "mux0",
+            "container": "ts",
+            "elementary_streams": ["video_stream_0", "audio_stream_0"],
+            "segment_settings": {
+                "segment_duration": "3s",
+                "individual_segments": True,
+            },
+        }
+    ]
+
+    job_config = {
+        "inputs": [{"key": "input0", "uri": input_uri}],
+        "edit_list": [{"key": "atom0", "inputs": ["input0"]}],
+        "elementary_streams": elementary_streams,
+        "mux_streams": mux_streams,
+        "manifests": [
+            {
+                "file_name": "output.m3u8",
+                "type_": transcoder_v1.Manifest.ManifestType.HLS,
+                "mux_streams": ["mux0"],
+            }
+        ],
+    }
+
+    parent = f"projects/{config.project_id}/locations/{config.location}"
+
+    logger.info(
+        f"Creating transcoder job: {width}x{height} @ {bitrate_kbps}kbps, output={output_uri}"
+    )
+
+    job = _get_transcoder_client().create_job(
+        parent=parent,
+        job={"output_uri": output_uri, "config": job_config},
+    )
+
+    logger.info(f"Transcoder job created: {job.name}")
+    return job.name
+
+
+def wait_for_job(job_name: str, timeout_seconds: int = 1800, poll_interval: int = 10) -> bool:
+    """Poll a transcoder job until it completes or fails.
+
+    Returns True if succeeded, raises on failure/timeout.
+    """
+    start = time.time()
+    while time.time() - start < timeout_seconds:
+        job = _get_transcoder_client().get_job(name=job_name)
+        state = job.state
+
+        if state == transcoder_v1.Job.ProcessingState.SUCCEEDED:
+            logger.info(f"Transcoder job succeeded: {job_name}")
+            return True
+        elif state == transcoder_v1.Job.ProcessingState.FAILED:
+            error_msg = job.error.message if job.error else "Unknown error"
+            raise RuntimeError(f"Transcoder job failed: {job_name} - {error_msg}")
+        elif state == transcoder_v1.Job.ProcessingState.PENDING:
+            logger.debug(f"Job {job_name} still pending...")
+        elif state == transcoder_v1.Job.ProcessingState.RUNNING:
+            logger.debug(f"Job {job_name} running...")
+
+        time.sleep(poll_interval)
+
+    raise TimeoutError(f"Transcoder job timed out after {timeout_seconds}s: {job_name}")
