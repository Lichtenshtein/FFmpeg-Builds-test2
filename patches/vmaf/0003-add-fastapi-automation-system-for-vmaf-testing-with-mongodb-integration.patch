+    allow_credentials=True,
+    allow_methods=["*"],
+    allow_headers=["*"],
+)
+
+# MongoDB client (global connection)
+mongo_client = MongoClient(config.MONGO_URI)
+db = mongo_client[config.DB_NAME]
+
+# In-memory job tracking (use Redis for production)
+jobs_db = {}
+
+
+@app.get("/")
+async def root():
+    """API health check"""
+    return {
+        "status": "online",
+        "message": "VMAF Testing API is running",
+        "docs": "/docs",
+        "version": config.API_VERSION
+    }
+
+
+@app.get("/api/shows", response_model=List[ShowResponse])
+async def get_shows(skip: int = 0, limit: int = 100):
+    """
+    Get list of all shows from showcache collection
+
+    Query Parameters:
+    - skip: Number of records to skip (pagination)
+    - limit: Maximum number of records to return
+    """
+    try:
+        shows = list(db.showcache.find({}, {"_id": 0}).skip(skip).limit(limit))
+
+        result = []
+        for show in shows:
+            # Episode count is already in showcache
+            episode_count = show.get("episode_count", len(show.get("episodes", [])))
+
+            result.append(ShowResponse(
+                id=show.get("id", ""),
+                title=show.get("title", "Untitled"),
+                slug=show.get("slug", ""),
+                description=show.get("description", ""),
+                episode_count=episode_count
+            ))
+
+        return result
+
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"Error fetching shows: {str(e)}")
+
+
+@app.get("/api/shows/{show_id}/episodes", response_model=List[EpisodeResponse])
+async def get_episodes(show_id: str):
+    """
+    Get all episodes for a specific show from showcache collection
+
+    Path Parameters:
+    - show_id: Show UUID from MongoDB
+    """
+    try:
+        # Get show info from showcache
+        show = db.showcache.find_one({"id": show_id}, {"_id": 0})
+        if not show:
+            raise HTTPException(status_code=404, detail=f"Show not found: {show_id}")
+
+        show_title = show.get("title", "Unknown")
+        episodes = show.get("episodes", [])
+
+        result = []
+        for ep in episodes:
+            episode_num = ep.get("episode_number", 0)
+
+            # Get S3 URL from episode first (preferred source)
+            s3_url = ep.get("s3_url")
+
+            # Check if VMAF data exists for this episode
+            vmaf_data = db.vmaf_scores.find_one({
+                "show_id": show_id,
+                "episode_number": episode_num
+            })
+
+            has_vmaf = vmaf_data is not None
+
+            # Fallback to vmaf_scores if s3_url not in episode
+            if not s3_url and vmaf_data:
+                s3_url = vmaf_data.get("s3_link_name")
+
+            result.append(EpisodeResponse(
+                id=ep.get("id", ""),
+                episode_number=episode_num,
+                title=ep.get("title", f"Episode {episode_num}"),
+                description=ep.get("description", ""),
+                show_id=show_id,
+                show_title=show_title,
+                duration=ep.get("duration"),
+                s3_url=s3_url,
+                has_vmaf_data=has_vmaf
+            ))
+
+        # Sort by episode number
+        result.sort(key=lambda x: x.episode_number)
+
+        return result
+
+    except HTTPException:
+        raise
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"Error fetching episodes: {str(e)}")
+
+
+@app.get("/api/episodes/{show_id}/{episode_number}/s3-url", response_model=S3UrlResponse)
+async def get_s3_url(show_id: str, episode_number: int):
+    """
+    Get S3 URL for a specific episode
+
+    Path Parameters:
+    - show_id: Show ID (e.g., 'akrama_001' or UUID)
+    - episode_number: Episode number
+    """
+    try:
+        # First check showcache for S3 URL (primary source)
+        show = db.showcache.find_one({"id": show_id}, {"_id": 0})
+
+        if not show:
+            raise HTTPException(status_code=404, detail=f"Show not found: {show_id}")
+
+        show_title = show.get("title", "Unknown")
+        episodes = show.get("episodes", [])
+        episode = next((ep for ep in episodes if ep.get("episode_number") == episode_number), None)
+
+        if not episode:
+            raise HTTPException(
+                status_code=404,
+                detail=f"Episode not found: show_id={show_id}, episode={episode_number}"
+            )
+
+        # Get S3 URL from episode (primary source)
+        s3_url = episode.get("s3_url")
+
+        # Check if VMAF data exists
+        vmaf_data = db.vmaf_scores.find_one({
+            "show_id": show_id,
+            "episode_number": episode_number
+        })
+
+        has_vmaf = vmaf_data is not None
+        test_count = 0
+
+        if vmaf_data:
+            test_count = db.vmaf_scores.count_documents({
+                "show_id": show_id,
+                "episode_number": episode_number
+            })
+            # Fallback to vmaf_scores if s3_url not in episode
+            if not s3_url:
+                s3_url = vmaf_data.get("s3_link_name")
+
+        if s3_url:
+            if has_vmaf:
+                message = f"S3 URL found in showcache. {test_count} VMAF tests already completed."
+            else:
+                message = f"S3 URL found in showcache. No VMAF tests run yet."
+        else:
+            message = "Episode exists but no S3 URL found. Please provide S3 URL to run tests."
+
+        return S3UrlResponse(
+            show_id=show_id,
+            show_title=show_title,
+            episode_number=episode_number,
+            s3_url=s3_url,
+            has_vmaf_data=has_vmaf,
+            vmaf_test_count=test_count,
+            message=message
+        )
+
+    except HTTPException:
+        raise
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"Error fetching S3 URL: {str(e)}")
+
+
+@app.post("/api/vmaf/test", response_model=VMAFTestResponse)
+async def run_vmaf_test(request: VMAFTestRequest, background_tasks: BackgroundTasks):
+    """
+    Start VMAF testing for a video
+
+    Request Body:
+    - show_id: Show identifier
+    - show_title: Show title
+    - episode_number: Episode number
+    - s3_url: S3 URL of the video file
+    - custom_bitrates: (Optional) Override default bitrates
+    - custom_codecs: (Optional) Override default codecs
+    """
+    try:
+        # Generate unique job ID
+        job_id = str(uuid.uuid4())
+
+        # Create job record
+        jobs_db[job_id] = {
+            "job_id": job_id,
+            "status": "pending",
+            "progress": 0,
+            "message": "Job created, waiting to start...",
+            "show_id": request.show_id,
+            "episode_number": request.episode_number,
+            "s3_url": request.s3_url,
+            "started_at": datetime.utcnow(),
+            "completed_at": None,
+            "error": None
+        }
+
+        # Start background task
+        background_tasks.add_task(
+            run_vmaf_tests_background,
+            job_id=job_id,
+            request=request
+        )
+
+        return VMAFTestResponse(
+            job_id=job_id,
+            status="pending",
+            message="VMAF tests started. Use /api/vmaf/status/{job_id} to check progress.",
+            show_id=request.show_id,
+            episode_number=request.episode_number,
+            estimated_duration_minutes=30
+        )
+
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"Error starting VMAF tests: {str(e)}")
+
+
+@app.get("/api/vmaf/status/{job_id}", response_model=JobStatus)
+async def get_job_status(job_id: str):
+    """
+    Check status of a VMAF test job
+
+    Path Parameters:
+    - job_id: Job UUID returned from /api/vmaf/test
+    """
+    if job_id not in jobs_db:
+        raise HTTPException(status_code=404, detail=f"Job not found: {job_id}")
+
+    job = jobs_db[job_id]
+
+    return JobStatus(
+        job_id=job["job_id"],
+        status=job["status"],
+        progress=job["progress"],
+        message=job["message"],
+        started_at=job["started_at"],
+        completed_at=job["completed_at"],
+        error=job["error"]
+    )
+
+
+@app.get("/api/vmaf/results/{show_id}/{episode_number}", response_model=VMAFResultsResponse)
+async def get_vmaf_results(show_id: str, episode_number: int):
+    """
+    Get VMAF test results for a specific episode
+
+    Path Parameters:
+    - show_id: Show identifier
+    - episode_number: Episode number
+    """
+    try:
+        results = list(db.vmaf_scores.find({
+            "show_id": show_id,
+            "episode_number": episode_number
+        }, {"_id": 0}))
+
+        if not results:
+            raise HTTPException(
+                status_code=404,
+                detail=f"No VMAF results found for show_id={show_id}, episode={episode_number}"
+            )
+
+        # Parse results
+        vmaf_results = []
+        for r in results:
+            # Quality rating
+            vmaf = r.get("vmaf_score", 0)
+            if vmaf >= 93:
+                quality = "Excellent"
+            elif vmaf >= 85:
+                quality = "Good"
+            elif vmaf >= 70:
+                quality = "Fair"
+            else:
+                quality = "Poor"
+
+            vmaf_results.append(VMAFResult(
+                resolution=r.get("resolution", "unknown"),
+                codec=r.get("codec", "unknown").upper(),
+                bitrate_mbps=round(r.get("trail_bitrate", 0) / 1_000_000, 2),
+                vmaf_score=vmaf,
+                trail_name=r.get("trail_name", "unknown"),
+                quality_rating=quality
+            ))
+
+        # Sort by resolution, codec, bitrate
+        vmaf_results.sort(key=lambda x: (x.resolution, x.codec, -x.bitrate_mbps))
+
+        first = results[0]
+        return VMAFResultsResponse(
+            show_id=show_id,
+            show_title=first.get("show_title", "Unknown"),
+            episode_number=episode_number,
+            s3_url=first.get("s3_link_name", ""),
+            total_tests=len(results),
+            results=vmaf_results,
+            created_at=first.get("created_at", datetime.utcnow())
+        )
+
+    except HTTPException:
+        raise
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"Error fetching VMAF results: {str(e)}")
+
+
+# Background task function
+async def run_vmaf_tests_background(job_id: str, request: VMAFTestRequest):
+    """
+    Background task to run VMAF tests
+    This will call the existing shell script
+    """
+    import subprocess
+    import os
+
+    try:
+        # Update job status
+        jobs_db[job_id]["status"] = "processing"
+        jobs_db[job_id]["progress"] = 5
+        jobs_db[job_id]["message"] = "Downloading video..."
+
+        # Create temporary script
+        script_path = f"/tmp/vmaf_test_{job_id}.sh"
+
+        # Get bitrates and codecs
+        bitrates = request.custom_bitrates or config.BITRATES
+        codecs = request.custom_codecs or config.CODECS
+
+        # Generate complete test script with all resolutions/bitrates/codecs
+        transcode_cmds = []
+        vmaf_cmds = []
+
+        # Generate commands for each resolution
+        for res_name, res_bitrates in bitrates.items():
+            res_config = config.RESOLUTIONS.get(res_name, {})
+            width = res_config.get("width", 1080)
+            height = res_config.get("height", 1920)
+            res_label = f"{width}x{height}"
+
+            for bitrate in res_bitrates:
+                for codec in codecs:
+                    codec_lib = "libx264" if codec == "h264" else "libx265"
+                    output_file = f"$OUTPUT_DIR/{res_name}-{codec}-{bitrate}mbps.mp4"
+                    y4m_file = f"$OUTPUT_DIR/{res_name}-{codec}-{bitrate}mbps.y4m"
+
+                    # Transcode command
+                    transcode_cmds.append(f"""
+# Transcode {res_name} {codec.upper()} @ {bitrate} Mbps
+echo "Transcoding {res_name} {codec.upper()} @ {bitrate} Mbps..."
+ffmpeg -i "$OUTPUT_DIR/original.mp4" -vf "scale={width}:{height}" \\
+    -c:v {codec_lib} -preset medium -b:v {bitrate}M \\
+    -c:a aac -b:a 128k "{output_file}" -y -loglevel error -stats
+""")
+
+                    # VMAF command
+                    trail_name = f"{res_name}_{codec}_{bitrate}mbps"
+                    bitrate_bps = int(bitrate * 1_000_000)
+                    vmaf_cmds.append(f"""
+# VMAF: {res_name} {codec.upper()} @ {bitrate} Mbps
+echo "Running VMAF for {res_name} {codec.upper()} @ {bitrate} Mbps..."
+python3 /Users/cstech-05/Desktop/vmaf/vmaf/run_vmaf.py \\
+    --reference "$OUTPUT_DIR/original.mp4" \\
+    --distorted "{output_file}" \\
+    --show-id "$SHOW_ID" \\
+    --show-title "$SHOW_TITLE" \\
+    --episode "$EPISODE" \\
+    --trail-name "{trail_name}" \\
+    --codec "{codec}" \\
+    --s3-link "$ORIGINAL"
+""")
+
+        script_content = f"""#!/bin/bash
+set -e
+
+ORIGINAL="{request.s3_url}"
+SHOW_ID="{request.show_id}"
+SHOW_TITLE="{request.show_title}"
+EPISODE={request.episode_number}
+OUTPUT_DIR="/tmp/vmaf_job_{job_id}"
+
+mkdir -p "$OUTPUT_DIR"
+
+echo "=========================================="
+echo "VMAF Testing: $SHOW_TITLE Episode $EPISODE"
+echo "=========================================="
+
+echo "Step 1: Downloading video..."
+curl -L "$ORIGINAL" -o "$OUTPUT_DIR/original.mp4"
+
+echo ""
+echo "Step 2: Transcoding videos..."
+{''.join(transcode_cmds)}
+
+echo ""
+echo "Step 3: Running VMAF calculations..."
+{''.join(vmaf_cmds)}
+
+echo ""
+echo "=========================================="
+echo "All tests complete!"
+echo "=========================================="
+
+# Cleanup transcoded files to save space
+rm -f "$OUTPUT_DIR"/*.mp4
+rm -f "$OUTPUT_DIR"/*.y4m
+"""
+
+        with open(script_path, 'w') as f:
+            f.write(script_content)
+
+        os.chmod(script_path, 0o755)
+
+        # Update progress
+        jobs_db[job_id]["progress"] = 10
+        jobs_db[job_id]["message"] = "Running VMAF tests..."
+
+        # Run the script
+        result = subprocess.run(
+            [script_path],
+            capture_output=True,
+            text=True,
+            timeout=3600  # 1 hour timeout
+        )
+
+        if result.returncode == 0:
+            # Success
+            jobs_db[job_id]["status"] = "completed"
+            jobs_db[job_id]["progress"] = 100
+            jobs_db[job_id]["message"] = "VMAF tests completed successfully!"
+            jobs_db[job_id]["completed_at"] = datetime.utcnow()
+        else:
+            # Failed
+            jobs_db[job_id]["status"] = "failed"
+            jobs_db[job_id]["progress"] = 0
+            jobs_db[job_id]["message"] = "VMAF tests failed"
+            jobs_db[job_id]["error"] = result.stderr
+            jobs_db[job_id]["completed_at"] = datetime.utcnow()
+
+        # Cleanup
+        os.remove(script_path)
+
+    except Exception as e:
+        jobs_db[job_id]["status"] = "failed"
+        jobs_db[job_id]["progress"] = 0
+        jobs_db[job_id]["message"] = "Error running VMAF tests"
+        jobs_db[job_id]["error"] = str(e)
+        jobs_db[job_id]["completed_at"] = datetime.utcnow()
+
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run(app, host="0.0.0.0", port=8000)
