+import logging
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+from google.cloud import storage
+
+logger = logging.getLogger(__name__)
+
+# Add the vmaf_calculator package to the path so we can import VMAFCalculator
+VMAF_CALC_DIR = Path(__file__).resolve().parent.parent.parent / "vmaf_calculator"
+if str(VMAF_CALC_DIR) not in sys.path:
+    sys.path.insert(0, str(VMAF_CALC_DIR))
+
+from vmaf_calculator import VMAFCalculator
+
+_storage_client = None
+
+
+def _get_storage_client():
+    global _storage_client
+    if _storage_client is None:
+        _storage_client = storage.Client()
+    return _storage_client
+
+
+def _download_gcs_m3u8(gcs_url: str, temp_dir: str) -> str:
+    """Download M3U8 and its segments from GCS to local directory.
+
+    Args:
+        gcs_url: https://storage.googleapis.com/bucket/path/to/output.m3u8
+        temp_dir: Local directory to download files to
+
+    Returns:
+        Local path to the downloaded M3U8 file
+    """
+    # Parse GCS URL: https://storage.googleapis.com/bucket/path/to/file.m3u8
+    parts = gcs_url.replace("https://storage.googleapis.com/", "").split("/")
+    bucket_name = parts[0]
+    blob_path = "/".join(parts[1:])
+
+    # Get the directory containing the M3U8
+    blob_dir = "/".join(blob_path.split("/")[:-1])
+
+    logger.info(f"Downloading GCS files from gs://{bucket_name}/{blob_dir}/")
+
+    client = _get_storage_client()
+    bucket = client.bucket(bucket_name)
+
+    # List all files in the directory (M3U8 + TS segments)
+    blobs = bucket.list_blobs(prefix=blob_dir + "/")
+
+    for blob in blobs:
+        if blob.name.endswith("/"):
+            continue  # Skip directories
+
+        # Extract relative path from blob_dir
+        rel_path = blob.name[len(blob_dir) + 1:] if blob.name.startswith(blob_dir + "/") else blob.name
+        local_path = os.path.join(temp_dir, rel_path)
+
+        # Create subdirectories if needed
+        os.makedirs(os.path.dirname(local_path), exist_ok=True)
+
+        logger.debug(f"Downloading {blob.name} -> {local_path}")
+        blob.download_to_filename(local_path)
+
+    # Return path to the M3U8 file
+    m3u8_filename = blob_path.split("/")[-1]
+    local_m3u8 = os.path.join(temp_dir, m3u8_filename)
+
+    logger.info(f"Downloaded M3U8 to {local_m3u8}")
+    return local_m3u8
+
+
+def calculate_vmaf(reference_path: str, distorted_path: str) -> float:
+    """Run VMAF phone model comparison and return the median phone-transformed score.
+
+    Args:
+        reference_path: Local path to the original MP4 file.
+        distorted_path: URL or local path to the distorted M3U8/MP4.
+
+    Returns:
+        VMAF phone model score (median, phone-transformed).
+    """
+    logger.info(f"Running VMAF: ref={reference_path}, dist={distorted_path}")
+
+    # If distorted path is a GCS URL, download it first
+    temp_dir = None
+    local_distorted_path = distorted_path
+
+    if distorted_path.startswith("https://storage.googleapis.com/"):
+        temp_dir = tempfile.mkdtemp(prefix="vmaf_gcs_")
+        try:
+            local_distorted_path = _download_gcs_m3u8(distorted_path, temp_dir)
+        except Exception as e:
+            logger.error(f"Failed to download GCS files: {e}")
+            if temp_dir and os.path.exists(temp_dir):
+                import shutil
+                shutil.rmtree(temp_dir, ignore_errors=True)
+            raise
+
+    try:
+        calculator = VMAFCalculator(
+            reference_path=reference_path,
+            distorted_path=local_distorted_path,
+            model="vmaf_phone",
+        )
+
+        result = calculator.calculate()
+        score = result["metrics"]["vmaf"]["score"]
+
+        logger.info(f"VMAF phone score: {score}")
+        return score
+    finally:
+        # Clean up temp directory if we created one
+        if temp_dir and os.path.exists(temp_dir):
+            import shutil
+            shutil.rmtree(temp_dir, ignore_errors=True)
+            logger.debug(f"Cleaned up temp dir: {temp_dir}")
