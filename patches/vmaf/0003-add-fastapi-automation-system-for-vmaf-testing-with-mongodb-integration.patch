+
+        jobs[job_id] = {
+            "id": job_id,
+            "status": "queued",
+            "message": "Job queued",
+            "created_at": datetime.now().isoformat(),
+            "type": "multi_resolution",
+            "reference": reference_path,
+            "h264_m3u8_url": h264_m3u8_url,
+            "other_m3u8_url": other_m3u8_url,
