+#!/bin/bash
+# VMAF Calculator Setup Script
+# This script installs all dependencies needed to run the VMAF calculator
+
+set -e
+
+echo "=========================================="
+echo "VMAF Calculator Setup"
+echo "=========================================="
+
+# Detect OS
+OS="$(uname -s)"
+echo "Detected OS: $OS"
+
+# Check for Homebrew on macOS
+install_macos_deps() {
+    echo ""
+    echo "Installing macOS dependencies..."
+
+    if ! command -v brew &> /dev/null; then
+        echo "Homebrew not found. Installing Homebrew..."
+        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
+    fi
+
+    echo "Installing FFmpeg with libvmaf support..."
+    brew install ffmpeg
+
+    echo "Installing Python 3 (if not present)..."
+    brew install python3
+}
+
+# Install Linux dependencies
+install_linux_deps() {
+    echo ""
+    echo "Installing Linux dependencies..."
+
+    if command -v apt-get &> /dev/null; then
+        # Debian/Ubuntu
+        sudo apt-get update
+        sudo apt-get install -y ffmpeg python3 python3-pip python3-venv
+    elif command -v dnf &> /dev/null; then
+        # Fedora
+        sudo dnf install -y ffmpeg python3 python3-pip
+    elif command -v yum &> /dev/null; then
+        # CentOS/RHEL
+        sudo yum install -y ffmpeg python3 python3-pip
+    else
+        echo "Unknown Linux distribution. Please install FFmpeg and Python 3 manually."
+        exit 1
+    fi
+}
+
+# Check FFmpeg libvmaf support
+check_ffmpeg_vmaf() {
+    echo ""
+    echo "Checking FFmpeg libvmaf support..."
+
+    if ! command -v ffmpeg &> /dev/null; then
+        echo "ERROR: FFmpeg not found!"
+        return 1
+    fi
+
+    if ffmpeg -filters 2>/dev/null | grep -q libvmaf; then
+        echo "✓ FFmpeg has libvmaf support"
+        return 0
+    else
+        echo "WARNING: FFmpeg does not have libvmaf support"
+        echo "You may need to install FFmpeg with libvmaf enabled"
+        echo ""
+        echo "On macOS: brew install ffmpeg"
+        echo "On Ubuntu: The default ffmpeg package should include libvmaf"
+        echo "           Or build from source with --enable-libvmaf"
+        return 1
+    fi
+}
+
+# Setup Python virtual environment
+setup_python_env() {
+    echo ""
+    echo "Setting up Python virtual environment..."
+
+    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+    VENV_DIR="$SCRIPT_DIR/venv"
+
+    # Create virtual environment
+    if [ ! -d "$VENV_DIR" ]; then
+        python3 -m venv "$VENV_DIR"
+        echo "✓ Created virtual environment at $VENV_DIR"
+    else
+        echo "✓ Virtual environment already exists"
+    fi
+
+    # Activate and install dependencies
+    source "$VENV_DIR/bin/activate"
+
+    echo "Installing Python dependencies..."
+    pip install --upgrade pip
+    pip install -r "$SCRIPT_DIR/requirements.txt"
+
+    echo "✓ Python dependencies installed"
+}
+
+# Main setup flow
+main() {
+    case "$OS" in
+        Darwin)
+            install_macos_deps
+            ;;
+        Linux)
+            install_linux_deps
+            ;;
+        *)
+            echo "Unsupported OS: $OS"
+            echo "Please install FFmpeg and Python 3 manually."
+            ;;
+    esac
+
+    check_ffmpeg_vmaf
+    setup_python_env
+
+    echo ""
+    echo "=========================================="
+    echo "Setup Complete!"
+    echo "=========================================="
+    echo ""
+    echo "To activate the virtual environment:"
+    echo "  source venv/bin/activate"
+    echo ""
+    echo "To run the VMAF calculator:"
+    echo "  python vmaf_calculator.py -r reference.mp4 -d distorted.m3u8"
+    echo ""
+    echo "For help:"
+    echo "  python vmaf_calculator.py --help"
+    echo ""
+}
+
+main "$@"
