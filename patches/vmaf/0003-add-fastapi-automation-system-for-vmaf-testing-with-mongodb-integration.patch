+import asyncio
+import json
+import logging
+import os
+import subprocess
+import tempfile
+import uuid
+from concurrent.futures import ThreadPoolExecutor
+
+import httpx
+
+from ..config import BITRATE_GRANULARITY_KBPS, get_resolution_targets, GCPConfig
+from ..job_store import job_store
+from ..models import JobStatus, TrialResult
+from ..mongodb_client import VMAFMongoDBClient
+from ..vmaf_config import MONGODB_URI, MONGODB_ENABLED
+from . import gcs_service, transcoder_service, vmaf_service
+
+logger = logging.getLogger(__name__)
+
+executor = ThreadPoolExecutor(max_workers=4)
+
+# Initialize MongoDB client
+mongo_client = None
+if MONGODB_ENABLED:
+    try:
+        mongo_client = VMAFMongoDBClient(MONGODB_URI)
+        logger.info("MongoDB client initialized for bitrate optimizer")
+    except Exception as e:
+        logger.error(f"Failed to initialize MongoDB client: {e}")
+        mongo_client = None
+
+
+def _save_trial_to_mongodb(
+    job_id: str,
+    resolution: str,
+    bitrate_kbps: int,
+    vmaf_score: float,
+):
+    """Save a trial result to MongoDB."""
+    if not mongo_client:
+        return
+
+    try:
+        # Get job metadata from job_store
+        job = job_store.get_job(job_id)
+        if not job:
+            logger.warning(f"Job {job_id} not found, skipping MongoDB save")
+            return
+
+        # Get resolution dimensions
+        res_data = job.resolutions.get(resolution)
+        if not res_data:
+            logger.warning(f"Resolution {resolution} not found in job {job_id}")
+            return
+
+        resolution_dims = f"{res_data.width}x{res_data.height}"
+
+        # Insert to MongoDB
+        mongo_client.insert_vmaf_score(
+            s3_link_name=job.s3_url,
+            show_title=job.show_title,
+            episode_number=job.episode_number,
+            show_id=job.show_id,
+            trail_name=f"{resolution}_{bitrate_kbps}kbps",
+            trail_bitrate=bitrate_kbps * 1000,  # Convert to bps
+            resolution=resolution_dims,
+            vmaf_score=vmaf_score,
+        )
+        logger.info(f"Saved to MongoDB: {job.show_id} ep{job.episode_number} {resolution} @ {bitrate_kbps}kbps = {vmaf_score}")
+    except Exception as e:
+        logger.error(f"Failed to save trial to MongoDB: {e}")
+
+
+def _detect_video_dimensions(video_path: str) -> tuple[int, int]:
+    """Detect video dimensions using ffprobe.
+
+    Args:
+        video_path: Local path to video file
+
+    Returns:
+        Tuple of (width, height)
+    """
+    try:
+        result = subprocess.run(
+            [
+                "ffprobe",
+                "-v", "error",
+                "-select_streams", "v:0",
+                "-show_entries", "stream=width,height",
+                "-of", "json",
+                video_path,
+            ],
+            capture_output=True,
+            text=True,
+            check=True,
+        )
+        data = json.loads(result.stdout)
+        stream = data["streams"][0]
+        width = stream["width"]
+        height = stream["height"]
+        logger.info(f"Detected video dimensions: {width}x{height}")
+        return width, height
+    except Exception as e:
+        logger.error(f"Failed to detect video dimensions: {e}")
+        # Default to landscape
+        raise RuntimeError(f"Could not detect video dimensions: {e}")
+
+
+async def run_optimization(job_id: str, s3_url: str):
+    """Main optimization entry point. Downloads source, uploads to GCS,
+    then binary-searches each resolution for optimal bitrate."""
+    config = GCPConfig.from_environment()
+
+    try:
+        # Step 1: Download original from S3
+        job_store.update_status(job_id, JobStatus.DOWNLOADING, progress="Downloading source video from S3")
+        local_path = await _download_s3(s3_url, job_id)
+
+        # Step 2: Detect video dimensions and get appropriate resolution targets
+        job_store.update_status(job_id, JobStatus.PROCESSING, progress="Analyzing video properties")
+        width, height = await asyncio.get_event_loop().run_in_executor(
+            executor,
+            _detect_video_dimensions,
+            local_path,
+        )
+        orientation = "portrait" if height > width else "landscape"
+        logger.info(f"Video orientation: {orientation} ({width}x{height})")
+
+        resolution_targets = get_resolution_targets(width, height)
+        job_store.initialize_resolutions(job_id, resolution_targets)
+
+        # Step 3: Upload original to GCS
+        job_store.update_status(job_id, JobStatus.PROCESSING, progress="Uploading original to GCS")
+        gcs_uri = await asyncio.get_event_loop().run_in_executor(
+            executor,
+            gcs_service.upload_to_gcs,
+            local_path,
+            job_id,
+            "original.mp4",
+            config,
+        )
+
+        # Step 4: Binary search per resolution (in parallel)
+        job_store.update_status(job_id, JobStatus.PROCESSING, progress="Optimizing all resolutions in parallel")
+
+        async def _optimize_resolution(target):
+            """Helper to optimize one resolution."""
+            job_store.update_resolution(job_id, target.name, {"status": "in_progress"})
+            try:
+                optimal_bitrate, final_score, trials = await _binary_search_resolution(
+                    job_id=job_id,
+                    gcs_uri=gcs_uri,
+                    local_reference=local_path,
+                    target_name=target.name,
+                    width=target.width,
+                    height=target.height,
+                    vmaf_target=target.vmaf_target,
+                    bitrate_min=target.bitrate_min,
+                    bitrate_max=target.bitrate_max,
+                    config=config,
+                )
+
+                job_store.update_resolution(job_id, target.name, {
+                    "status": "completed",
+                    "optimal_bitrate_kbps": optimal_bitrate,
+                    "final_vmaf_score": final_score,
+                    "trials": trials,
+                })
+                logger.info(f"✓ {target.name} optimization completed: {optimal_bitrate} kbps (VMAF {final_score})")
+            except Exception as e:
+                logger.error(f"✗ {target.name} optimization failed: {e}")
+                job_store.update_resolution(job_id, target.name, {
+                    "status": "failed",
+                    "error": str(e),
+                })
+
+        # Launch all resolutions in parallel
+        await asyncio.gather(
+            *[_optimize_resolution(target) for target in resolution_targets],
+            return_exceptions=True  # Don't fail the whole job if one resolution fails
+        )
+
+        job_store.update_status(job_id, JobStatus.COMPLETED, progress="All resolutions optimized")
+
+    except Exception as e:
+        logger.error(f"Optimization failed for job {job_id}: {e}")
+        job_store.update_status(job_id, JobStatus.FAILED, error=str(e))
+    finally:
+        # Clean up temp file
+        if "local_path" in locals() and os.path.exists(local_path):
+            os.remove(local_path)
+            logger.info(f"Cleaned up temp file: {local_path}")
+
+
+async def _download_s3(s3_url: str, job_id: str) -> str:
+    """Download video from S3 URL to a local temp file."""
+    tmp_dir = tempfile.mkdtemp(prefix=f"bitopt_{job_id}_")
+    local_path = os.path.join(tmp_dir, "original.mp4")
+
+    logger.info(f"Downloading {s3_url} -> {local_path}")
+
+    async with httpx.AsyncClient(timeout=httpx.Timeout(300.0)) as client:
+        async with client.stream("GET", s3_url) as response:
+            response.raise_for_status()
+            with open(local_path, "wb") as f:
+                async for chunk in response.aiter_bytes(chunk_size=8192):
+                    f.write(chunk)
+
+    file_size = os.path.getsize(local_path)
+    logger.info(f"Downloaded {file_size / 1_000_000:.1f} MB to {local_path}")
+    return local_path
+
+
+async def _binary_search_resolution(
+    job_id: str,
+    gcs_uri: str,
+    local_reference: str,
+    target_name: str,
+    width: int,
+    height: int,
+    vmaf_target: float,
+    bitrate_min: int,
+    bitrate_max: int,
+    config: GCPConfig,
+) -> tuple:
+    """Binary search for the minimum bitrate that meets the VMAF target.
+
+    Returns (optimal_bitrate_kbps, final_vmaf_score, list_of_trials).
+    """
+    loop = asyncio.get_event_loop()
+    low = bitrate_min
+    high = bitrate_max
+    trials = []
+    best_bitrate = high
+    best_score = 0.0
+
+    while high - low >= BITRATE_GRANULARITY_KBPS:
+        mid = (low + high) // 2
+        # Round to nearest 100 kbps
+        mid = round(mid / 100) * 100
+
+        variant_label = f"{target_name}_{mid}kbps"
+        logger.info(f"[{job_id}] Testing {variant_label}")
+
+        # Update progress
+        job_store.update_status(
+            job_id, JobStatus.PROCESSING,
+            progress=f"Testing {target_name} @ {mid} kbps"
+        )
+
+        # Create transcoder job
+        output_uri = gcs_service.get_gcs_output_uri(job_id, variant_label, config)
+
+        transcoder_job_name = await loop.run_in_executor(
+            executor,
+            transcoder_service.create_single_resolution_job,
+            gcs_uri,
+            output_uri,
+            width,
+            height,
+            mid,
+            config,
+        )
+
+        # Wait for transcoder job to complete
+        await loop.run_in_executor(
+            executor,
+            transcoder_service.wait_for_job,
+            transcoder_job_name,
+        )
+
+        # Get the M3U8 URL for VMAF comparison
+        m3u8_url = gcs_service.get_m3u8_url(job_id, variant_label, "output.m3u8", config)
+
+        # Run VMAF comparison
+        vmaf_score = await loop.run_in_executor(
+            executor,
+            vmaf_service.calculate_vmaf,
+            local_reference,
+            m3u8_url,
+        )
+
+        meets_target = vmaf_score >= vmaf_target
+        trial = TrialResult(
+            bitrate_kbps=mid,
+            vmaf_score=round(vmaf_score, 2),
+            meets_target=meets_target,
+        )
+        trials.append(trial)
+
+        # Save trial to MongoDB
+        _save_trial_to_mongodb(job_id, target_name, mid, round(vmaf_score, 2))
+
+        logger.info(
+            f"[{job_id}] {variant_label}: VMAF={vmaf_score:.2f}, "
+            f"target={vmaf_target}, meets={'YES' if meets_target else 'NO'}"
+        )
+
+        if meets_target:
+            best_bitrate = mid
+            best_score = vmaf_score
+            high = mid  # Try lower
+        else:
+            low = mid + BITRATE_GRANULARITY_KBPS  # Need higher
+
+    # If we never met the target, use the highest bitrate
+    if best_score == 0.0:
+        best_bitrate = bitrate_max
+        # Run one final test at max bitrate if not already tested
+        already_tested = any(t.bitrate_kbps == bitrate_max for t in trials)
+        if not already_tested:
+            variant_label = f"{target_name}_{bitrate_max}kbps"
+            output_uri = gcs_service.get_gcs_output_uri(job_id, variant_label, config)
+
+            transcoder_job_name = await loop.run_in_executor(
+                executor,
+                transcoder_service.create_single_resolution_job,
+                gcs_uri,
+                output_uri,
+                width,
+                height,
+                bitrate_max,
+                config,
+            )
+            await loop.run_in_executor(
+                executor,
+                transcoder_service.wait_for_job,
+                transcoder_job_name,
+            )
+            m3u8_url = gcs_service.get_m3u8_url(job_id, variant_label, "output.m3u8", config)
+            best_score = await loop.run_in_executor(
+                executor,
+                vmaf_service.calculate_vmaf,
+                local_reference,
+                m3u8_url,
+            )
+            trial_result = TrialResult(
+                bitrate_kbps=bitrate_max,
+                vmaf_score=round(best_score, 2),
+                meets_target=best_score >= vmaf_target,
+            )
+            trials.append(trial_result)
+
+            # Save final trial to MongoDB
+            _save_trial_to_mongodb(job_id, target_name, bitrate_max, round(best_score, 2))
+
+    return best_bitrate, round(best_score, 2), trials
