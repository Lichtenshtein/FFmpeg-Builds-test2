+import threading
+from datetime import datetime
+from typing import Dict, List, Optional
+
+from .config import ResolutionTarget
+from .models import JobResponse, JobStatus, ResolutionResult
+
+
+class JobStore:
+    """Thread-safe in-memory job store."""
+
+    def __init__(self):
+        self._jobs: Dict[str, JobResponse] = {}
+        self._lock = threading.Lock()
+
+    def create_job(
+        self,
+        job_id: str,
+        show_id: str,
+        show_title: str,
+        episode_number: int,
+        s3_url: str,
+    ) -> JobResponse:
+        # Create job with empty resolutions - will be populated after video analysis
+        job = JobResponse(
+            job_id=job_id,
+            status=JobStatus.PENDING,
+            created_at=datetime.utcnow().isoformat(),
+            show_id=show_id,
+            show_title=show_title,
+            episode_number=episode_number,
+            s3_url=s3_url,
+            resolutions={},
+        )
+
+        with self._lock:
+            self._jobs[job_id] = job
+        return job
+
+    def initialize_resolutions(self, job_id: str, targets: List[ResolutionTarget]):
+        """Initialize resolution targets for a job after detecting video dimensions."""
+        with self._lock:
+            job = self._jobs.get(job_id)
+            if not job:
+                return
+
+            resolutions = {}
+            for target in targets:
+                resolutions[target.name] = ResolutionResult(
+                    resolution=target.name,
+                    width=target.width,
+                    height=target.height,
+                    vmaf_target=target.vmaf_target,
+                )
+            job.resolutions = resolutions
+
+    def get_job(self, job_id: str) -> Optional[JobResponse]:
+        with self._lock:
+            return self._jobs.get(job_id)
+
+    def update_status(self, job_id: str, status: JobStatus, progress: Optional[str] = None, error: Optional[str] = None):
+        with self._lock:
+            job = self._jobs.get(job_id)
+            if not job:
+                return
+            job.status = status
+            if progress is not None:
+                job.progress = progress
+            if error is not None:
+                job.error = error
+            if status in (JobStatus.COMPLETED, JobStatus.FAILED):
+                job.completed_at = datetime.utcnow().isoformat()
+
+    def update_resolution(self, job_id: str, resolution_name: str, update: dict):
+        with self._lock:
+            job = self._jobs.get(job_id)
+            if not job or resolution_name not in job.resolutions:
+                return
+            res = job.resolutions[resolution_name]
+            for key, value in update.items():
+                if hasattr(res, key):
+                    setattr(res, key, value)
+
+
+job_store = JobStore()
