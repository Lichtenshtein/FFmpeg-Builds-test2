+import logging
+
+from google.cloud import storage
+
+from ..config import GCPConfig
+
+logger = logging.getLogger(__name__)
+
+_storage_client = None
+
+
+def _get_storage_client():
+    global _storage_client
+    if _storage_client is None:
+        _storage_client = storage.Client()
+    return _storage_client
+
+
+def upload_to_gcs(local_path: str, job_id: str, filename: str, config: GCPConfig) -> str:
+    """Upload a local file to GCS under the job's directory.
+
+    Returns the gs:// URI of the uploaded file.
+    """
+    gcs_path = f"{config.gcs_base_path}/{job_id}/{filename}"
+    bucket = _get_storage_client().bucket(config.bucket)
+    blob = bucket.blob(gcs_path)
+
+    logger.info(f"Uploading {local_path} -> gs://{config.bucket}/{gcs_path}")
+    blob.upload_from_filename(local_path)
+    logger.info(f"Upload complete: gs://{config.bucket}/{gcs_path}")
+
+    return f"gs://{config.bucket}/{gcs_path}"
+
+
+def get_gcs_output_uri(job_id: str, variant_label: str, config: GCPConfig) -> str:
+    """Get the GCS output URI for a transcoder job variant.
+
+    e.g. gs://chai-shots-manifests/bitrate-optimization/{job_id}/1080p_3500kbps/
+    """
+    return f"gs://{config.bucket}/{config.gcs_base_path}/{job_id}/{variant_label}/"
+
+
+def get_m3u8_url(job_id: str, variant_label: str, manifest_name: str, config: GCPConfig) -> str:
+    """Construct the public HTTPS URL for a transcoded M3U8.
+
+    GCS public URL format: https://storage.googleapis.com/{bucket}/{path}
+    """
+    gcs_path = f"{config.gcs_base_path}/{job_id}/{variant_label}/{manifest_name}"
+    return f"https://storage.googleapis.com/{config.bucket}/{gcs_path}"
