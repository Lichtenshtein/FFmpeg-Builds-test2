+import functions_framework
+from google.cloud.video import transcoder_v1
+from google.cloud import logging as cloud_logging
+from google.cloud import storage
+from google.cloud.exceptions import GoogleCloudError
+import os
+import json
+import time
+from typing import Dict, List
+from dataclasses import dataclass
+from datetime import datetime
+import logging
+import re
+
+# Configure structured logging
+cloud_logging_client = cloud_logging.Client()
+cloud_logging_client.setup_logging()
+logger = logging.getLogger(__name__)
+
+# Initialize clients
+transcoder_client = transcoder_v1.TranscoderServiceClient()
+storage_client = storage.Client()
+
+# --- Configuration ---
+@dataclass
+class Config:
+    """Configuration class for the Cloud Function."""
+    project_id: str
+    location: str
+    output_bucket: str
+
+    @classmethod
+    def from_environment(cls) -> 'Config':
+        project_id = os.environ.get('GCP_PROJECT', 'media-cdn-poc-466009')
+        location = os.environ.get('TRANSCODER_LOCATION', 'asia-south1')
+        output_bucket = os.environ.get('OUTPUT_BUCKET', 'chai-shots-manifests')
+
+        logger.info("Config values being used:")
+        logger.info(f"  project_id: {project_id}")
+        logger.info(f"  location: {location}")
+        logger.info(f"  output_bucket: {output_bucket}")
+
+        return cls(project_id=project_id, location=location, output_bucket=output_bucket)
+
+class TranscodingError(Exception):
+    """Custom exception for transcoding-specific errors."""
+    pass
+
+class VideoProcessor:
+    def __init__(self, config: Config):
+        self.config = config
+        logger.info("VideoProcessor initialized")
+
+    def process_video(self, bucket_name: str, file_name: str):
+        start_time = time.time()
+        video_id = file_name.rsplit('.', 1)[0].replace('/', '_')
+
+        try:
+            logger.info(
+                f"Starting video processing with subtitles: {video_id}",
+                extra={'video_id': video_id, 'bucket': bucket_name, 'file_name': file_name}
+            )
+
+            resolutions = self._get_resolution_configs()
+            job_ids = []
+
+            subtitle_uris = self._list_subtitle_uris(file_name)
+            logger.info(f"Subtitle URIs found: {subtitle_uris}")
+
+            adaptive_job = self._create_adaptive_job(bucket_name, file_name, video_id, resolutions, subtitle_uris)
+            logger.info(f"Transcoder created with subtitles: {adaptive_job}")
+            job_ids.append(adaptive_job.name)
+
+            # Generate and log the public m3u8 URL
+            m3u8_url = self._generate_m3u8_url(file_name)
+            logger.info(f"HLS Manifest URL: {m3u8_url}")
+
+            self._store_processing_metadata(video_id, job_ids, subtitle_uris, m3u8_url)
+
+            processing_time = time.time() - start_time
+            logger.info(
+                f"Video processing with subtitles completed: {video_id}",
+                extra={'video_id': video_id, 'processing_time': processing_time, 'jobs_created': len(job_ids)}
+            )
+
+        except Exception as e:
+            processing_time = time.time() - start_time
+            logger.error(
+                f"Video processing with subtitles failed: {video_id}",
+                extra={'video_id': video_id, 'error': str(e), 'processing_time': processing_time}
+            )
+            raise TranscodingError(f"Video processing failed: {str(e)}")
+
+    def _list_subtitle_uris(self, file_name: str) -> List[str]:
+        base_name = os.path.splitext(os.path.basename(file_name))[0]
+        prefix = f"subtitles/{base_name}/"
+        bucket = storage_client.bucket(self.config.output_bucket)
+
+        subtitle_uris = []
+        for blob in bucket.list_blobs(prefix=prefix):
+            if blob.name.endswith(".vtt"):
+                uri = f"gs://{self.config.output_bucket}/{blob.name}"
+                subtitle_uris.append(uri)
+        return subtitle_uris
+
+    def _parse_language_from_filename(self, subtitle_uri: str) -> (str, str):
+        """
+        Parse a BCP-47 language code and display name from subtitle filename.
+        """
+        fname = os.path.basename(subtitle_uri)
+        stem = os.path.splitext(fname)[0]
+
+        last_us = stem.rfind('_')
+        last_dot = stem.rfind('.')
+        sep_pos = max(last_us, last_dot)
+        token = stem[sep_pos + 1:] if sep_pos != -1 else stem
+
+        candidate = token.strip().lower()
+
+        lang_display = {
+            "en": "English",
+            "es": "Spanish",
+            "hi": "Hindi",
+            "fr": "French",
+            "de": "German",
+            "te": "Telugu",
+            "und": "Unknown",
+        }
+
+        if candidate in {"tlg", "tinglish"}:
+            return "en", "Tinglish"
+
+        bcp47_pattern = re.compile(r"^[a-z]{2,3}(-[a-z0-9]{2,8})*$", re.IGNORECASE)
+        if not bcp47_pattern.match(candidate):
+            return "und", lang_display["und"]
+
+        parts = candidate.split("-")
+        primary = parts[0].lower()
+        subtags = []
+        for p in parts[1:]:
+            if len(p) == 2 and p.isalpha():
+                subtags.append(p.upper())
+            elif len(p) == 4 and p.isalpha():
+                subtags.append(p.title())
+            else:
+                subtags.append(p.lower())
+
+        norm = "-".join([primary] + subtags) if subtags else primary
+
+        display = lang_display.get(primary, primary.upper())
+        if subtags:
+            display = f"{display} ({'-'.join(subtags)})"
+
+        return norm, display
+
+    def _build_output_paths(self, file_name: str):
+        input_dir = os.path.dirname(file_name)
+        base_name = os.path.splitext(os.path.basename(file_name))[0]
+
+        if input_dir:
+            output_uri = f"gs://{self.config.output_bucket}/hls/{input_dir}/"
+        else:
+            output_uri = f"gs://{self.config.output_bucket}/hls/"
+
+        manifest_file_name = f"{base_name}.m3u8"
+        return output_uri, manifest_file_name
+
+    def _generate_m3u8_url(self, file_name: str) -> str:
+        """Generate the public HTTP URL for the m3u8 manifest."""
+        input_dir = os.path.dirname(file_name)
+        base_name = os.path.splitext(os.path.basename(file_name))[0]
+
+        if input_dir:
+            path = f"hls/{input_dir}/{base_name}.m3u8"
+        else:
+            path = f"hls/{base_name}.m3u8"
+
+        # Generate public Google Cloud Storage URL
+        public_url = f"https://storage.googleapis.com/{self.config.output_bucket}/{path}"
+        return public_url
+
+    def _create_adaptive_job(self, bucket_name: str, file_name: str, video_id: str, resolutions: List[Dict], subtitle_uris: List[str]):
+        input_uri = f"gs://{bucket_name}/{file_name}"
+        output_uri, manifest_file_name = self._build_output_paths(file_name)
+
+        elementary_streams = []
+        mux_streams = []
+        inputs = [{"key": "input0", "uri": input_uri}]
+        edit_inputs = ["input0"]
+
+        for i, resolution in enumerate(resolutions):
+            elementary_streams.extend(self._get_elementary_streams(resolution, i))
+
+            # Create mux streams for both H.264 and H.265
+            h264_video_stream_id = f"video_stream_h264_{i}"
+            h265_video_stream_id = f"video_stream_h265_{i}"
+            audio_stream_id = f"audio_stream_{i}"
+
+            # H.264 mux stream
+            mux_streams.append(self._get_mux_stream(
+                h264_video_stream_id,
+                audio_stream_id,
+                video_id,
+                f"{resolution['name']}-h264"
+            ))
+
+            # H.265 mux stream
+            mux_streams.append(self._get_mux_stream(
+                h265_video_stream_id,
+                audio_stream_id,
+                video_id,
+                f"{resolution['name']}-h265"
+            ))
+
+        for idx, subtitle_uri in enumerate(subtitle_uris):
+            input_key = f"subtitle_input_{idx}"
+            stream_key = f"subtitle_stream_{idx}"
+            mux_key = f"{video_id}-subtitle-{idx}"
+
+            lang_code, display_name = self._parse_language_from_filename(subtitle_uri)
+
+            inputs.append({"key": input_key, "uri": subtitle_uri})
+            edit_inputs.append(input_key)
+
+            if not self._is_valid_bcp47(lang_code):
+                logger.warning(f"Invalid language code '{lang_code}' from '{subtitle_uri}', forcing 'und'")
+                lang_code = "und"
+
+            elementary_streams.append({
+                "key": stream_key,
+                "text_stream": {
+                    "codec": "webvtt",
+                    "language_code": lang_code,
+                    "display_name": display_name,
+                    "mapping": [{"atom_key": "atom0", "input_key": input_key}]
+                }
+            })
+
+            mux_streams.append({
+                "key": mux_key,
+                "container": "vtt",
+                "elementary_streams": [stream_key],
+                "segment_settings": {
+                    "segment_duration": "3s",
+                    "individual_segments": True
+                }
+            })
+
+        job_config = {
+            "inputs": inputs,
+            "edit_list": [{"key": "atom0", "inputs": edit_inputs}],
+            "elementary_streams": elementary_streams,
+            "mux_streams": mux_streams,
+            "manifests": [{
+                "file_name": manifest_file_name,
+                "type_": transcoder_v1.Manifest.ManifestType.HLS,
+                "mux_streams": [mux["key"] for mux in mux_streams],
+            }]
+        }
+
+        logger.info(f"Job config with subtitles: {json.dumps(job_config, indent=2, default=str)}")
+
+        parent = f"projects/{self.config.project_id}/locations/{self.config.location}"
+        return transcoder_client.create_job(
+            parent=parent,
+            job={"input_uri": input_uri, "output_uri": output_uri, "config": job_config}
+        )
+
+    def _get_mux_stream(self, video_stream_id: str, audio_stream_id: str, video_id: str, resolution_name: str) -> dict:
+        return {
+            "key": f"{video_id}-{resolution_name}",
+            "container": "ts",
+            "elementary_streams": [video_stream_id, audio_stream_id],
+            "file_name": f"{video_id}-{resolution_name}.ts",
+            "segment_settings": {
+                "segment_duration": "3s",
+                "individual_segments": True
+            }
+        }
+
+    def _get_elementary_streams(self, resolution: Dict, stream_index: int = 0) -> List[Dict]:
+        # H.264 video stream
+        h264_video_stream = {
+            "key": f"video_stream_h264_{stream_index}",
+            "video_stream": {
+                "h264": {
+                    "height_pixels": resolution["height"],
+                    "width_pixels": resolution["width"],
+                    "bitrate_bps": resolution.get("bitrate", 550000),
+                    "frame_rate": 30
+                }
+            }
+        }
+
+        # H.265 video stream (HEVC) - typically 30-50% lower bitrate for same quality
+        h265_bitrate = int(resolution.get("bitrate", 550000) * 0.6)  # 40% reduction
+        h265_video_stream = {
+            "key": f"video_stream_h265_{stream_index}",
+            "video_stream": {
+                "h265": {
+                    "height_pixels": resolution["height"],
+                    "width_pixels": resolution["width"],
+                    "bitrate_bps": h265_bitrate,
+                    "frame_rate": 30
+                }
+            }
+        }
+
+        # Audio stream (shared between both codecs)
+        audio_stream = {
+            "key": f"audio_stream_{stream_index}",
+            "audio_stream": {
+                "codec": "aac",
+                "bitrate_bps": resolution.get("audio_bitrate", 64000)
+            }
+        }
+
+        return [h264_video_stream, h265_video_stream, audio_stream]
+
+    def _get_resolution_configs(self) -> List[Dict]:
+        return [
+            {'name': '720p', 'height': 1280, 'width': 720, 'bitrate': 1500000, 'audio_bitrate': 128000},
+            {'name': '480p', 'height': 854, 'width': 480, 'bitrate': 450000, 'audio_bitrate': 64000},
+            {'name': '1080p', 'height': 1920, 'width': 1080, 'bitrate': 5000000, 'audio_bitrate': 128000}
+        ]
+
+    def _store_processing_metadata(self, video_id: str, job_ids: List[str], subtitle_uris: List[str], m3u8_url: str):
+        metadata = {
+            "video_id": video_id,
+            "job_ids": job_ids,
+            "timestamp": datetime.utcnow().isoformat(),
+            "subtitle_uris": subtitle_uris,
+            "m3u8_url": m3u8_url
+        }
+        logger.debug(f"Video metadata: {json.dumps(metadata, indent=2)}")
+
+    def _is_valid_bcp47(self, tag: str) -> bool:
+        return bool(re.match(r"^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$", tag))
+
+@functions_framework.cloud_event
+def transcode_video(cloud_event):
+    try:
+        logger.info("Cloud Function 'transcode_video' triggered.")
+        config = Config.from_environment()
+
+        data = cloud_event.data
+        bucket_name = data.get('bucket')
+        file_name = data.get('name')
+
+        logger.info(f"Processing cloud event: bucket={bucket_name}, file={file_name}")
+
+        if not bucket_name or not file_name:
+            logger.error("Invalid Cloud Storage event data: 'bucket' or 'name' missing.")
+            return
+
+        if " " in file_name:
+            new_file_name = file_name.replace(" ", "_")
+            logger.info(f"Sanitized file name from '{file_name}' to '{new_file_name}'")
+            file_name = new_file_name
+
+        processor = VideoProcessor(config)
+        processor.process_video(bucket_name, file_name)
+
+    except Exception as e:
+        logger.error(
+            f"Cloud Function 'transcode_video' execution failed: {str(e)}",
+            extra={
+                'error_type': type(e).__name__,
+                'bucket': data.get('bucket') if 'data' in locals() else 'N/A',
+                'file_name': data.get('name') if 'data' in locals() else 'N/A'
+            }
+        )
+        raise
+
+@functions_framework.http
+def health_check(request):
+    try:
+        config = Config.from_environment()
+        health_status = {
+            'status': 'healthy',
+            'timestamp': datetime.utcnow().isoformat(),
+            'transcoder_location': config.location,
+            'output_bucket': config.output_bucket
+        }
+        return json.dumps(health_status), 200, {'Content-Type': 'application/json'}
+
+    except Exception as e:
+        logger.error(f"Health check failed: {str(e)}", extra={'error_type': type(e).__name__})
+        error_response = {
+            'status': 'unhealthy',
+            'error': str(e),
+            'timestamp': datetime.utcnow().isoformat()
+        }
+        return json.dumps(error_response), 500, {'Content-Type': 'application/json'}
+
+def get_job_status(project_id: str, location: str, job_id: str):
+    try:
+        name = f"projects/{project_id}/locations/{location}/jobs/{job_id}"
+        response = transcoder_client.get_job(name=name)
+        return response.state
+    except GoogleCloudError as e:
+        logger.error(f"Failed to get job status for job {job_id}: {str(e)}")
+        raise TranscodingError(f"Failed to get job status: {str(e)}")
+
