+        help="Path or URL to distorted video (transcoded)"
+    )
+
+    # MongoDB metadata (required for MongoDB storage)
+    parser.add_argument(
+        "--show-id",
+        help="Show ID (required for MongoDB storage)"
+    )
+    parser.add_argument(
+        "--show-title",
+        help="Show title (required for MongoDB storage)"
