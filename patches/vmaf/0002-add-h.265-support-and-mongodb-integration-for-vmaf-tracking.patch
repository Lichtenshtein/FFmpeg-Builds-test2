+    def _convert_to_y4m(self, input_path: str, name: str, target_width: int, target_height: int) -> str:
+        """Convert video to Y4M format for VMAF tool."""
+        if self.temp_dir is None:
+            self.temp_dir = tempfile.mkdtemp(prefix="vmaf_")
+
+        output_file = os.path.join(self.temp_dir, f"{name}.y4m")
+        self._temp_files.append(output_file)
+
+        print(f"Converting {name} to Y4M format...")
+
+        cmd = [
+            self.ffmpeg,
+            "-y",
+            "-i", input_path,
+            "-vf", f"scale={target_width}:{target_height}:flags=bicubic",
+            "-pix_fmt", "yuv420p",
+            "-f", "yuv4mpegpipe",
+            output_file,
+        ]
+
+        if self.verbose:
+            print(f"Running: {' '.join(cmd)}")
+
+        try:
+            process = subprocess.Popen(
+                cmd,
+                stderr=subprocess.PIPE,
+                stdout=subprocess.PIPE,
+                text=True,
+            )
+
+            for line in process.stderr:
+                if self.verbose:
+                    print(line.strip())
+                elif "frame=" in line:
+                    print(f"\r  {line.strip()[:60]}", end="", flush=True)
+
+            process.wait()
+            print()
+
+            if process.returncode != 0:
+                raise subprocess.CalledProcessError(process.returncode, cmd)
+
+            return output_file
+        except subprocess.CalledProcessError as e:
+            print(f"ERROR: Failed to convert video: {e}")
+            raise
+
+    def _run_vmaf(self, reference_y4m: str, distorted_y4m: str) -> Dict[str, Any]:
+        """Run VMAF comparison using the native VMAF tool."""
+        if self.temp_dir is None:
+            self.temp_dir = tempfile.mkdtemp(prefix="vmaf_")
+
+        vmaf_log = os.path.join(self.temp_dir, "vmaf_output.json")
+        self._temp_files.append(vmaf_log)
+
+        cmd = [
+            str(VMAF_TOOL),
+            "--reference", reference_y4m,
+            "--distorted", distorted_y4m,
+            "--model", self.model,
+            "--output", vmaf_log,
+            "--json",
+            "--threads", str(self.threads),
+            "--feature", "psnr",
+            "--feature", "float_ssim",
+        ]
+
+        print(f"\nCalculating VMAF score (using {self.threads} threads)...")
+        if self.verbose:
+            print(f"Running: {' '.join(cmd)}")
+
+        try:
+            process = subprocess.Popen(
+                cmd,
+                stderr=subprocess.PIPE,
+                stdout=subprocess.PIPE,
+                text=True,
+            )
+
+            # Capture output
+            stdout, stderr = process.communicate()
+
+            if self.verbose:
+                if stdout:
+                    print(stdout)
+                if stderr:
+                    print(stderr)
+
+            if process.returncode != 0:
+                print(f"VMAF tool stderr: {stderr}")
+                raise subprocess.CalledProcessError(process.returncode, cmd)
+
+            # Read VMAF results
+            with open(vmaf_log, "r") as f:
+                vmaf_data = json.load(f)
+
+            return vmaf_data
+
+        except subprocess.CalledProcessError as e:
+            print(f"ERROR: VMAF calculation failed: {e}")
+            raise
+
+    def _apply_phone_transform(self, score: float) -> float:
+        """Apply phone model transformation to VMAF score.
+
+        The phone model boosts scores because on smaller screens viewed
+        at closer distances, artifacts are less perceptible.
+
+        Formula: y_out = p0 + p1 * y_in + p2 * y_in^2
+        With constraint: output >= input (out_gte_in)
+        """
+        p0 = self.PHONE_TRANSFORM["p0"]
+        p1 = self.PHONE_TRANSFORM["p1"]
+        p2 = self.PHONE_TRANSFORM["p2"]
+
+        transformed = p0 + p1 * score + p2 * score * score
+        # Apply out_gte_in constraint: output must be >= input
+        transformed = max(transformed, score)
+        # Clip to valid range
+        transformed = min(max(transformed, 0), 100)
+
+        return transformed
+
+    def _calculate_median(self, values: list) -> float:
+        """Calculate median of a list of values."""
+        if not values:
+            return 0
+        sorted_values = sorted(values)
+        n = len(sorted_values)
+        mid = n // 2
+        if n % 2 == 0:
+            return (sorted_values[mid - 1] + sorted_values[mid]) / 2
+        else:
+            return sorted_values[mid]
+
+    def _calculate_segment_scores(self, frames: list, fps: float, segment_duration: float = 3.0) -> list:
+        """Calculate VMAF scores for each time segment (default 3 seconds).
+
+        Returns list of {time_start, time_end, median_score, mean_score, min_score, max_score}
+        """
+        if not frames or fps <= 0:
+            return []
+
+        frames_per_segment = int(fps * segment_duration)
+        if frames_per_segment < 1:
+            frames_per_segment = 1
+
+        segments = []
+        total_frames = len(frames)
+
+        for i in range(0, total_frames, frames_per_segment):
+            segment_frames = frames[i:i + frames_per_segment]
+            segment_scores = [f.get("metrics", {}).get("vmaf", 0) for f in segment_frames]
+
+            if segment_scores:
+                time_start = i / fps
+                time_end = min((i + len(segment_frames)) / fps, total_frames / fps)
+
+                # Apply phone transformation if needed
+                if self.use_phone_transform:
+                    segment_scores = [self._apply_phone_transform(s) for s in segment_scores]
+
+                median_score = self._calculate_median(segment_scores)
+                mean_score = sum(segment_scores) / len(segment_scores)
+
+                segments.append({
+                    "time_start": round(time_start, 2),
+                    "time_end": round(time_end, 2),
+                    "time_label": f"{int(time_start)}s",
+                    "median": round(median_score, 2),
+                    "mean": round(mean_score, 2),
+                    "min": round(min(segment_scores), 2),
+                    "max": round(max(segment_scores), 2),
+                    "frame_count": len(segment_scores),
+                })
+
+        return segments
+
+    def _extract_metrics(self, vmaf_data: Dict, fps: float = 30.0) -> Dict[str, Any]:
+        """Extract key metrics from VMAF output."""
+        pooled = vmaf_data.get("pooled_metrics", {})
+
+        vmaf_mean = pooled.get("vmaf", {}).get("mean", 0)
+        vmaf_min = pooled.get("vmaf", {}).get("min", 0)
+        vmaf_max = pooled.get("vmaf", {}).get("max", 0)
+        vmaf_harmonic = pooled.get("vmaf", {}).get("harmonic_mean", 0)
+
+        # Calculate median from per-frame scores
+        frames = vmaf_data.get("frames", [])
+        frame_scores = [f.get("metrics", {}).get("vmaf", 0) for f in frames]
+        vmaf_median = self._calculate_median(frame_scores)
+
+        # Calculate segment scores (every 3 seconds)
+        segment_scores = self._calculate_segment_scores(frames, fps, segment_duration=3.0)
+
+        # Apply phone transformation if using phone model
+        if self.use_phone_transform:
+            vmaf_mean = self._apply_phone_transform(vmaf_mean)
+            vmaf_min = self._apply_phone_transform(vmaf_min)
+            vmaf_max = self._apply_phone_transform(vmaf_max)
+            vmaf_harmonic = self._apply_phone_transform(vmaf_harmonic)
+            vmaf_median = self._apply_phone_transform(vmaf_median)
+
+        metrics = {
+            "vmaf": {
+                "score": vmaf_median,  # Default score is median (change to vmaf_mean if needed)
+                "mean": vmaf_mean,
+                "median": vmaf_median,
+                "harmonic_mean": vmaf_harmonic,
+                "min": vmaf_min,
+                "max": vmaf_max,
+                "segments": segment_scores,  # 3-second segment scores for graphing
+            },
+            "psnr": {
+                "y": pooled.get("psnr_y", {}).get("mean", 0),
+                "cb": pooled.get("psnr_cb", {}).get("mean", 0),
+                "cr": pooled.get("psnr_cr", {}).get("mean", 0),
+            },
+            "ssim": pooled.get("float_ssim", {}).get("mean", 0),
+        }
+
+        return metrics
+
+    def _cleanup(self):
+        """Clean up temporary files."""
+        if self.temp_dir and os.path.exists(self.temp_dir):
+            shutil.rmtree(self.temp_dir)
+            self.temp_dir = None
+
+    def _store_to_mongodb(self, result: Dict[str, Any]) -> Optional[str]:
+        """Store VMAF results to MongoDB.
+
+        Args:
+            result: The VMAF calculation result dictionary
+
+        Returns:
+            Document ID if successful, None otherwise
+        """
+        if not self.mongodb_enabled or not self.mongodb_uri:
+            return None
+
+        try:
+            # Initialize MongoDB client if not already done
+            if self.mongo_client is None:
+                self.mongo_client = VMAFMongoDBClient(self.mongodb_uri)
+                print(f"Connected to MongoDB")
+
+            # Extract required fields from metadata and result
+            s3_link_name = self.show_metadata.get("s3_link_name", self.distorted_path)
+            show_title = self.show_metadata.get("show_title", "Unknown")
+            episode_number = self.show_metadata.get("episode_number", 0)
+            show_id = self.show_metadata.get("show_id", "unknown")
+            trail_name = self.show_metadata.get("trail_name", "default")
+            m3u8_link = self.show_metadata.get("m3u8_link")
+            codec = self.show_metadata.get("codec")
+
+            # Extract bitrate and resolution from result
+            dist_info = result.get("distorted", {}).get("info", {})
+            trail_bitrate = dist_info.get("bitrate", 0)
+            resolution = f"{dist_info.get('width', 0)}x{dist_info.get('height', 0)}"
+
+            # Extract VMAF score
+            vmaf_score = result.get("metrics", {}).get("vmaf", {}).get("score", 0)
+
+            # Insert to MongoDB
+            doc_id = self.mongo_client.insert_vmaf_score(
+                s3_link_name=s3_link_name,
+                show_title=show_title,
+                episode_number=episode_number,
+                show_id=show_id,
+                trail_name=trail_name,
+                trail_bitrate=trail_bitrate,
+                resolution=resolution,
+                vmaf_score=vmaf_score,
+                m3u8_link=m3u8_link,
+                codec=codec
+            )
+
+            if doc_id:
+                print(f"✓ VMAF score stored to MongoDB (ID: {doc_id})")
+            else:
+                print("⚠ VMAF score not stored (possible duplicate)")
+
+            return doc_id
+
+        except Exception as e:
+            print(f"ERROR storing to MongoDB: {e}")
+            if self.verbose:
+                import traceback
+                traceback.print_exc()
+            return None
+
+    def _close_mongodb(self):
+        """Close MongoDB connection if open."""
+        if self.mongo_client:
+            try:
+                self.mongo_client.close()
+                self.mongo_client = None
+            except Exception as e:
+                if self.verbose:
+                    print(f"Warning: Error closing MongoDB connection: {e}")
+
+    def calculate(self) -> Dict[str, Any]:
+        """Run the full VMAF calculation pipeline."""
+        try:
+            # Check dependencies
+            if not self._check_dependencies():
+                sys.exit(1)
+
+            # Handle M3U8 streams
+            distorted = self.distorted_path
+            if self._is_m3u8(distorted) or (self._is_url(distorted) and "m3u8" in distorted):
+                distorted = self._download_m3u8(distorted)
+
+            # Get video information
+            print("\nAnalyzing videos...")
+            ref_info = self._get_video_info(self.reference_path)
+            dist_info = self._get_video_info(distorted)
+
+            print(f"  Reference: {ref_info.get('width')}x{ref_info.get('height')} @ {ref_info.get('fps')} fps")
+            print(f"  Distorted: {dist_info.get('width')}x{dist_info.get('height')} @ {dist_info.get('fps')} fps")
+
+            if self.verbose:
+                print(f"  Reference full info: {ref_info}")
+                print(f"  Distorted full info: {dist_info}")
+
+            # Use reference dimensions for comparison
+            target_width = ref_info.get("width", 1920)
+            target_height = ref_info.get("height", 1080)
+
+            # Convert videos to Y4M format
+            print("\nPreparing videos for comparison...")
+            ref_y4m = self._convert_to_y4m(self.reference_path, "reference", target_width, target_height)
+            dist_y4m = self._convert_to_y4m(distorted, "distorted", target_width, target_height)
+
+            # Run VMAF
+            vmaf_data = self._run_vmaf(ref_y4m, dist_y4m)
+
+            # Extract metrics (pass fps for segment calculation)
+            fps = ref_info.get("fps", 30.0)
+            metrics = self._extract_metrics(vmaf_data, fps=fps)
+
+            # Calculate bitrate analysis
+            ref_bitrate = ref_info.get("bitrate", 0)
+            dist_bitrate = dist_info.get("bitrate", 0)
+            bitrate_analysis = {}
+
+            # Calculate pixels
+            ref_pixels = ref_info.get("width", 0) * ref_info.get("height", 0)
+            dist_pixels = dist_info.get("width", 0) * dist_info.get("height", 0)
+            ref_fps = ref_info.get("fps", 30) or 30
+            dist_fps = dist_info.get("fps", 30) or 30
+
+            if ref_bitrate and dist_bitrate:
+                ref_mbps = ref_bitrate / 1_000_000
+                dist_mbps = dist_bitrate / 1_000_000
+                reduction = ((ref_bitrate - dist_bitrate) / ref_bitrate) * 100
+                vmaf_score = metrics["vmaf"]["score"]
+                efficiency = vmaf_score / dist_mbps if dist_mbps > 0 else 0
+
+                # Calculate BPP (bits per pixel per frame)
+                ref_bpp = ref_bitrate / (ref_pixels * ref_fps) if ref_pixels > 0 else 0
+                dist_bpp = dist_bitrate / (dist_pixels * dist_fps) if dist_pixels > 0 else 0
+
+                # BPP quality rating
+                if dist_bpp >= 0.10:
+                    bpp_quality = "High"
+                elif dist_bpp >= 0.05:
+                    bpp_quality = "Good"
+                elif dist_bpp >= 0.03:
+                    bpp_quality = "Low"
+                else:
+                    bpp_quality = "Very Low"
+
+                bitrate_analysis = {
+                    "reference_mbps": round(ref_mbps, 2),
+                    "distorted_mbps": round(dist_mbps, 2),
+                    "reduction_percent": round(reduction, 1),
+                    "efficiency_vmaf_per_mbps": round(efficiency, 1),
+                    "savings_mbps": round(ref_mbps - dist_mbps, 2),
+                    "reference_bpp": round(ref_bpp, 6),
+                    "distorted_bpp": round(dist_bpp, 6),
+                    "bpp_quality": bpp_quality,
+                }
+
+            # Build result
+            result = {
+                "timestamp": datetime.now().isoformat(),
+                "reference": {
+                    "path": self.reference_path,
+                    "info": ref_info,
+                },
+                "distorted": {
+                    "path": self.distorted_path,
+                    "info": dist_info,
+                },
+                "model": self.model_name,
+                "metrics": metrics,
+                "bitrate_analysis": bitrate_analysis,
+                "frame_count": len(vmaf_data.get("frames", [])),
+            }
+
+            # Save results to JSON file
+            with open(self.output_path, "w") as f:
+                json.dump(result, f, indent=2)
+
+            print(f"\nResults saved to: {self.output_path}")
+
+            # Store to MongoDB if enabled
+            if self.mongodb_enabled:
+                self._store_to_mongodb(result)
+
+            return result
+
+        finally:
+            self._cleanup()
+            self._close_mongodb()
+
