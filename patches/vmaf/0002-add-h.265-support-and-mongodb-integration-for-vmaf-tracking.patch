+        help="Output JSON file path (default: vmaf_results.json)"
+    )
+    parser.add_argument(
+        "-m", "--model",
+        choices=["vmaf_v0.6.1", "vmaf_4k", "vmaf_b", "vmaf_phone"],
+        default=DEFAULT_MODEL,
+        help=f"VMAF model to use (default: {DEFAULT_MODEL})"
+    )
+    parser.add_argument(
+        "-t", "--threads",
+        type=int,
+        default=DEFAULT_THREADS,
+        help=f"Number of threads (default: {DEFAULT_THREADS} = auto)"
+    )
+    parser.add_argument(
+        "-v", "--verbose",
+        action="store_true",
+        default=VERBOSE,
+        help="Enable verbose output"
+    )
+
+    # MongoDB control
+    parser.add_argument(
+        "--no-mongodb",
+        action="store_true",
+        help="Disable MongoDB storage (enabled by default)"
+    )
+    parser.add_argument(
+        "--mongodb-uri",
+        default=MONGODB_URI,
+        help="MongoDB connection URI (uses default from config)"
+    )
+
+    args = parser.parse_args()
+
+    # Determine if MongoDB should be enabled
+    mongodb_enabled = MONGODB_ENABLED and not args.no_mongodb
+
+    # Check MongoDB requirements
+    if mongodb_enabled:
+        missing_fields = []
+        if not args.show_id:
+            missing_fields.append("--show-id")
+        if not args.show_title:
+            missing_fields.append("--show-title")
+        if args.episode is None:
+            missing_fields.append("--episode")
+
+        if missing_fields:
+            print(f"ERROR: MongoDB storage requires: {', '.join(missing_fields)}")
+            print("Use --no-mongodb to disable MongoDB storage")
+            sys.exit(1)
+
+    # Prepare show metadata
+    show_metadata = None
+    if mongodb_enabled:
+        show_metadata = {
+            "s3_link_name": args.s3_link or args.distorted,
+            "show_title": args.show_title,
+            "episode_number": args.episode,
+            "show_id": args.show_id,
+            "trail_name": args.trail_name,
+            "m3u8_link": args.m3u8_link,
+            "codec": args.codec,
+        }
+
+    # Validate files
+    if not Path(args.reference).exists():
+        print(f"ERROR: Reference file not found: {args.reference}")
+        sys.exit(1)
+
+    if not args.distorted.startswith("http") and not Path(args.distorted).exists():
+        print(f"ERROR: Distorted file not found: {args.distorted}")
+        sys.exit(1)
+
+    # Display configuration
+    print("\n" + "=" * 60)
+    print("VMAF CALCULATOR - MongoDB Auto-Storage")
+    print("=" * 60)
+    print(f"Reference:     {args.reference}")
+    print(f"Distorted:     {args.distorted}")
+    print(f"Model:         {args.model}")
+    print(f"Output:        {args.output}")
+    print(f"MongoDB:       {'✓ Enabled' if mongodb_enabled else '✗ Disabled'}")
+    if mongodb_enabled:
+        print(f"\nShow Metadata:")
+        print(f"  Show ID:     {args.show_id}")
+        print(f"  Show Title:  {args.show_title}")
+        print(f"  Episode:     {args.episode}")
+        print(f"  Trail:       {args.trail_name}")
+        if args.m3u8_link:
+            print(f"  M3U8 Link:   {args.m3u8_link}")
+        if args.codec:
+            print(f"  Codec:       {args.codec}")
+    print("=" * 60 + "\n")
+
+    # Create calculator
+    calculator = VMAFCalculator(
+        reference_path=args.reference,
+        distorted_path=args.distorted,
+        output_path=args.output,
+        model=args.model,
+        threads=args.threads,
+        verbose=args.verbose,
+        mongodb_uri=args.mongodb_uri,
+        mongodb_enabled=mongodb_enabled,
+        show_metadata=show_metadata,
+    )
+
+    # Calculate VMAF
+    try:
+        result = calculator.calculate()
+        calculator.print_summary(result)
+
+        # Show MongoDB storage status
+        if mongodb_enabled:
+            print("\n" + "=" * 60)
+            print("MongoDB Storage Status:")
+            print("=" * 60)
+            vmaf_score = result['metrics']['vmaf']['score']
+            dist_info = result['distorted']['info']
+            resolution = f"{dist_info['width']}x{dist_info['height']}"
+            bitrate_mbps = dist_info['bitrate'] / 1_000_000
+
+            print(f"✓ VMAF score saved to MongoDB")
+            print(f"  Show:       {args.show_title} (ID: {args.show_id})")
+            print(f"  Episode:    {args.episode}")
+            print(f"  Trail:      {args.trail_name}")
+            print(f"  Resolution: {resolution}")
+            print(f"  Bitrate:    {bitrate_mbps:.2f} Mbps")
+            print(f"  VMAF Score: {vmaf_score:.2f}")
+            print("=" * 60)
+
+        return 0
+
+    except Exception as e:
+        print(f"\n✗ ERROR: {e}")
+        if args.verbose:
+            import traceback
+            traceback.print_exc()
+        return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
