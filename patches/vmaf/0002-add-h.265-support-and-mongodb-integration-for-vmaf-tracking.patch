+#!/usr/bin/env python3
+"""
+VMAF Calculator - Compare MP4 reference videos against M3U8 transcoded streams.
+
+This script calculates VMAF (Video Multi-Method Assessment Fusion) scores
+to measure video quality degradation after transcoding.
+
+Usage:
+    python vmaf_calculator.py -r reference.mp4 -d https://example.com/stream.m3u8 -o results.json
+    python vmaf_calculator.py -r reference.mp4 -d distorted.mp4 -o results.json
+"""
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import shutil
+from datetime import datetime
+from pathlib import Path
+from typing import Optional, Dict, Any
+
+# Try to import MongoDB client (optional)
+try:
+    sys.path.append(str(Path(__file__).parent.parent))
+    from mongodb_client import VMAFMongoDBClient
+    MONGODB_AVAILABLE = True
+except ImportError:
+    MONGODB_AVAILABLE = False
+    print("Warning: MongoDB client not available. Install pymongo to enable MongoDB storage.")
+
+# Path to the native VMAF tool (built from this repository)
+SCRIPT_DIR = Path(__file__).parent.resolve()
+VMAF_TOOL = SCRIPT_DIR.parent / "libvmaf" / "build" / "tools" / "vmaf"
+
+# Fallback to system FFmpeg path
+FFMPEG_PATH = os.environ.get("FFMPEG_PATH", "/opt/homebrew/bin/ffmpeg")
+FFPROBE_PATH = os.environ.get("FFPROBE_PATH", "/opt/homebrew/bin/ffprobe")
+
+
+class VMAFCalculator:
+    """Calculate VMAF scores between reference and distorted videos."""
+
+    # Available VMAF models
+    MODELS = {
+        "vmaf_v0.6.1": "version=vmaf_v0.6.1",
+        "vmaf_4k": "version=vmaf_4k_v0.6.1",
+        "vmaf_b": "version=vmaf_b_v0.6.3",
+        "vmaf_phone": "version=vmaf_v0.6.1",  # Uses v0.6.1 with phone transform
+    }
+
+    # Phone model transformation parameters (from vmaf_v0.6.1.json)
+    # Formula: y_out = p0 + p1 * y_in + p2 * y_in^2
+    PHONE_TRANSFORM = {
+        "p0": 1.70674692,
+        "p1": 1.72643844,
+        "p2": -0.00705305,
+    }
+
+    def __init__(
+        self,
+        reference_path: str,
+        distorted_path: str,
+        output_path: Optional[str] = None,
+        model: str = "vmaf_v0.6.1",
+        threads: int = 0,
+        verbose: bool = False,
+        # MongoDB parameters (optional)
+        mongodb_uri: Optional[str] = None,
+        mongodb_enabled: bool = False,
+        show_metadata: Optional[Dict[str, Any]] = None,
+    ):
+        self.reference_path = reference_path
+        self.distorted_path = distorted_path
+        self.output_path = output_path or "vmaf_results.json"
+        self.model = self.MODELS.get(model, f"version={model}")
+        self.model_name = model
+        self.use_phone_transform = (model == "vmaf_phone")
+        self.threads = threads if threads > 0 else os.cpu_count() or 4
+        self.verbose = verbose
+        self.temp_dir = None
+        self._temp_files = []
+
+        # MongoDB settings
+        self.mongodb_enabled = mongodb_enabled and MONGODB_AVAILABLE
+        self.mongodb_uri = mongodb_uri
+        self.show_metadata = show_metadata or {}
+        self.mongo_client = None
+
+        if mongodb_enabled and not MONGODB_AVAILABLE:
+            print("Warning: MongoDB storage requested but pymongo not installed.")
+
+    def _find_ffmpeg(self) -> str:
+        """Find FFmpeg executable."""
+        # Check common locations
+        locations = [
+            FFMPEG_PATH,
+            "/opt/homebrew/bin/ffmpeg",
+            "/usr/local/bin/ffmpeg",
+            "/usr/bin/ffmpeg",
+            "ffmpeg",
+        ]
+        for loc in locations:
+            try:
+                result = subprocess.run(
+                    [loc, "-version"],
+                    capture_output=True,
+                    text=True,
+                )
+                if result.returncode == 0:
+                    return loc
+            except FileNotFoundError:
+                continue
+        raise FileNotFoundError("FFmpeg not found. Please install FFmpeg.")
+
+    def _find_ffprobe(self) -> str:
+        """Find FFprobe executable."""
+        locations = [
+            FFPROBE_PATH,
+            "/opt/homebrew/bin/ffprobe",
+            "/usr/local/bin/ffprobe",
+            "/usr/bin/ffprobe",
+            "ffprobe",
+        ]
+        for loc in locations:
+            try:
+                result = subprocess.run(
+                    [loc, "-version"],
+                    capture_output=True,
+                    text=True,
+                )
+                if result.returncode == 0:
+                    return loc
+            except FileNotFoundError:
+                continue
+        raise FileNotFoundError("FFprobe not found. Please install FFmpeg.")
+
+    def _check_dependencies(self) -> bool:
+        """Check if all required tools are available."""
+        try:
+            self.ffmpeg = self._find_ffmpeg()
+            self.ffprobe = self._find_ffprobe()
+            print(f"Using FFmpeg: {self.ffmpeg}")
+        except FileNotFoundError as e:
+            print(f"ERROR: {e}")
+            return False
+
+        # Check VMAF tool
+        if not VMAF_TOOL.exists():
+            print(f"ERROR: VMAF tool not found at {VMAF_TOOL}")
+            print("Please build libvmaf first:")
+            print("  cd libvmaf && meson setup build --buildtype release && ninja -C build")
+            return False
+
+        print(f"Using VMAF tool: {VMAF_TOOL}")
+        return True
+
+    def _is_m3u8(self, path: str) -> bool:
+        """Check if the path is an M3U8 stream."""
+        return path.endswith(".m3u8") or "m3u8" in path.lower()
+
+    def _is_url(self, path: str) -> bool:
+        """Check if the path is a URL."""
+        return path.startswith("http://") or path.startswith("https://")
+
+    def _get_video_info(self, video_path: str) -> Dict[str, Any]:
+        """Get video metadata using FFprobe."""
+        cmd = [
+            self.ffprobe,
+            "-v", "quiet",
+            "-print_format", "json",
+            "-show_format",
+            "-show_streams",
+            video_path,
+        ]
+
+        try:
+            result = subprocess.run(cmd, capture_output=True, text=True, check=True)
+            data = json.loads(result.stdout)
+
+            # Find video stream
+            video_stream = None
+            for stream in data.get("streams", []):
+                if stream.get("codec_type") == "video":
+                    video_stream = stream
+                    break
+
+            if not video_stream:
+                return {}
+
+            # Parse frame rate safely
+            fps_str = video_stream.get("r_frame_rate", "0/1")
+            try:
+                if "/" in fps_str:
+                    num, den = fps_str.split("/")
+                    fps = float(num) / float(den) if float(den) != 0 else 0
+                else:
+                    fps = float(fps_str)
+            except (ValueError, ZeroDivisionError):
+                fps = 0
+
+            return {
+                "width": int(video_stream.get("width", 0)),
+                "height": int(video_stream.get("height", 0)),
+                "fps": round(fps, 3),
+                "duration": float(data.get("format", {}).get("duration", 0)),
+                "codec": video_stream.get("codec_name", "unknown"),
+                "pix_fmt": video_stream.get("pix_fmt", "unknown"),
+                "bitrate": int(data.get("format", {}).get("bit_rate", 0)),
+            }
+        except (subprocess.CalledProcessError, json.JSONDecodeError, Exception) as e:
+            if self.verbose:
+                print(f"Warning: Could not get video info: {e}")
+            return {}
+
+    def _download_m3u8(self, m3u8_url: str) -> str:
+        """Download M3U8 stream to a temporary file."""
+        if self.temp_dir is None:
+            self.temp_dir = tempfile.mkdtemp(prefix="vmaf_")
+
+        output_file = os.path.join(self.temp_dir, "distorted.mp4")
+        self._temp_files.append(output_file)
+
+        print(f"Downloading M3U8 stream: {m3u8_url}")
+
+        cmd = [
+            self.ffmpeg,
+            "-y",
+            "-i", m3u8_url,
+            "-c", "copy",
+            output_file,
+        ]
+
+        if self.verbose:
+            print(f"Running: {' '.join(cmd)}")
+
+        try:
+            process = subprocess.Popen(
+                cmd,
+                stderr=subprocess.PIPE,
+                stdout=subprocess.PIPE,
+                text=True,
+            )
+
+            # Show progress
+            for line in process.stderr:
+                if self.verbose:
+                    print(line.strip())
+                elif "time=" in line:
+                    print(f"\r  {line.strip()[:60]}", end="", flush=True)
+
+            process.wait()
+            print()
+
+            if process.returncode != 0:
+                raise subprocess.CalledProcessError(process.returncode, cmd)
+
+            print(f"Downloaded to: {output_file}")
+            return output_file
+        except subprocess.CalledProcessError as e:
+            print(f"ERROR: Failed to download M3U8 stream: {e}")
+            raise
