+  python vmaf_calculator.py -r original.mp4 -d transcoded.mp4
+
+  # Compare MP4 against M3U8 stream from GCP
+  python vmaf_calculator.py -r original.mp4 -d https://storage.googleapis.com/bucket/video.m3u8
