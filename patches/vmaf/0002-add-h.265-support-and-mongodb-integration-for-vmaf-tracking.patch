+  # Disable MongoDB storage
+  python run_vmaf.py -r ref.mp4 -d dist.mp4 --no-mongodb
+
+  # Use different model
+  python run_vmaf.py -r ref.mp4 -d dist.mp4 --model vmaf_4k \\
