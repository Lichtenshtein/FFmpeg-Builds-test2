+"""
+MongoDB client for storing VMAF scores and video quality metrics.
+"""
+
+from pymongo import MongoClient, ASCENDING
+from pymongo.errors import ConnectionFailure, DuplicateKeyError
+from datetime import datetime
+from typing import Dict, List, Optional
+import logging
+
+logger = logging.getLogger(__name__)
+
+
+class VMAFMongoDBClient:
+    """Client for managing VMAF scores in MongoDB."""
+
+    def __init__(self, connection_uri: str, database_name: str = "master"):
+        """
+        Initialize MongoDB client.
+
+        Args:
+            connection_uri: MongoDB connection string
+            database_name: Name of the database (default: "master")
+        """
+        try:
+            self.client = MongoClient(connection_uri)
+            self.db = self.client[database_name]
+            self.collection = self.db["vmaf_scores"]
+
+            # Test connection
+            self.client.admin.command('ping')
+            logger.info(f"Successfully connected to MongoDB database: {database_name}")
+
+            # Create indexes for better query performance
+            self._create_indexes()
+
+        except ConnectionFailure as e:
+            logger.error(f"Failed to connect to MongoDB: {str(e)}")
+            raise
+
+    def _create_indexes(self):
+        """Create indexes on the collection for better query performance."""
+        try:
+            # Create compound index for unique constraint
+            self.collection.create_index(
+                [
+                    ("show_id", ASCENDING),
+                    ("episode_number", ASCENDING),
+                    ("trail_name", ASCENDING),
+                    ("resolution", ASCENDING)
+                ],
+                name="unique_vmaf_record",
+                unique=True
+            )
+
+            # Create individual indexes for common queries
+            self.collection.create_index([("show_id", ASCENDING)], name="idx_show_id")
+            self.collection.create_index([("show_title", ASCENDING)], name="idx_show_title")
+            self.collection.create_index([("vmaf_score", ASCENDING)], name="idx_vmaf_score")
+            self.collection.create_index([("created_at", ASCENDING)], name="idx_created_at")
+
+            logger.info("Indexes created successfully")
+        except Exception as e:
+            logger.warning(f"Error creating indexes: {str(e)}")
+
+    def insert_vmaf_score(
+        self,
+        s3_link_name: str,
+        show_title: str,
+        episode_number: int,
+        show_id: str,
+        trail_name: str,
+        trail_bitrate: int,
+        resolution: str,
+        vmaf_score: float,
+        m3u8_link: Optional[str] = None,
+        codec: Optional[str] = None
+    ) -> Optional[str]:
+        """
+        Insert a VMAF score record into the collection.
+
+        Args:
+            s3_link_name: S3 link/path to the video file
+            show_title: Title of the show
+            episode_number: Episode number
+            show_id: Unique identifier for the show
+            trail_name: Name of the trail/variant
+            trail_bitrate: Bitrate of the trail in bps
+            resolution: Video resolution (e.g., "1920x1080", "1280x720")
+            vmaf_score: VMAF score value (0-100)
+            m3u8_link: HLS manifest URL (optional)
+            codec: Video codec used ("h264" or "h265", optional)
+
+        Returns:
+            Inserted document ID as string, or None if insertion failed
+        """
+        document = {
+            "s3_link_name": s3_link_name,
+            "show_title": show_title,
+            "episode_number": episode_number,
+            "show_id": show_id,
+            "trail_name": trail_name,
+            "trail_bitrate": trail_bitrate,
+            "resolution": resolution,
+            "vmaf_score": vmaf_score,
+            "m3u8_link": m3u8_link,
+            "codec": codec,
+            "created_at": datetime.utcnow(),
+            "updated_at": datetime.utcnow()
+        }
+
+        try:
+            result = self.collection.insert_one(document)
+            logger.info(
+                f"VMAF score inserted: show={show_title}, episode={episode_number}, "
+                f"resolution={resolution}, score={vmaf_score}"
+            )
+            return str(result.inserted_id)
+        except DuplicateKeyError:
+            logger.warning(
+                f"Duplicate VMAF record: show_id={show_id}, episode={episode_number}, "
+                f"trail={trail_name}, resolution={resolution}"
+            )
+            return None
+        except Exception as e:
+            logger.error(f"Failed to insert VMAF score: {str(e)}")
+            raise
+
+    def bulk_insert_vmaf_scores(self, records: List[Dict]) -> Dict[str, int]:
+        """
+        Bulk insert multiple VMAF score records.
+
+        Args:
+            records: List of dictionaries containing VMAF score data
+
+        Returns:
+            Dictionary with 'inserted' and 'failed' counts
+        """
+        if not records:
+            return {"inserted": 0, "failed": 0}
+
+        documents = []
+        for record in records:
+            document = {
+                "s3_link_name": record.get("s3_link_name"),
+                "show_title": record.get("show_title"),
+                "episode_number": record.get("episode_number"),
+                "show_id": record.get("show_id"),
+                "trail_name": record.get("trail_name"),
+                "trail_bitrate": record.get("trail_bitrate"),
+                "resolution": record.get("resolution"),
+                "vmaf_score": record.get("vmaf_score"),
+                "m3u8_link": record.get("m3u8_link"),
+                "codec": record.get("codec"),
+                "created_at": datetime.utcnow(),
+                "updated_at": datetime.utcnow()
+            }
+            documents.append(document)
+
+        try:
+            result = self.collection.insert_many(documents, ordered=False)
+            inserted_count = len(result.inserted_ids)
+            logger.info(f"Bulk insert completed: {inserted_count} records inserted")
+            return {"inserted": inserted_count, "failed": len(records) - inserted_count}
+        except Exception as e:
+            logger.error(f"Bulk insert failed: {str(e)}")
+            return {"inserted": 0, "failed": len(records)}
+
+    def update_vmaf_score(
+        self,
+        show_id: str,
+        episode_number: int,
+        trail_name: str,
+        resolution: str,
+        vmaf_score: float
+    ) -> bool:
+        """
+        Update an existing VMAF score record.
+
+        Args:
+            show_id: Unique identifier for the show
+            episode_number: Episode number
+            trail_name: Name of the trail/variant
+            resolution: Video resolution
+            vmaf_score: New VMAF score value
+
+        Returns:
+            True if update was successful, False otherwise
+        """
+        try:
+            result = self.collection.update_one(
+                {
+                    "show_id": show_id,
+                    "episode_number": episode_number,
+                    "trail_name": trail_name,
+                    "resolution": resolution
+                },
+                {
+                    "$set": {
+                        "vmaf_score": vmaf_score,
+                        "updated_at": datetime.utcnow()
+                    }
+                }
+            )
+
+            if result.modified_count > 0:
+                logger.info(
+                    f"VMAF score updated: show_id={show_id}, episode={episode_number}, "
+                    f"resolution={resolution}, new_score={vmaf_score}"
+                )
+                return True
+            else:
+                logger.warning(f"No matching record found to update")
+                return False
+        except Exception as e:
+            logger.error(f"Failed to update VMAF score: {str(e)}")
+            return False
+
+    def get_vmaf_scores_by_show(self, show_id: str) -> List[Dict]:
+        """
+        Retrieve all VMAF scores for a specific show.
+
+        Args:
+            show_id: Unique identifier for the show
+
+        Returns:
+            List of VMAF score documents
+        """
+        try:
+            results = list(self.collection.find({"show_id": show_id}))
+            logger.info(f"Retrieved {len(results)} VMAF scores for show_id={show_id}")
+            return results
+        except Exception as e:
+            logger.error(f"Failed to retrieve VMAF scores: {str(e)}")
+            return []
+
+    def get_vmaf_scores_by_episode(self, show_id: str, episode_number: int) -> List[Dict]:
+        """
+        Retrieve all VMAF scores for a specific episode.
+
+        Args:
+            show_id: Unique identifier for the show
+            episode_number: Episode number
+
+        Returns:
+            List of VMAF score documents
+        """
+        try:
+            results = list(self.collection.find({
+                "show_id": show_id,
+                "episode_number": episode_number
+            }))
+            logger.info(
+                f"Retrieved {len(results)} VMAF scores for show_id={show_id}, "
+                f"episode={episode_number}"
+            )
+            return results
+        except Exception as e:
+            logger.error(f"Failed to retrieve VMAF scores: {str(e)}")
+            return []
+
+    def get_average_vmaf_by_resolution(self, show_id: str, resolution: str) -> Optional[float]:
+        """
+        Calculate average VMAF score for a specific show and resolution.
+
+        Args:
+            show_id: Unique identifier for the show
+            resolution: Video resolution
+
+        Returns:
+            Average VMAF score, or None if no records found
+        """
+        try:
+            pipeline = [
+                {
+                    "$match": {
+                        "show_id": show_id,
+                        "resolution": resolution
+                    }
+                },
+                {
+                    "$group": {
+                        "_id": None,
+                        "avg_vmaf": {"$avg": "$vmaf_score"}
+                    }
+                }
+            ]
+
+            result = list(self.collection.aggregate(pipeline))
+            if result:
+                avg_score = result[0]["avg_vmaf"]
+                logger.info(
+                    f"Average VMAF for show_id={show_id}, resolution={resolution}: {avg_score:.2f}"
+                )
+                return avg_score
+            return None
+        except Exception as e:
+            logger.error(f"Failed to calculate average VMAF: {str(e)}")
+            return None
+
+    def delete_vmaf_scores(self, show_id: str, episode_number: Optional[int] = None) -> int:
+        """
+        Delete VMAF score records.
+
+        Args:
+            show_id: Unique identifier for the show
+            episode_number: Optional episode number. If provided, only deletes that episode.
+
+        Returns:
+            Number of records deleted
+        """
+        try:
+            query = {"show_id": show_id}
+            if episode_number is not None:
+                query["episode_number"] = episode_number
+
+            result = self.collection.delete_many(query)
+            logger.info(f"Deleted {result.deleted_count} VMAF score records")
+            return result.deleted_count
+        except Exception as e:
+            logger.error(f"Failed to delete VMAF scores: {str(e)}")
+            return 0
+
+    def close(self):
+        """Close the MongoDB connection."""
+        self.client.close()
+        logger.info("MongoDB connection closed")
+
+
+# Example usage
+if __name__ == "__main__":
