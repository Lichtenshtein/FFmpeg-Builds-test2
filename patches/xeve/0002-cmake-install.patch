From 865dce7ea5104ab2770980713d74e7cc96bc98a8 Mon Sep 17 00:00:00 2001
From: Nelonn <42481486+Nelonn@users.noreply.github.com>
Date: Sat, 4 Apr 2026 01:12:44 +0400
Subject: [PATCH] CMake install

---
 CMakeLists.txt            |  2 +-
 cmake/XEVEConfig.cmake.in | 10 ++++++++
 src_base/CMakeLists.txt   | 47 ++++++++++++++++----------------------
 src_main/CMakeLists.txt   | 48 ++++++++++++++++-----------------------
 4 files changed, 49 insertions(+), 58 deletions(-)
 create mode 100644 cmake/XEVEConfig.cmake.in

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 59f5bcb..fbb199b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -107,7 +107,7 @@ if(XEVE_PROFILE STREQUAL "MAIN")
     set(PACKAGE_PROFILE_NAME "main")
 endif()
 
-if (XEVD_INSTALL)
+if (XEVE_INSTALL)
 
     string(TOLOWER "${PROJECT_NAME}" PACKAGE_NAME)
     string(CONCAT PACKAGE_NAME ${PACKAGE_NAME} "-${PACKAGE_PROFILE_NAME}")
diff --git a/cmake/XEVEConfig.cmake.in b/cmake/XEVEConfig.cmake.in
new file mode 100644
index 0000000..a17f177
--- /dev/null
+++ b/cmake/XEVEConfig.cmake.in
@@ -0,0 +1,10 @@
+@PACKAGE_INIT@
+
+include(CMakeFindDependencyMacro)
+
+# Provide the targets
+if(NOT TARGET xeve)
+    include("${CMAKE_CURRENT_LIST_DIR}/XEVETargets.cmake")
+endif()
+
+check_required_components(XEVE)
diff --git a/src_base/CMakeLists.txt b/src_base/CMakeLists.txt
index 8ac8c24..c0aa087 100644
--- a/src_base/CMakeLists.txt
+++ b/src_base/CMakeLists.txt
@@ -93,42 +93,33 @@ set(XEVE_PRIVATE_HEADERS "${LIB_BASE_INC}" "${LIB_SSE_INC}" "${LIB_AVX_INC}" "${
 
 if (XEVE_INSTALL)
 
-    # Install static library and public headers
-    #
-    # Static library (libxeveb.a or xeveb.lib) will be installed to <prefix>/lib/xeveb
-    # Public headers will be installed to <prefix>/include/xeveb
-    #
     include(GNUInstallDirs)
-    install(TARGETS ${LIB_NAME_BASE}
-            ARCHIVE COMPONENT Development DESTINATION ${CMAKE_INSTALL_LIBDIR}/${LIB_NAME_BASE}
-            PUBLIC_HEADER COMPONENT Development DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/${LIB_NAME_BASE}
-    )
 
-    # Install shared library
-    #
-    # On non-DLL platforms shared library (libxeveb.so) will be installed to <prefix>/lib/xeveb.
-    # On DLL platforms the shred DLL (xeveb.dll) will be installed to <prefix>/bin and its import library will be installed to <prefix>/lib/xeveb/import
-    #
-    install(TARGETS ${LIB_NAME_BASE}_dynamic
-            RUNTIME COMPONENT Libraries DESTINATION ${CMAKE_INSTALL_BINDIR}
-            LIBRARY
-                COMPONENT Libraries DESTINATION ${CMAKE_INSTALL_LIBDIR}
-                NAMELINK_COMPONENT Development DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    # Install library and public headers
+    install(TARGETS ${LIB_NAME_BASE}
+            EXPORT XEVETargets
             ARCHIVE COMPONENT Development DESTINATION ${CMAKE_INSTALL_LIBDIR}
-            PUBLIC_HEADER COMPONENT Development DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/${LIB_NAME_BASE}
-    )
-
-    install( FILES
-        ${PROJECT_BINARY_DIR}/xeve_exports.h COMPONENT Development DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/${LIB_NAME_BASE}
+            LIBRARY COMPONENT Libraries DESTINATION ${CMAKE_INSTALL_LIBDIR}
+            RUNTIME COMPONENT Libraries DESTINATION ${CMAKE_INSTALL_BINDIR}
+            PUBLIC_HEADER COMPONENT Development DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+            INCLUDES DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
     )
 
     configure_file(
-        "${CMAKE_CURRENT_SOURCE_DIR}/pkgconfig/${LIB_NAME_BASE}.pc.in"
-        "${CMAKE_CURRENT_BINARY_DIR}/${LIB_NAME_BASE}.pc"
-        IMMEDIATE @ONLY)
+            "${CMAKE_CURRENT_SOURCE_DIR}/pkgconfig/${LIB_NAME_BASE}.pc.in"
+            "${CMAKE_CURRENT_BINARY_DIR}/${LIB_NAME_BASE}.pc"
+            IMMEDIATE @ONLY)
 
     install( FILES
-        "${CMAKE_CURRENT_BINARY_DIR}/${LIB_NAME_BASE}.pc" COMPONENT Development DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig
+            "${CMAKE_CURRENT_BINARY_DIR}/${LIB_NAME_BASE}.pc" COMPONENT Development DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig
+    )
+
+    # Install the export target
+    install(EXPORT XEVETargets
+            FILE XEVETargets.cmake
+            NAMESPACE XEVE::
+            DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/XEVE
+            COMPONENT Development
     )
 
 endif ()
