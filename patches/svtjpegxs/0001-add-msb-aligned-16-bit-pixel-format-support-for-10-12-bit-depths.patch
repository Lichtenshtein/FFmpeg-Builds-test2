+void linear_output_scaling_16bit_line_msb_avx512(int32_t* in, uint32_t bw, uint32_t depth, uint16_t* out, uint32_t w) {
+    int32_t x;
+    const int32_t dzeta = bw - depth;
+    const uint32_t round = ((1 << bw) >> 1) + ((1 << dzeta) >> 1);
+    const int32_t m = (1 << depth) - 1;
+    const int32_t msb_shift = 16 - depth;
+    const __m512i round_avx512 = _mm512_set1_epi32(round);
+    const __m512i zero_avx512 = _mm512_setzero_si512();
+    const __m512i max_avx512 = _mm512_set1_epi32(m);
+
+    for (x = 0; x <= (int32_t)w - 16; x += 16) {
+        __m512i v1 = _mm512_loadu_si512((__m512i*)(in + x));
+        v1 = _mm512_add_epi32(v1, round_avx512);
+        v1 = _mm512_srai_epi32(v1, dzeta);
+        v1 = _mm512_max_epi32(_mm512_min_epi32(v1, max_avx512), zero_avx512);
+        /* Narrow 16 x int32 -> 16 x uint16, then MSB-align */
+        __m256i packed = _mm512_cvtepi32_epi16(v1);
+        packed = _mm256_slli_epi16(packed, msb_shift);
+        _mm256_storeu_si256((__m256i*)(out + x), packed);
+    }
+    for (; x < (int32_t)w; x++) {
+        int32_t v = in[x];
+        v += round;
+        v >>= dzeta;
+        out[x] = (uint16_t)(v > m ? m : v < 0 ? 0 : v) << msb_shift;
+    }
+}
