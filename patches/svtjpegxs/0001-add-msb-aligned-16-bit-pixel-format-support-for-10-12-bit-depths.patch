--- a/Source/Lib/Encoder/ASM_AVX512/Enc_avx512.c
+++ b/Source/Lib/Encoder/ASM_AVX512/Enc_avx512.c
@@ -240,6 +240,26 @@ void linear_input_scaling_line_16bit_avx512(const uint16_t* src, int32_t* dst, u
