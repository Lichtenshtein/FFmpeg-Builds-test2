From f7770013e7084ba5c8a35a4bdc035acec8ca661b Mon Sep 17 00:00:00 2001
From: Lichtenshtein <altruumann@protonmail.com>
Date: Sat, 25 Apr 2026 17:15:23 +0300
Subject: [PATCH] patch for 10.0

---
--- a/Source/Lib/CMakeLists.txt
+++ b/Source/Lib/CMakeLists.txt
@@ -48,7 +48,9 @@
 set_target_properties(SvtJpegxsLib PROPERTIES OUTPUT_NAME "SvtJpegxs")
 set_target_properties(SvtJpegxsLib PROPERTIES VERSION ${SVT_LIB_VERSION})
 set_target_properties(SvtJpegxsLib PROPERTIES SOVERSION ${SVT_LIB_VERSION_MAJOR})
-set_target_properties(SvtJpegxsLib PROPERTIES C_VISIBILITY_PRESET hidden)
+if (BUILD_SHARED_LIBS)
+    set_target_properties(SvtJpegxsLib PROPERTIES C_VISIBILITY_PRESET hidden)
+endif()
 target_link_libraries(SvtJpegxsLib PUBLIC ${PLATFORM_LIBS})
 target_link_libraries(SvtJpegxsLib PRIVATE cpuinfo_public)
 
--- a/Source/API/SvtJpegxs.h
+++ b/Source/API/SvtJpegxs.h
@@ -37,6 +37,9 @@
 #endif /*DEF_BUILDING_SHARED_LIBS*/
 #else  /*DEF_DLL*/
 #define PREFIX_API
+#if defined(__GNUC__) && (defined(_WIN32) || defined(__MINGW32__))
+#define PREFIX_API __attribute__((visibility("default")))
+#endif
 #endif /*DEF_DLL*/
 
 /********************************
