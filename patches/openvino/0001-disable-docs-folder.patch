         DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
         FILES_MATCHING
-        PATTERN "*.h"
-        PATTERN "backend/test/case" EXCLUDE
-        PATTERN "backend/test/data" EXCLUDE)
+        PATTERN "*.h")
