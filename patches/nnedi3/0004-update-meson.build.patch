From 8cea01790bf4a1a06a66981b2f556fd7b71a469b Mon Sep 17 00:00:00 2001
From: Lichtenshtein <altruumann@protonmail.com>
Date: Mon, 27 Apr 2026 09:02:18 +0300
Subject: [PATCH] update meson.build

---
diff --git a/meson.build b/meson.build
index 7e76e79..5056b3c 100644
--- a/meson.build
+++ b/meson.build
@@ -1,13 +1,13 @@
 project('znedi3', 'c', 'cpp',
         version: '2.2',
-        default_options: ['c_std=c99', 'cpp_std=c++14', 'buildtype=release', 'b_lto=true'],
+        default_options: ['c_std=c11', 'cpp_std=c++17', 'buildtype=release', 'b_lto=true'],
         meson_version: '>=0.46')
 
-
 warnings = [
   '-Wall',
   '-Wextra',
   '-Wshadow',
+  '-Wno-unused-parameter', '-Wno-sign-compare',
 ]
 
 cflags = [
@@ -16,13 +16,6 @@ cflags = [
   '-DGRAPHENGINE_IMPL_NAMESPACE=znedi3',
   '-DPACKAGE_VERSION="@0@"'.format(meson.project_version()),
   '-DNDEBUG',
-  '-Igraphengine/include',
-  '-Iznedi3',
-  '-Ivsxx',
-  '-Ivsxx/vapoursynth',
-]
-
-ldflags = [
 ]
 
 includes = include_directories(
@@ -58,7 +51,6 @@ testapp_sources = [
 ]
 
 znedi3_helper_libs = []
-
 host_cpu_family = host_machine.cpu_family()
 
 if host_cpu_family.startswith('x86')
@@ -71,89 +63,75 @@ if host_cpu_family.startswith('x86')
     'znedi3/x86/kernel_sse2.cpp',
   ]
 
-  znedi3_sources_x86_avx = [
-    'znedi3/x86/kernel_avx.cpp',
-  ]
-
-  znedi3_sources_x86_f16c = [
-    'znedi3/x86/kernel_f16c.cpp',
-  ]
-
-  znedi3_sources_x86_avx2 = [
-    'znedi3/x86/kernel_avx2.cpp',
-  ]
-
-  znedi3_sources_x86_avx512 = [
-    'znedi3/x86/kernel_avx512.cpp',
-  ]
-
-  znedi3_helper_libs += static_library('avx',
-                                znedi3_sources_x86_avx,
+  znedi3_helper_libs += static_library('znedi3_avx',
+                                ['znedi3/x86/kernel_avx.cpp'],
                                 include_directories: includes,
                                 cpp_args: [cflags, '-mavx', '-mtune=sandybridge'],
                                 pic: true,
                                 install: false)
 
-  znedi3_helper_libs += static_library('f16c',
-                                znedi3_sources_x86_f16c,
+  znedi3_helper_libs += static_library('znedi3_f16c',
+                                ['znedi3/x86/kernel_f16c.cpp'],
                                 include_directories: includes,
                                 cpp_args: [cflags, '-mavx', '-mf16c', '-mtune=ivybridge'],
                                 pic: true,
                                 install: false)
 
-  znedi3_helper_libs += static_library('avx2',
-                                znedi3_sources_x86_avx2,
+  znedi3_helper_libs += static_library('znedi3_avx2',
+                                ['znedi3/x86/kernel_avx2.cpp'],
                                 include_directories: includes,
                                 cpp_args: [cflags, '-mavx2', '-mfma', '-mtune=haswell'],
                                 pic: true,
                                 install: false)
 
-  znedi3_helper_libs += static_library('avx512',
-                                znedi3_sources_x86_avx2,
+  znedi3_helper_libs += static_library('znedi3_avx512',
+                                ['znedi3/x86/kernel_avx512.cpp'], 
                                 include_directories: includes,
-                                cpp_args: [cflags, '-mavx512f', '-mfma', '-mtune=skylake-avx512'],
+                                cpp_args: [cflags, '-mavx512f', '-mavx512bw', '-mavx512dq', '-mfma', '-mtune=skylake-avx512'],
                                 pic: true,
                                 install: false)
 
-  graphengine_sources += [
-    'graphengine/graphengine/x86/cpuinfo_x86.cpp'
-  ]
-
+  graphengine_sources += ['graphengine/graphengine/x86/cpuinfo_x86.cpp']
 endif
 
 if host_cpu_family.startswith('aarch') or host_cpu_family.startswith('arm')
   cflags += ['-DZNEDI3_ARM=1']
-
   znedi3_sources += [
     'znedi3/arm/kernel_arm.cpp',
     'znedi3/arm/kernel_neon.cpp',
   ]
 endif
 
-znedi3_helper_libs += static_library('graphengine',
+lib_graphengine = static_library('graphengine',
                               graphengine_sources,
                               include_directories: includes,
                               cpp_args: [cflags],
                               pic: true,
                               install: false)
 
-cxx = meson.get_compiler('cpp')
-
-
 shared_module('vsznedi3',
               znedi3_sources + vsznedi3_sources,
               include_directories: includes,
-              link_args: ldflags,
-              c_args: cflags,
               cpp_args: cflags,
-              link_with: znedi3_helper_libs,
+              link_with: [znedi3_helper_libs, lib_graphengine],
               install: true)
 
-executable   ('testapp',
+znedi3_lib = static_library('znedi3',
+              znedi3_sources,
+              include_directories: includes,
+              cpp_args: cflags,
+              link_with: [znedi3_helper_libs, lib_graphengine],
+              install: true)
+
+pkg = import('pkgconfig')
+pkg.generate(znedi3_lib,
+  name: 'znedi3',
+  description: 'znedi3 edge directed interpolation library',
+  version: meson.project_version())
+
+executable   ('znedi3_testapp',
               znedi3_sources + testapp_sources,
               include_directories: includes,
-              link_args: ldflags,
-              c_args: cflags,
               cpp_args: cflags,
-              link_with: znedi3_helper_libs,
+              link_with: [znedi3_helper_libs, lib_graphengine],
               install: false)
-- 
2.52.0.windows.1

