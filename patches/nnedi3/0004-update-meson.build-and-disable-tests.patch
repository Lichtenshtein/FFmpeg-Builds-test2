From b100712b209ece53c018ef7b394bd742f5336931 Mon Sep 17 00:00:00 2001
From: Lichtenshtein <altruumann@protonmail.com>
Date: Sat, 23 May 2026 04:02:32 +0300
Subject: [PATCH] update meson.build and disable tests

---
 meson.build | 83 ++++++++++++-----------------------------------------
 1 file changed, 19 insertions(+), 64 deletions(-)

diff --git a/meson.build b/meson.build
index 7e76e79..38147ed 100644
--- a/meson.build
+++ b/meson.build
@@ -1,28 +1,22 @@
 project('znedi3', 'c', 'cpp',
         version: '2.2',
-        default_options: ['c_std=c99', 'cpp_std=c++14', 'buildtype=release', 'b_lto=true'],
+        default_options: ['c_std=c11', 'cpp_std=c++17', 'buildtype=release', 'b_lto=true'],
         meson_version: '>=0.46')
 
+env = environment()
 
 warnings = [
   '-Wall',
   '-Wextra',
   '-Wshadow',
+  '-Wno-unused-parameter', '-Wno-sign-compare',
 ]
 
 cflags = [
   warnings,
-  '-fvisibility=hidden',
   '-DGRAPHENGINE_IMPL_NAMESPACE=znedi3',
   '-DPACKAGE_VERSION="@0@"'.format(meson.project_version()),
   '-DNDEBUG',
-  '-Igraphengine/include',
-  '-Iznedi3',
-  '-Ivsxx',
-  '-Ivsxx/vapoursynth',
-]
-
-ldflags = [
 ]
 
 includes = include_directories(
@@ -39,26 +33,13 @@ znedi3_sources = [
   'znedi3/znedi3_impl.cpp',
 ]
 
-vsznedi3_sources = [
-  'vsznedi3/vsznedi3.cpp',
-  'vsxx/vsxx4_pluginmain.cpp',
-]
-
 graphengine_sources = [
   'graphengine/graphengine/cpuinfo.cpp',
   'graphengine/graphengine/graph.cpp',
   'graphengine/graphengine/node.cpp',
 ]
 
-testapp_sources = [
-  'testapp/argparse.cpp',
-  'testapp/main.cpp',
-  'testapp/mmap.cpp',
-  'testapp/win32_bitmap.cpp',
-]
-
-znedi3_helper_libs = []
-
+znedi3_objects = []
 host_cpu_family = host_machine.cpu_family()
 
 if host_cpu_family.startswith('x86')
@@ -71,89 +52,60 @@ if host_cpu_family.startswith('x86')
     'znedi3/x86/kernel_sse2.cpp',
   ]
 
-  znedi3_sources_x86_avx = [
-    'znedi3/x86/kernel_avx.cpp',
-  ]
+  lib_avx = static_library('znedi3_avx_obj', ['znedi3/x86/kernel_avx.cpp'],
+                           include_directories: includes, cpp_args: [cflags, '-mavx', '-mtune=sandybridge'], pic: true, install: false)
+  znedi3_objects += lib_avx.extract_all_objects(recursive: false)
 
-  znedi3_sources_x86_f16c = [
-    'znedi3/x86/kernel_f16c.cpp',
-  ]
+  lib_f16c = static_library('znedi3_f16c_obj', ['znedi3/x86/kernel_f16c.cpp'],
+                            include_directories: includes, cpp_args: [cflags, '-mavx', '-mf16c', '-mtune=ivybridge'], pic: true, install: false)
+  znedi3_objects += lib_f16c.extract_all_objects(recursive: false)
 
-  znedi3_sources_x86_avx2 = [
-    'znedi3/x86/kernel_avx2.cpp',
-  ]
-
-  znedi3_sources_x86_avx512 = [
-    'znedi3/x86/kernel_avx512.cpp',
-  ]
+  lib_avx2 = static_library('znedi3_avx2_obj', ['znedi3/x86/kernel_avx2.cpp'],
+                            include_directories: includes, cpp_args: [cflags, '-mavx2', '-mfma', '-mtune=haswell'], pic: true, install: false)
+  znedi3_objects += lib_avx2.extract_all_objects(recursive: false)
 
-  znedi3_helper_libs += static_library('avx',
-                                znedi3_sources_x86_avx,
-                                include_directories: includes,
-                                cpp_args: [cflags, '-mavx', '-mtune=sandybridge'],
-                                pic: true,
-                                install: false)
-
-  znedi3_helper_libs += static_library('f16c',
-                                znedi3_sources_x86_f16c,
-                                include_directories: includes,
-                                cpp_args: [cflags, '-mavx', '-mf16c', '-mtune=ivybridge'],
-                                pic: true,
-                                install: false)
-
-  znedi3_helper_libs += static_library('avx2',
-                                znedi3_sources_x86_avx2,
-                                include_directories: includes,
-                                cpp_args: [cflags, '-mavx2', '-mfma', '-mtune=haswell'],
-                                pic: true,
-                                install: false)
-
-  znedi3_helper_libs += static_library('avx512',
-                                znedi3_sources_x86_avx2,
-                                include_directories: includes,
-                                cpp_args: [cflags, '-mavx512f', '-mfma', '-mtune=skylake-avx512'],
-                                pic: true,
-                                install: false)
-
-  graphengine_sources += [
-    'graphengine/graphengine/x86/cpuinfo_x86.cpp'
-  ]
+  if env.get('USE_AVX512', '0') == '1'
+    lib_avx512 = static_library('znedi3_avx512_obj', ['znedi3/x86/kernel_avx512.cpp'],
+                                include_directories: includes, cpp_args: [cflags, '-mavx512f', '-mavx512bw', '-mavx512dq', '-mfma', '-mtune=skylake-avx512'], pic: true, install: false)
+    znedi3_objects += lib_avx512.extract_all_objects(recursive: false)
+  endif
 
+  graphengine_sources += ['graphengine/graphengine/x86/cpuinfo_x86.cpp']
 endif
 
 if host_cpu_family.startswith('aarch') or host_cpu_family.startswith('arm')
   cflags += ['-DZNEDI3_ARM=1']
-
   znedi3_sources += [
     'znedi3/arm/kernel_arm.cpp',
     'znedi3/arm/kernel_neon.cpp',
   ]
 endif
 
-znedi3_helper_libs += static_library('graphengine',
-                              graphengine_sources,
-                              include_directories: includes,
-                              cpp_args: [cflags],
-                              pic: true,
-                              install: false)
+znedi3_lib = static_library('znedi3',
+              znedi3_sources + graphengine_sources,
+              include_directories: includes,
+              cpp_args: cflags,
+              objects: znedi3_objects,
+              pic: true,
+              install: true)
 
-cxx = meson.get_compiler('cpp')
+pkg = import('pkgconfig')
+pkg.generate(znedi3_lib,
+  name: 'znedi3',
+  description: 'znedi3 edge directed interpolation library',
+  version: meson.project_version())
 
+vsznedi3_sources = [
+  'vsznedi3/vsznedi3.cpp',
+  'vsxx/vsxx4_pluginmain.cpp'
+]
 
+# Building a shared library (plugin) for VapourSynth
 shared_module('vsznedi3',
-              znedi3_sources + vsznedi3_sources,
-              include_directories: includes,
-              link_args: ldflags,
-              c_args: cflags,
-              cpp_args: cflags,
-              link_with: znedi3_helper_libs,
-              install: true)
+  vsznedi3_sources,
+  include_directories: includes,
+  cpp_args: cflags,
+  link_with: znedi3_lib,
+  install: true
+)
 
-executable   ('testapp',
-              znedi3_sources + testapp_sources,
-              include_directories: includes,
-              link_args: ldflags,
-              c_args: cflags,
-              cpp_args: cflags,
-              link_with: znedi3_helper_libs,
-              install: false)
-- 
2.52.0.windows.1

