-pcre2_jit_test_CFLAGS = $(AM_CFLAGS)
-pcre2_jit_test_LDADD =
-if WITH_PCRE2_8
-pcre2_jit_test_LDADD += libpcre2-8.la
-endif # WITH_PCRE2_8
-if WITH_PCRE2_16
-pcre2_jit_test_LDADD += libpcre2-16.la
-endif # WITH_PCRE2_16
-if WITH_PCRE2_32
-pcre2_jit_test_LDADD += libpcre2-32.la
-endif # WITH_PCRE2_32
