From 321689d40c8d3ec68a2589d60850ff6cb5444de9 Mon Sep 17 00:00:00 2001
From: Lichtenshtein <altruumann@protonmail.com>
Date: Sun, 12 Jul 2026 15:25:17 +0300
Subject: [PATCH] cdd write data-bufsize

---
diff --git a/lib/cddb_cmd.c b/lib/cddb_cmd.c
index 7a94356..b5d77b6 100644
--- a/lib/cddb_cmd.c
+++ b/lib/cddb_cmd.c
@@ -1355,73 +1355,69 @@ int cddb_write_data(cddb_conn_t *c, char *buf, int size, cddb_disc_t *disc)
     cddb_track_t *track;
     const char *s;
 
-/* Appends some data to the buffer.  The first parameter is the
-   number of bytes that will be added.  The other parameters are a
-   format string and its arguments as in printf. */
-/* XXX: error checking on buffer size */
-#define CDDB_WRITE_APPEND(l, ...) \
-            snprintf(buf, remaining, __VA_ARGS__); remaining -= l; buf += l;
+/* Appends some data to the buffer. The parameters are a
+   format string and its arguments, same as in printf. */
+#define CDDB_WRITE_APPEND(...) \
+        { 	int written = snprintf(buf, remaining, __VA_ARGS__); \
+            if ((written < 0) || (written > remaining)) \
+				return -1; /* size of 'buf' is too small */ \
+            remaining -= written; buf += written;    }
 
     remaining = size;
-    CDDB_WRITE_APPEND(9, "# xmcd\n#\n");
+    CDDB_WRITE_APPEND("# xmcd\n#\n");
     /* track offsets */
-    CDDB_WRITE_APPEND(23, "# Track frame offsets:\n");
+    CDDB_WRITE_APPEND("# Track frame offsets:\n");
     for (track = cddb_disc_get_track_first(disc); 
          track != NULL; 
          track = cddb_disc_get_track_next(disc)) {
-        CDDB_WRITE_APPEND(6+8, "#    %8d\n", track->frame_offset);
+        CDDB_WRITE_APPEND("#    %8d\n", track->frame_offset);
     }
     /* disc length */
-    CDDB_WRITE_APPEND(26+6, "#\n# Disc length: %6d seconds\n", disc->length);
+    CDDB_WRITE_APPEND("#\n# Disc length: %6d seconds\n", disc->length);
     /* submission info */
-    CDDB_WRITE_APPEND(15+8, "#\n# Revision: %8d\n", disc->revision);
-    CDDB_WRITE_APPEND(21+strlen(c->cname)+strlen(c->cversion),
-                      "# Submitted via: %s %s\n#\n", c->cname, c->cversion);
+    CDDB_WRITE_APPEND("#\n# Revision: %8d\n", disc->revision);
+    CDDB_WRITE_APPEND("# Submitted via: %s %s\n#\n", c->cname, c->cversion);
     /* disc data */
-    CDDB_WRITE_APPEND(8+8, "DISCID=%08x\n", disc->discid);
-    CDDB_WRITE_APPEND(11+strlen(disc->artist)+strlen(disc->title),
-                      "DTITLE=%s / %s\n", disc->artist, disc->title);
+    CDDB_WRITE_APPEND("DISCID=%08x\n", disc->discid);
+    CDDB_WRITE_APPEND("DTITLE=%s / %s\n", disc->artist, disc->title);
     if (disc->year != 0) {
-        CDDB_WRITE_APPEND(7+4, "DYEAR=%d\n", disc->year);
+        CDDB_WRITE_APPEND("DYEAR=%d\n", disc->year);
     } else {
-        CDDB_WRITE_APPEND(7, "DYEAR=\n");
+        CDDB_WRITE_APPEND("DYEAR=\n");
     }
     if (disc->genre && (*disc->genre != '\0')) {
         s = disc->genre;
     } else {
         s = CDDB_CATEGORY[disc->category];
     }
-    CDDB_WRITE_APPEND(8+strlen(s), "DGENRE=%s\n", s);
+    CDDB_WRITE_APPEND("DGENRE=%s\n", s);
     /* track data */
     for (track = cddb_disc_get_track_first(disc), i=0; 
          track != NULL; 
          track = cddb_disc_get_track_next(disc), i++) {
         if (track->artist != NULL) {
-            CDDB_WRITE_APPEND(11+(i/10+1)+strlen(track->artist)+strlen(track->title),
-                              "TTITLE%d=%s / %s\n", i, track->artist, track->title);
+            CDDB_WRITE_APPEND("TTITLE%d=%s / %s\n", i, track->artist, track->title);
         } else {
-            CDDB_WRITE_APPEND(8+(i/10+1)+strlen(track->title),
-                              "TTITLE%d=%s\n", i, track->title);
+            CDDB_WRITE_APPEND("TTITLE%d=%s\n", i, track->title);
         }
     }
     /* extended data */
     if (disc->ext_data != NULL) {
-        CDDB_WRITE_APPEND(6+strlen(disc->ext_data), "EXTD=%s\n", disc->ext_data);
+        CDDB_WRITE_APPEND("EXTD=%s\n", disc->ext_data);
     } else {
-        CDDB_WRITE_APPEND(6, "EXTD=\n");
+        CDDB_WRITE_APPEND("EXTD=\n");
     }
     for (track = cddb_disc_get_track_first(disc), i=0; 
          track != NULL; 
          track = cddb_disc_get_track_next(disc), i++) {
         if (track->ext_data != NULL) {
-            CDDB_WRITE_APPEND(6+(i/10+1)+strlen(track->ext_data), 
-                              "EXTT%d=%s\n", i, track->ext_data);
+            CDDB_WRITE_APPEND("EXTT%d=%s\n", i, track->ext_data);
         } else {
-            CDDB_WRITE_APPEND(6+(i/10+1), "EXTT%d=\n", i);
+            CDDB_WRITE_APPEND("EXTT%d=\n", i);
         }
     }
     /* play order */
-    CDDB_WRITE_APPEND(11, "PLAYORDER=\n");
+    CDDB_WRITE_APPEND("PLAYORDER=\n");
 
     return (size - remaining);
 }
@@ -1467,7 +1463,10 @@ int cddb_write(cddb_conn_t *c, cddb_disc_t *disc)
 
     /* create CDDB entry */
     size = cddb_write_data(c, buf, sizeof(buf), disc);
-    
+    if (size < 0) {
+    	cddb_errno_log_error(c, CDDB_ERR_LINE_SIZE);
+    	return FALSE;
+    }
     /* cache data if needed */
     if (c->use_cache != CACHE_OFF) {
         /* create cache directory structure */
